PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
PUBLIC_COMMUNITY_ENABLED=false
# Optional public Turnstile site key. Its matching secret belongs only in Supabase Dashboard.
PUBLIC_TURNSTILE_SITE_KEY=
GSC_SITE_URL=https://www.cineposta.com.ar/
GSC_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-search-console.service-account.json
# Server-side tooling only. Set in .env.local; never expose it as PUBLIC_.
TMDB_API_KEY=
# Buffer: OAuth is handled by the local MCP client. These are server-side CLI/Actions values.
# BUFFER_API_KEY already exists in Actions; never replace it just to configure Instagram.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=

