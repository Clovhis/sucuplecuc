{
  "name": "la-posta-cine",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "new-movie": "node ./scripts/new-movie.mjs",
    "catalog:movies": "node ./scripts/update-movie-catalog-reference.mjs",
    "catalog:movies:check": "node ./scripts/update-movie-catalog-reference.mjs --check",
    "catalog:people": "node ./scripts/update-person-profile-catalog-links.mjs",
    "catalog:people:check": "node ./scripts/update-person-profile-catalog-links.mjs --check",
    "catalog:people:reference": "node ./scripts/update-person-profile-catalog-reference.mjs",
    "catalog:people:reference:check": "node ./scripts/update-person-profile-catalog-reference.mjs --check",
    "update-upcoming-releases": "node ./scripts/update-upcoming-releases.mjs",
    "refresh:weekly-recommendations": "node --experimental-strip-types ./scripts/refresh-weekly-recommendations.mjs",
    "test:weekly-recommendations": "node --experimental-strip-types ./scripts/weekly-recommendations.test.mjs",
    "enrich-synopsis": "node ./scripts/enrich-movie-synopsis.mjs",
    "enrich-editorial": "node ./scripts/enrich-movie-editorial.mjs",
    "enrich-people": "node ./scripts/enrich-people-pool.mjs",
    "audit:movie-people": "node ./scripts/audit-movie-people.mjs",
    "audit:content-quality": "node ./scripts/content-quality-audit.mjs",
    "audit:content-quality:strict": "node ./scripts/content-quality-audit.mjs --strict",
	"test:content-quality": "node ./scripts/content-quality-audit.test.mjs",
    "test:review-audit": "node ./scripts/review-audit.test.cjs",
    "images:people:optimize": "node ./scripts/optimize-people-images.mjs --write",
    "images:people:check": "node ./scripts/optimize-people-images.mjs --check",
	"posters:localize": "node ./scripts/localize-movie-posters.mjs",
	"posters:migrate": "node ./scripts/localize-movie-posters.mjs --all --concurrency 8 --report reports/local-posters-migration.json",
	"posters:check": "node ./skills/la-posta-cine-auditor/scripts/verify_posters.cjs --all",
    "test:people-images": "node ./scripts/optimize-people-images.test.mjs",
    "test:editorial-meters": "node --experimental-strip-types ./scripts/editorial-meters.test.mjs",
    "audit:editorial-low-value": "node ./scripts/editorial-low-value-audit.mjs",
    "audit:movies:recent": "node ./skills/la-posta-cine-auditor/scripts/audit_recent_movies.cjs --base-ref main --recent --skip-youtube",
    "audit:movies:all": "node ./skills/la-posta-cine-auditor/scripts/audit_recent_movies.cjs --all --skip-youtube",
    "audit:profiles": "node ./skills/la-posta-cine-add-person-profile/scripts/person_profile_audit.cjs --all",
    "audit:profiles:facts": "node --experimental-strip-types ./scripts/audit-person-profile-facts.mjs",

    "audit:profile-originality": "node --experimental-strip-types ./scripts/validate-person-profile-originality.mjs",
    "validate:content": "node ./scripts/validate-content.mjs",
    "validate:public-output": "node ./scripts/validate-public-output.mjs",
    "validate:sitemap-indexability": "node ./scripts/validate-sitemap-indexability.mjs",
    "playwright:install": "playwright install chromium firefox webkit",
    "playwright:verify": "node ./scripts/verify-playwright.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:desktop": "npm run build && playwright test --project=desktop-chromium --project=desktop-firefox --project=desktop-webkit",
    "test:e2e:mobile": "npm run build && playwright test --project=mobile-chromium --project=mobile-webkit",
    "hooks:install": "node ./scripts/install-hooks.mjs",
    "gsc:sites": "node ./scripts/gsc.mjs sites",
    "gsc:sitemaps": "node ./scripts/gsc.mjs sitemaps",
    "gsc:submit-sitemap": "node ./scripts/gsc.mjs submit-sitemap",
    "gsc:queries": "node ./scripts/gsc.mjs queries",
    "gsc:pages": "node ./scripts/gsc.mjs pages",
    "gsc:inspect": "node ./scripts/gsc.mjs inspect",
    "gsc:inspect-sitemap": "node ./scripts/gsc.mjs inspect-sitemap"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "astro": "^7.1.6",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@playwright/test": "^1.60.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "volar-service-yaml": "0.0.71"
  }
}
