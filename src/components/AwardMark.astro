---
import { getAwardVisualKey, getAwardVisualMeta, type AwardVisualKey } from '../lib/awards';

type Props = {
	award: string | AwardVisualKey;
	category?: string;
	class?: string;
	decorative?: boolean;
	label?: string;
	size?: number;
};

const {
	award,
	category,
	class: className,
	decorative = true,
	label,
	size = 28,
} = Astro.props as Props;
const visualKey = getAwardVisualKey(String(award), category);
const meta = getAwardVisualMeta(visualKey);
const assetPath = meta.assetPath ?? '/brand/awards/illustrated/generic.webp';
---

<img
	class:list={['award-mark', 'award-mark--image', className]}
	data-award-visual={visualKey}
	src={assetPath}
	alt={decorative ? '' : label ?? meta.alt}
	width={size}
	height={size}
	loading="lazy"
	decoding="async"
	aria-hidden={decorative ? 'true' : undefined}
/>
