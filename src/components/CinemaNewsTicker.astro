---
import type { CinemaNewsItem } from '../lib/cinemaNews';

interface Props {
	items: CinemaNewsItem[];
	sourceLabel: string;
	updatedLabel: string;
	isFallback?: boolean;
}

const { items, updatedLabel, isFallback = false } = Astro.props;
const marqueeItems = items;
---

{
	marqueeItems.length > 0 ? (
		<section class="news-rail fade-up" style="--item-delay: 70ms;" aria-label="Noticias diarias">
			<div class="news-rail__header">
				<p class="news-rail__kicker">Noticias diarias</p>
				<p class="news-rail__meta">
					{updatedLabel}
					{isFallback ? ' · modo respaldo' : ''}
				</p>
			</div>

			<div class="news-rail__body">
				<div class="news-rail__ticker">
					<div class="news-rail__marquee" data-news-marquee>
						<div class="news-rail__track" data-news-track>
							<ul class="news-rail__ticker-list" data-news-segment>
								{
									marqueeItems.map((item) => (
										<li class="news-rail__ticker-item">
											<a
												class:list={[
													'news-rail__ticker-link',
													!item.imageUrl && 'news-rail__ticker-link--no-image',
												]}
												href={item.link}
												target="_blank"
												rel="noopener noreferrer"
												referrerpolicy="no-referrer"
											>
												<span class="news-rail__ticker-media" aria-hidden="true">
													{
														item.imageUrl ? (
															<img
																class="news-rail__ticker-image"
																src={item.imageUrl}
																alt=""
																loading="lazy"
																decoding="async"
																referrerpolicy="strict-origin-when-cross-origin"
															/>
														) : null
													}
												</span>
												<span class="news-rail__ticker-scrim" aria-hidden="true"></span>
												<span class="news-rail__ticker-content">
													<span class="news-rail__ticker-item-meta">
														<time datetime={item.publishedAt}>{item.publishedLabel}</time>
														<span aria-hidden="true">·</span>
														{item.source}
													</span>
													<span class="news-rail__ticker-item-title">{item.title}</span>
												</span>
											</a>
										</li>
									))
								}
							</ul>
							<ul class="news-rail__ticker-list" aria-hidden="true">
								{
									marqueeItems.map((item) => (
										<li class="news-rail__ticker-item">
											<a
												class:list={[
													'news-rail__ticker-link',
													!item.imageUrl && 'news-rail__ticker-link--no-image',
												]}
												href={item.link}
												target="_blank"
												rel="noopener noreferrer"
												tabindex="-1"
												referrerpolicy="no-referrer"
											>
												<span class="news-rail__ticker-media" aria-hidden="true">
													{
														item.imageUrl ? (
															<img
																class="news-rail__ticker-image"
																src={item.imageUrl}
																alt=""
																loading="lazy"
																decoding="async"
																referrerpolicy="strict-origin-when-cross-origin"
															/>
														) : null
													}
												</span>
												<span class="news-rail__ticker-scrim" aria-hidden="true"></span>
												<span class="news-rail__ticker-content">
													<span class="news-rail__ticker-item-meta">
														{item.publishedLabel}
														<span aria-hidden="true">·</span>
														{item.source}
													</span>
													<span class="news-rail__ticker-item-title">{item.title}</span>
												</span>
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>
	) : null
}

<script is:inline type="module" src="/scripts/newsTicker.js"></script>
