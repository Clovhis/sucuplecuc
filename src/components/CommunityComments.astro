---
interface Props {
	enabled: boolean;
	threadId: string;
	movieSlug?: string;
	movieTitle?: string;
	turnstileSiteKey?: string;
}

const { enabled, threadId, movieSlug = '', movieTitle = '', turnstileSiteKey = '' } = Astro.props as Props;
const status = enabled
	? 'Preparando la charla…'
	: 'La conversación está pausada mientras terminamos de preparar la sala. Volvé pronto.';
---

<div
	class="community-comments"
	data-community-comments-root
	data-community-enabled={String(enabled)}
	data-community-thread-id={threadId}
	data-community-movie-slug={movieSlug}
	data-community-movie-title={movieTitle}
	data-community-turnstile-site-key={turnstileSiteKey}
>
	<p class="community-comments__status" data-community-comments-status data-state={enabled ? 'loading' : 'error'} role="status" aria-live="polite">{status}</p>
	{
		enabled && (
			<>
				<div class="community-comments__captcha" data-community-comments-captcha aria-live="polite"></div>
				<ol class="community-comments__list" data-community-comments-list aria-label="Mensajes de Foro Cineposta"></ol>
				<form class="community-comments__form" data-community-comments-form>
					<p class="community-comments__replying" data-community-comments-replying hidden></p>
					<div data-community-comments-nickname-field>
						<label for="community-name">Tu nombre o apodo</label>
						<input id="community-name" name="authorName" type="text" minlength="2" maxlength="32" autocomplete="nickname" required />
					</div>
					<div class="community-comments__identity" data-community-comments-identity>
						<p class="community-comments__hint" data-community-comments-nickname-hint>Tu apodo queda ligado a este navegador después del primer mensaje.</p>
						<button type="button" data-community-comments-change-nickname hidden>Cambiar apodo</button>
					</div>
					<label for="community-message">Tu mensaje</label>
					<textarea id="community-message" name="body" rows="4" minlength="1" maxlength="300" required></textarea>
					<div class="community-comments__emoji-picker" aria-label="Agregar un emoji">
						<span aria-hidden="true">Sumá una reacción:</span>
						<button type="button" data-community-comments-emoji="😀" aria-label="Agregar emoji sonrisa">😀</button>
						<button type="button" data-community-comments-emoji="😂" aria-label="Agregar emoji risa">😂</button>
						<button type="button" data-community-comments-emoji="😍" aria-label="Agregar emoji enamorado">😍</button>
						<button type="button" data-community-comments-emoji="😱" aria-label="Agregar emoji sorpresa">😱</button>
						<button type="button" data-community-comments-emoji="👏" aria-label="Agregar emoji aplausos">👏</button>
						<button type="button" data-community-comments-emoji="🔥" aria-label="Agregar emoji fuego">🔥</button>
					</div>
					<label class="community-comments__spoiler-toggle"><input name="isSpoiler" type="checkbox" /> <span>Contiene spoiler: se va a tapar hasta que lo quieran ver.</span></label>
					<p class="community-comments__hint">Máximo 300 caracteres. Se publica al instante y se elimina después de un tiempo.</p>
					<div class="community-comments__form-actions">
						<button type="submit">Publicar mensaje</button>
						<button type="button" data-community-comments-cancel hidden>Cancelar respuesta</button>
					</div>
				</form>
				<dialog class="community-comments__nickname-dialog" data-community-comments-nickname-dialog aria-labelledby="community-change-nickname-title">
					<form method="dialog" data-community-comments-nickname-form>
						<h2 id="community-change-nickname-title">Cambiar apodo</h2>
						<p>El cambio actualiza tus mensajes anteriores. Después no vas a poder volver a cambiarlo durante 15 días.</p>
						<label for="community-new-nickname">Nuevo apodo</label>
						<input id="community-new-nickname" name="nickname" type="text" minlength="2" maxlength="32" autocomplete="nickname" required />
						<p data-community-comments-nickname-error role="alert" hidden></p>
						<div class="community-comments__form-actions">
							<button type="submit">Confirmar cambio</button>
							<button type="button" data-community-comments-cancel-nickname>Cancelar</button>
						</div>
					</form>
				</dialog>
			</>
		)
	}
	<noscript><p class="community-comments__noscript">Para participar en Foro Cineposta necesitás habilitar JavaScript. Mientras tanto, podés seguir leyendo y volver cuando quieras.</p></noscript>
</div>

<script src="../scripts/community-comments.ts"></script>
