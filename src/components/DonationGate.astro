---
const assetBase = import.meta.env.BASE_URL;
const cafecitoUrl = 'https://cafecito.app/cineposta';
---

<aside class="donation-invite" aria-label="Apoyá a Cine Posta">
	<p class="donation-invite__copy donation-invite__copy--full">
		Cine Posta es de acceso gratuito. Si te sirve, podés apoyar el trabajo editorial con un cafecito.
	</p>
	<p class="donation-invite__copy donation-invite__copy--mobile">Cine Posta es gratis.</p>
	<a
		class="donation-invite__link"
		href={cafecitoUrl}
		target="_blank"
		rel="noopener noreferrer"
	>
		<img src={`${assetBase}brand/cafecito-logo.svg`} alt="" aria-hidden="true" />
		Apoyá con un cafecito
	</a>
</aside>

<style>
	.donation-invite {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.55rem 0.9rem;
		padding: 0.55rem 1rem;
		border-bottom: 1px solid rgba(255, 176, 137, 0.18);
		background: rgba(255, 125, 59, 0.08);
		color: #dbe3ef;
		font-size: 0.84rem;
		text-align: center;
	}

	.donation-invite__copy { margin: 0; }
	.donation-invite__copy--mobile { display: none; }

	.donation-invite__link {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		min-height: 2.75rem;
		padding: 0.3rem 0.65rem;
		border: 1px solid rgba(255, 176, 137, 0.5);
		border-radius: 999px;
		color: #ffd1bb;
		font-weight: 700;
		text-decoration: none;
	}

	.donation-invite__link:hover,
	.donation-invite__link:focus-visible {
		border-color: #ffb089;
		background: rgba(255, 125, 59, 0.14);
		color: #fff;
	}

	.donation-invite__link img { width: 1rem; height: 1rem; }

	@media (max-width: 640px), (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
		.donation-invite {
			justify-content: space-between;
			flex-wrap: nowrap;
			gap: 0.65rem;
			min-height: 3.5rem;
			padding: 0.35rem max(0.5rem, env(safe-area-inset-right)) 0.35rem max(0.5rem, env(safe-area-inset-left));
			font-size: 0.82rem;
			text-align: start;
		}

		.donation-invite__copy--full { display: none; }
		.donation-invite__copy--mobile {
			display: block;
			font-weight: 600;
		}

		.donation-invite__link {
			flex: 0 0 auto;
			min-height: 3rem;
			padding: 0.45rem 0.72rem;
			font-size: 0.8rem;
		}
	}

	@media (max-width: 350px) {
		.donation-invite__copy--mobile { display: none; }
		.donation-invite { justify-content: center; }
	}
</style>
