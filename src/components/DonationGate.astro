---
const assetBase = import.meta.env.BASE_URL;
const cafecitoUrl = 'https://cafecito.app/cineposta';
---

<aside class="donation-invite" aria-label="Apoyá a Cine Posta">
	<div class="donation-invite__inner">
	<p class="donation-invite__copy donation-invite__copy--full">
		Cine Posta es de acceso gratuito. Si te sirve, podés apoyar el trabajo editorial con un cafecito.
	</p>
	<a
		class="donation-invite__link"
		href={cafecitoUrl}
		target="_blank"
		rel="noopener noreferrer"
	>
		<img src={`${assetBase}brand/cafecito-logo.svg`} alt="" width="16" height="16" aria-hidden="true" />
		Apoyá con un cafecito
	</a>
	</div>
</aside>

<style>
	.donation-invite {
		border-bottom: 1px solid #343b45;
		background: #101318;
		color: #aeb5bf;
		font-size: .8rem;
	}

	.donation-invite__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: .5rem 1rem;
		width: min(1180px, calc(100% - 2rem));
		margin-inline: auto;
		padding-block: .25rem;
	}

	.donation-invite__copy { margin: 0; }

	.donation-invite__link {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		min-height: 2.75rem;
		padding: .5rem .7rem;
		border: 0;
		border-radius: 4px;
		color: #e6b291;
		font-weight: 500;
		text-decoration: none;
	}

	.donation-invite__link:hover,
	.donation-invite__link:focus-visible {
		background: #1b222c;
		color: #f0eee8;
	}
	.donation-invite__link:focus-visible { outline: 2px solid #e6b291; outline-offset: 2px; }

	.donation-invite__link img { width: 1rem; height: 1rem; }

	@media (max-width: 720px), (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
		.donation-invite { display: none; }
	}
</style>
