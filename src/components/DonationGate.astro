---
const assetBase = import.meta.env.BASE_URL;
const cafecitoUrl = 'https://cafecito.app/cineposta';
---

<dialog
	class="donation-gate"
	data-donation-gate
	aria-labelledby="donation-gate-title"
	aria-describedby="donation-gate-description"
>
	<div class="donation-gate__card">
		<div class="donation-gate__eyebrow">
			<span class="donation-gate__status" aria-hidden="true"></span>
			Cine Posta sigue 100% online
		</div>

		<div class="donation-gate__body">
			<img
				class="donation-gate__logo"
				src={`${assetBase}brand/cineposta-logo-full.png`}
				alt="Cine Posta"
				width="292"
				height="82"
			/>

			<p class="donation-gate__kicker">Este sitio se banca entre todos</p>
			<h2 id="donation-gate-title">Ayudanos a mantener Cine Posta online</h2>
			<p id="donation-gate-description" class="donation-gate__description">
				Hace meses publicamos reseñas, datos y recomendaciones con acceso gratuito. Mantener el sitio y seguir sumando contenido cuesta tiempo y plata.
			</p>

			<div class="donation-gate__impact" aria-label="Tu aporte ayuda a sostener">
				<span>Hosting y dominio</span>
				<span>Herramientas y datos</span>
				<span>Trabajo editorial</span>
			</div>

			<p class="donation-gate__appeal">
				Si Cine Posta te ayuda a elegir qué mirar, un cafecito hace una diferencia real.
			</p>

			<div class="donation-gate__actions">
				<a
					class="donation-gate__donate"
					href={cafecitoUrl}
					target="_blank"
					rel="noopener noreferrer"
					data-donation-gate-donate
					autofocus
				>
					<img
						src={`${assetBase}brand/cafecito-logo.svg`}
						alt=""
						aria-hidden="true"
					/>
					Donar un cafecito
				</a>
				<button class="donation-gate__continue" type="button" data-donation-gate-dismiss>
					Ahora no, entrar al sitio
				</button>
			</div>

			<p class="donation-gate__frequency">Este aviso vuelve recién mañana.</p>
		</div>
	</div>
</dialog>

<script>
	const STORAGE_KEY = 'cineposta:donation-gate:last-shown-date';
	const gate = document.querySelector<HTMLDialogElement>('[data-donation-gate]');

	function getLocalDateKey() {
		const now = new Date();
		const year = now.getFullYear();
		const month = String(now.getMonth() + 1).padStart(2, '0');
		const day = String(now.getDate()).padStart(2, '0');
		return `${year}-${month}-${day}`;
	}

	function readStoredDate(storage: Storage) {
		try {
			return storage.getItem(STORAGE_KEY);
		} catch {
			return null;
		}
	}

	function storeDate(storage: Storage, dateKey: string) {
		try {
			storage.setItem(STORAGE_KEY, dateKey);
		} catch {
			// The prompt still works when browser privacy settings block storage.
		}
	}

	if (gate) {
		const today = getLocalDateKey();
		const alreadyShown =
			readStoredDate(window.localStorage) === today ||
			readStoredDate(window.sessionStorage) === today;

		if (!alreadyShown) {
			storeDate(window.localStorage, today);
			storeDate(window.sessionStorage, today);
			document.documentElement.classList.add('has-donation-gate');

			try {
				gate.showModal();
			} catch {
				document.documentElement.classList.remove('has-donation-gate');
			}
		}

		gate.querySelector('[data-donation-gate-dismiss]')?.addEventListener('click', () => {
			gate.close('dismissed');
		});

		gate.querySelector('[data-donation-gate-donate]')?.addEventListener('click', () => {
			gate.close('donated');
		});

		gate.addEventListener('close', () => {
			document.documentElement.classList.remove('has-donation-gate');
		});
	}
</script>

<style>
	:global(html.has-donation-gate) {
		overflow: hidden;
	}

	.donation-gate {
		width: min(42rem, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		padding: 0;
		border: 0;
		border-radius: 1.5rem;
		background: transparent;
		color: var(--text);
		overflow: auto;
		box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.72);
	}

	.donation-gate::backdrop {
		background:
			radial-gradient(circle at 50% 22%, rgba(255, 125, 59, 0.2), transparent 34rem),
			rgba(3, 4, 7, 0.9);
		backdrop-filter: blur(10px);
	}

	.donation-gate__card {
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(255, 176, 137, 0.32);
		border-radius: inherit;
		background:
			radial-gradient(circle at 100% 0, rgba(255, 125, 59, 0.2), transparent 45%),
			linear-gradient(145deg, rgba(22, 28, 39, 0.98), rgba(8, 11, 17, 0.99));
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.08),
			0 0 0 1px rgba(0, 0, 0, 0.35);
	}

	.donation-gate__card::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 0.2rem;
		background: linear-gradient(90deg, #ff7d3b, #ffb089 48%, #789cff);
	}

	.donation-gate__eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.9rem 1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.025);
		color: #c7d1e2;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}

	.donation-gate__status {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #31b36d;
		box-shadow: 0 0 0 0.3rem rgba(49, 179, 109, 0.12);
	}

	.donation-gate__body {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: clamp(1.6rem, 5vw, 3rem);
		text-align: center;
	}

	.donation-gate__logo {
		width: min(13rem, 62vw);
		height: auto;
		margin-bottom: 1.5rem;
	}

	.donation-gate__kicker,
	.donation-gate__frequency {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.donation-gate__kicker {
		color: var(--accent-soft);
	}

	.donation-gate h2 {
		max-width: 14ch;
		margin: 0.65rem 0 0;
		color: #fff;
		font-size: clamp(1.85rem, 5vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.donation-gate__description,
	.donation-gate__appeal {
		max-width: 55ch;
		margin: 1.1rem 0 0;
		color: #c4cede;
		font-size: 1rem;
		line-height: 1.65;
	}

	.donation-gate__appeal {
		margin-top: 1.2rem;
		color: #f2f5fa;
		font-weight: 600;
	}

	.donation-gate__impact {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.donation-gate__impact span {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid rgba(135, 157, 193, 0.24);
		border-radius: 999px;
		background: rgba(113, 140, 184, 0.08);
		color: #d8e1ef;
		font-size: 0.78rem;
	}

	.donation-gate__impact span::before {
		content: '\2713';
		margin-inline-end: 0.4rem;
		color: #72d49c;
		font-weight: 700;
	}

	.donation-gate__actions {
		display: grid;
		width: min(100%, 24rem);
		gap: 0.7rem;
		margin-top: 1.6rem;
	}

	.donation-gate__donate,
	.donation-gate__continue {
		min-height: 3.25rem;
		border-radius: 0.75rem;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
		transition:
			transform 0.18s ease,
			border-color 0.18s ease,
			background-color 0.18s ease,
			box-shadow 0.18s ease;
	}

	.donation-gate__donate {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		padding: 0.75rem 1.2rem;
		border: 1px solid #ffb089;
		background: linear-gradient(180deg, #ff955f, #f36d2b);
		color: #1d0c05;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.42),
			0 0.9rem 2rem rgba(243, 109, 43, 0.28);
	}

	.donation-gate__donate img {
		width: 1.15rem;
		height: 1.05rem;
	}

	.donation-gate__continue {
		padding: 0.7rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.13);
		background: rgba(255, 255, 255, 0.045);
		color: #dbe3ef;
	}

	.donation-gate__donate:hover,
	.donation-gate__donate:focus-visible,
	.donation-gate__continue:hover,
	.donation-gate__continue:focus-visible {
		transform: translateY(-2px);
	}

	.donation-gate__donate:hover,
	.donation-gate__donate:focus-visible {
		background: linear-gradient(180deg, #ffad82, #ff7d3b);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 1.1rem 2.4rem rgba(243, 109, 43, 0.36);
	}

	.donation-gate__continue:hover,
	.donation-gate__continue:focus-visible {
		border-color: rgba(255, 255, 255, 0.28);
		background: rgba(255, 255, 255, 0.085);
	}

	.donation-gate__frequency {
		margin-top: 1rem;
		color: #7f8ca2;
		font-size: 0.62rem;
	}

	@media (max-width: 34rem) {
		.donation-gate {
			width: calc(100vw - 1rem);
			max-height: calc(100dvh - 1rem);
			border-radius: 1.15rem;
		}

		.donation-gate__body {
			padding: 1.35rem 1.05rem 1.2rem;
		}

		.donation-gate__logo {
			margin-bottom: 1rem;
		}

		.donation-gate h2 {
			font-size: clamp(1.65rem, 9vw, 2.2rem);
		}

		.donation-gate__description,
		.donation-gate__appeal {
			font-size: 0.91rem;
			line-height: 1.5;
		}

		.donation-gate__impact {
			margin-top: 1rem;
		}

		.donation-gate__actions {
			margin-top: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.donation-gate__donate,
		.donation-gate__continue {
			transition: none;
		}
	}
</style>
