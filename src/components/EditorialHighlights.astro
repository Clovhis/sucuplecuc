---
import EditorialCard from './EditorialCard.astro';
import { getFeaturedEditorials } from '../lib/editorial';
const entries = getFeaturedEditorials();
---
{entries.length > 0 && <section class="editorial-highlights" aria-labelledby="desde-cineposta">
  <div class="editorial-highlights__heading"><h2 id="desde-cineposta">Desde CinePosta</h2><a href={`${import.meta.env.BASE_URL}editorial/`}>Todas las publicaciones →</a></div>
  <div class="editorial-highlights__grid">{entries.map((entry) => <EditorialCard entry={entry} />)}</div>
</section>}
<style>
  .editorial-highlights { margin-block: 2.5rem; }
  .editorial-highlights__heading { display: flex; justify-content: space-between; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; }
  h2 { margin: 0; }
  a { color: var(--accent-soft); padding-block: .75rem; }
  .editorial-highlights__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 900px) { .editorial-highlights__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .editorial-highlights__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
