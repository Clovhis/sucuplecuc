---
import MovieCard from './MovieCard.astro';
import PlatformBadge from './PlatformBadge.astro';
import type { PlatformFilterOption } from '../lib/platforms';
import { QUE_MIRO_HOY_PATH } from '../lib/seo';
import type { Movie } from '../types/movie';

interface FilterOption {
	id: string;
	label: string;
	description?: string;
}

interface Props {
	movies: Movie[];
	platformOptions: PlatformFilterOption[];
	editorialFilterOptions: FilterOption[];
	primaryGenreOptions: FilterOption[];
	subgenreOptions: FilterOption[];
	initialHomeMovies: Movie[];
	deferredHomeMovies: Movie[];
	movieCountLabel: string;
}

const {
	movies,
	platformOptions,
	editorialFilterOptions,
	primaryGenreOptions,
	subgenreOptions,
	initialHomeMovies,
	deferredHomeMovies,
	movieCountLabel,
} = Astro.props;
const specificYearOptions = Array.from(new Set(movies.map((movie) => movie.year))).sort((left, right) => right - left);
---

{
	movies.length > 0 ? (
		<section class="home-catalog__primary" aria-label="Catálogo principal">
			<section id="catalogo-filtros" class="home-results-tools fade-up" style="--item-delay: 35ms;" aria-labelledby="home-results-tools-title">
				<div class="home-results-tools__header">
					<div>
						<p class="home-results-tools__kicker">Catálogo argentino</p>
						<h2 id="home-results-tools-title">Películas publicadas</h2>
					</div>
					<p
						class="home-results-tools__counter"
						data-home-result-counter
						aria-label={`${movieCountLabel} películas en el catálogo`}
					>
						<strong data-home-result-count>{movieCountLabel}</strong>
						<span data-home-result-count-label>películas en catálogo</span>
					</p>
				</div>
				<div class="home-results-tools__primary-filters">
				<section class="home-genre-filter home-quick-filters" aria-labelledby="home-quick-filters-title">
					<div class="home-genre-filter__heading">
						<p id="home-quick-filters-title" class="home-genre-filter__label">Para elegir rápido</p>
					</div>
					<div class="home-genre-filter__chips" role="group" aria-label="Accesos rápidos al catálogo">
						<button type="button" class="home-genre-filter__chip home-quick-filters__chip" data-home-quick-filter="new-and-good" aria-pressed="false">
							<span class="home-quick-filters__chip-label">Nuevas y buenas</span>
							<img class="home-quick-filters__art" src="/images/home/cineposta-filtro-nuevas-buenas.png" alt="" width="512" height="512" aria-hidden="true" />
						</button>
						<button type="button" class="home-genre-filter__chip home-quick-filters__chip" data-home-quick-filter="premieres" aria-pressed="false">
							<span class="home-quick-filters__chip-label">Estrenos</span>
							<img class="home-quick-filters__art" src="/images/home/cineposta-filtro-estrenos.png" alt="" width="512" height="512" aria-hidden="true" />
						</button>
						<button type="button" class="home-genre-filter__chip home-quick-filters__chip" data-home-quick-filter="recommended" aria-pressed="false">
							<span class="home-quick-filters__chip-label">Recomendadas</span>
							<img class="home-quick-filters__art" src="/images/home/cineposta-filtro-recomendadas.png" alt="" width="512" height="512" aria-hidden="true" />
						</button>
					</div>
				</section>
				<section class="home-genre-filter home-genre-filter--verdict home-score-filter" data-home-filter-panel="score">
					<div class="home-genre-filter__heading">
						<p class="home-genre-filter__label">Score CinePosta</p>
						<p class="home-genre-filter__hint">Elegí la nota mínima. Se combina con todos los demás filtros.</p>
					</div>
					<div class="home-genre-filter__chips home-score-filter__presets" role="group" aria-label="Score mínimo de CinePosta">
						<button type="button" class="home-genre-filter__chip home-score-filter__chip" data-home-score-chip data-home-score-min="" aria-pressed="true">Todos</button>
						<button type="button" class="home-genre-filter__chip home-score-filter__chip" data-home-score-chip data-home-score-min="7" aria-pressed="false"><strong>7+</strong> Muy buenas</button>
						<button type="button" class="home-genre-filter__chip home-score-filter__chip" data-home-score-chip data-home-score-min="8" aria-pressed="false"><strong>8+</strong> Excelentes</button>
						<button type="button" class="home-genre-filter__chip home-score-filter__chip" data-home-score-chip data-home-score-min="9" aria-pressed="false"><strong>9+</strong> Obras maestras</button>
						<button type="button" class="home-genre-filter__chip home-score-filter__chip" data-home-score-chip data-home-score-min="10" aria-pressed="false"><strong>10</strong> Absolute Cinema</button>
					</div>
					<div class="home-score-filter__footer">
						<label class="home-filter-select home-score-filter__sort">
							<span>Ordenar por</span>
							<select data-home-sort aria-label="Ordenar películas">
								<option value="newest">Más nuevas</option>
								<option value="oldest">Más viejas</option>
								<option value="most-recommended">Mejor valoradas</option>
								<option value="least-recommended" hidden>Menos valoradas</option>
								<option value="title">A-Z</option>
							</select>
						</label>
						<a class="home-verdict-cta" href={QUE_MIRO_HOY_PATH}>
							<span class="home-verdict-cta__copy">
								<strong>Encontrá qué ver</strong>
								<small>Selector · 20 segundos</small>
							</span>
							<svg aria-hidden="true" viewBox="0 0 20 20" focusable="false">
								<path d="M4 10h11M11 6l4 4-4 4" />
							</svg>
						</a>
					</div>
				</section>
				</div>
				<details class="home-advanced-filters" data-home-advanced-filters>
					<summary class="home-advanced-filters__summary">
						<span class="home-advanced-filters__label" data-home-advanced-filter-label>Filtros avanzados</span>
						<span class="home-advanced-filters__indicator" aria-hidden="true"></span>
					</summary>
					<div
						class="home-results-tools__filters"
						data-home-filter-carousel
						role="region"
						aria-label="Filtros avanzados del catálogo"
					>
						<div class="home-results-tools__filter-column home-results-tools__filter-column--left">
						{
							platformOptions.length > 0 && (
								<section class="home-platform-filter" data-home-filter-panel="platform" data-home-platform-filter>
									<div class="home-genre-filter__heading">
										<p class="home-genre-filter__label">Dónde la querés ver</p>
										<p class="home-genre-filter__hint">Podés elegir más de una.</p>
									</div>
									<div class="home-platform-filter__chips" role="group" aria-label="Filtros por plataforma">
										{
											platformOptions.map((platform) => (
												<button
													type="button"
													class="home-platform-filter__chip"
													data-home-platform-chip
													data-home-platform-id={platform.normalizedLabel}
													data-home-platform-label={platform.displayLabel}
													aria-label={`Filtrar por ${platform.displayLabel}`}
													aria-pressed="false"
													title={platform.displayLabel}
												>
													<PlatformBadge
														platform={platform.normalizedLabel}
														className="home-platform-filter__badge"
													/>
												</button>
											))
										}
									</div>
								</section>
							)
						}
						<section class="home-genre-filter home-genre-filter--year" data-home-filter-panel="year">
									<div class="home-genre-filter__heading">
										<p class="home-genre-filter__label">De qué época</p>
										<p class="home-genre-filter__hint">Podés combinar décadas o ir a un año puntual.</p>
									</div>
									<div class="home-genre-filter__chips" role="group" aria-label="Filtros por década">
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="2020s" aria-pressed="false">2020s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="2010s" aria-pressed="false">2010s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="2000s" aria-pressed="false">2000s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="1990s" aria-pressed="false">90s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="1980s" aria-pressed="false">80s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="1970s" aria-pressed="false">70s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="1960s" aria-pressed="false">60s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="1950s" aria-pressed="false">50s</button>
										<button type="button" class="home-genre-filter__chip home-genre-filter__chip--year" data-home-year-chip data-home-year-id="before-1950" aria-pressed="false">Antes de 1950</button>
									</div>
									<label class="home-filter-select">
										<span>O elegí un año</span>
										<select data-home-specific-year aria-label="Elegí un año específico">
											<option value="">Todos los años</option>
											{specificYearOptions.map((year) => <option value={`year-${year}`}>{year}</option>)}
										</select>
									</label>
						</section>
					</div>
					<div class="home-results-tools__filter-column home-results-tools__filter-column--right">
						<section class="home-genre-filter" data-home-filter-panel="genre" data-home-genre-filter>
							<div class="home-genre-filter__heading">
								<p class="home-genre-filter__label">Qué género pinta</p>
								<p class="home-genre-filter__hint">Podés elegir más de uno.</p>
							</div>
							<div class="home-genre-filter__chips" role="group" aria-label="Filtros por género">
								{
									primaryGenreOptions.map((genre) => (
										<button
											type="button"
											class="home-genre-filter__chip"
											data-home-genre-chip
											data-home-genre-id={genre.id}
											data-home-genre-kind="genre"
											aria-pressed="false"
										>
											{genre.label}
										</button>
									))
								}
							</div>
						</section>
						{
							subgenreOptions.length > 0 && (
								<section class="home-genre-filter home-genre-filter--subgenre" data-home-filter-panel="subgenre" data-home-subgenre-filter>
									<div class="home-genre-filter__heading">
										<p class="home-genre-filter__label">Subgéneros</p>
										<p class="home-genre-filter__hint">Podés combinar varios para afinar.</p>
									</div>
									<div class="home-genre-filter__chips" role="group" aria-label="Filtros por subgénero">
										{
											subgenreOptions.map((subgenre) => (
												<>
													<button
														type="button"
														class="home-genre-filter__chip home-genre-filter__chip--subgenre"
													data-home-subgenre-chip
													data-home-subgenre-id={subgenre.id}
													data-subgenre-description={subgenre.description}
													data-filter-description={subgenre.description}
													aria-label={subgenre.label}
														aria-pressed="false"
													>
														{subgenre.label}
													</button>
												</>
											))
										}
									</div>
								</section>
							)
						}
						{
							editorialFilterOptions.length > 0 && (
								<section class="home-genre-filter home-genre-filter--editorial" data-home-filter-panel="editorial" data-home-editorial-filter>
									<div class="home-genre-filter__heading">
										<p class="home-genre-filter__label">Otros filtros</p>
									</div>
									<div class="home-genre-filter__chips" role="group" aria-label="Filtros editoriales">
										{
											editorialFilterOptions.map((genre) => (
												<button
													type="button"
													class="home-genre-filter__chip home-genre-filter__chip--editorial"
													data-home-genre-chip
													data-home-genre-id={genre.id}
													data-home-genre-kind="editorial"
													data-filter-description={genre.description}
													aria-label={genre.label}
													aria-pressed="false"
												>
													<span class="home-genre-filter__chip-label">{genre.label}</span>
												</button>
											))
										}
									</div>
								</section>
							)
						}
					</div>
					</div>
				</details>
				<div class="home-advanced-filters__active" data-home-advanced-active-filters hidden aria-live="polite">
					<p class="sr-only">Filtros avanzados activos</p>
					<div class="home-advanced-filters__active-list" data-home-advanced-active-filter-list></div>
				</div>
				<div
					class="home-results-tools__active"
					data-home-active-filters
					hidden
					aria-live="polite"
					aria-atomic="false"
				>
					<div class="home-results-tools__active-copy" data-home-active-filter-copy>
						<p class="home-results-tools__active-label">Filtros activos</p>
						<div class="home-results-tools__active-list" data-home-active-filter-list></div>
					</div>
					<button type="button" class="home-results-tools__reset" data-home-filter-reset hidden>
						Limpiar todo
					</button>
				</div>
				<div class="home-results-tools__feedback">
					<div
						class="movie-search__status"
						data-movie-search-status
						role="status"
						aria-live="polite"
						aria-atomic="true"
						hidden
					>
						<span class="movie-search__status-spinner" aria-hidden="true"></span>
						<p class="movie-search__status-copy" data-movie-search-status-copy>
							Bancá, que estoy acomodando el videoclub...
						</p>
					</div>
					<p class="message-box movie-search__empty" data-movie-search-empty hidden>
						No apareció nada con ese combo. Probá aflojar algún filtro.
					</p>
				</div>
			</section>

			<section
				class="movie-grid"
				aria-label="Películas publicadas"
				data-movie-search-grid
				data-movie-initial-count={initialHomeMovies.length}
				data-movie-total-count={movies.length}
			>
				{initialHomeMovies.map((movie, index) => <MovieCard movie={movie} index={index} />)}
			</section>
			<div hidden data-movie-card-templates aria-hidden="true">
				{
					deferredHomeMovies.map((movie, index) => (
						<template data-movie-card-template>
							<MovieCard movie={movie} index={index + initialHomeMovies.length} />
						</template>
					))
				}
			</div>
		</section>
	) : (
		<p class="message-box">Todavía no cargamos ninguna peli. Meté la primera ficha manual.</p>
	)
}
