---
import { getMoviePath, getPosterUrl, getVerdictBadgeClass, getVerdictLabel } from '../lib/movies';
import type { Movie } from '../types/movie';

interface Props {
	movie: Movie;
	index: number;
}

const { movie, index } = Astro.props as Props;
const movieUrl = getMoviePath(movie.slug);
const posterUrl = getPosterUrl(movie.poster);
const verdictLabel = getVerdictLabel(movie);
const verdictClass = getVerdictBadgeClass(movie);
const searchableText = [
	movie.title,
	movie.originalTitle,
	String(movie.year),
	movie.category,
	movie.releasePlatform ?? '',
	movie.director,
	movie.productionCompany,
	...(movie.mainCast ?? []),
	verdictLabel,
	movie.slug,
].join(' ');
---

<article
	class="movie-card fade-up"
	style={`--item-delay: ${index * 80}ms;`}
	data-movie-card
	data-movie-search={searchableText}
>
	<a href={movieUrl} class="movie-card__link" aria-label={`Ver detalle de ${movie.title}`}>
		<div class="movie-card__poster-wrap">
			<img class="movie-card__poster" src={posterUrl} alt={`Poster de ${movie.title}`} loading="lazy" />
		</div>
		<div class="movie-card__body">
			<div class="movie-card__header">
				<h2>{movie.title}</h2>
				<span class={`badge ${verdictClass}`}>{verdictLabel}</span>
			</div>
			<div class="movie-card__meta">
				<p class="movie-card__year">{movie.year}</p>
				{movie.releasePlatform && <span class="platform-chip">{movie.releasePlatform}</span>}
			</div>
			<p class="movie-card__cta">Ver ficha</p>
		</div>
	</a>
</article>
