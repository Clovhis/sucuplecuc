---
import { getMoviePath, getPosterUrl, getVerdictBadgeClass, getVerdictLabel } from '../lib/movies';
import type { Movie } from '../types/movie';

interface Props {
	movie: Movie;
	index: number;
}

const { movie, index } = Astro.props as Props;
const movieUrl = getMoviePath(movie.slug);
const posterUrl = getPosterUrl(movie.poster);
const verdictLabel = getVerdictLabel(movie);
const verdictClass = getVerdictBadgeClass(movie);

function normalizeText(value: string): string {
	return value
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.trim();
}

type VerdictGlyph = 'hook' | 'thumbs-up' | 'meh' | 'sad' | 'trash';

function getVerdictGlyph(movieData: Pick<Movie, 'verdict' | 'verdictLabel'>, label: string): VerdictGlyph {
	const normalizedLabel = normalizeText(label);
	if (normalizedLabel.includes('engancha')) {
		return 'hook';
	}
	if (normalizedLabel.includes('mediocre')) {
		return 'sad';
	}

	switch (movieData.verdict) {
		case 'recomendada':
			return 'thumbs-up';
		case 'zafa':
			return 'meh';
		case 'no_recomendada':
			return 'sad';
		case 'basura_atomica':
			return 'trash';
		default:
			return 'meh';
	}
}

const verdictGlyph = getVerdictGlyph(movie, verdictLabel);
const searchableText = [
	movie.title,
	movie.originalTitle,
	String(movie.year),
	movie.category,
	movie.releasePlatform ?? '',
	movie.director,
	movie.productionCompany,
	...(movie.mainCast ?? []),
	verdictLabel,
	movie.slug,
].join(' ');
---

<article
	class="movie-card fade-up"
	style={`--item-delay: ${index * 80}ms;`}
	data-movie-card
	data-movie-search={searchableText}
>
	<a href={movieUrl} class="movie-card__link" aria-label={`Ver detalle de ${movie.title}`}>
		<div class="movie-card__poster-wrap">
			<img class="movie-card__poster" src={posterUrl} alt={`Poster de ${movie.title}`} loading="lazy" />
		</div>
		<div class="movie-card__body">
			<div class="movie-card__header">
				<h2>{movie.title}</h2>
				<span class={`badge ${verdictClass}`}>{verdictLabel}</span>
			</div>
			<div class="movie-card__footer">
				<div class="movie-card__meta">
					<p class="movie-card__year">{movie.year}</p>
					{movie.releasePlatform && <span class="platform-chip">{movie.releasePlatform}</span>}
				</div>
				<p class="movie-card__cta">Ver ficha</p>
				<div class={`movie-card__glyph movie-card__glyph--${verdictGlyph}`} aria-hidden="true">
					{
						verdictGlyph === 'hook' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<path d="M14 4.5a3.5 3.5 0 1 0-7 0v6.2" />
								<path d="M7 10.7V13a5 5 0 0 0 10 0v-1.8" />
								<path d="M17 11.2h2.6a2.2 2.2 0 1 1 0 4.4h-1.7" />
							</svg>
						)
					}
					{
						verdictGlyph === 'thumbs-up' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<path d="M8.2 10.5v8.2" />
								<path d="M4 11.4h4.2v7.3H4.8A1.8 1.8 0 0 1 3 16.9v-3.7a1.8 1.8 0 0 1 1-1.8z" />
								<path d="M8.2 18.7h7a2 2 0 0 0 2-1.6l1-4.7a1.9 1.9 0 0 0-1.9-2.3H12l.8-3a2.1 2.1 0 0 0-4.1-1.2l-.5 1.7" />
							</svg>
						)
					}
					{
						verdictGlyph === 'meh' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<circle cx="12" cy="12" r="8.5" />
								<path d="M9 10h.01M15 10h.01" />
								<path d="M9 15h6" />
							</svg>
						)
					}
					{
						verdictGlyph === 'sad' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<circle cx="12" cy="6.4" r="2.4" />
								<path d="M12 8.8v5.4" />
								<path d="M8.2 12.4l3.8 2.1 3.8-2.1" />
								<path d="M9 20v-3.1a3 3 0 0 1 6 0V20" />
								<path d="M7 9.4l-1.1.8" />
							</svg>
						)
					}
					{
						verdictGlyph === 'trash' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<path d="M9 7.2V6a1.6 1.6 0 0 1 1.6-1.6h2.8A1.6 1.6 0 0 1 15 6v1.2" />
								<path d="M5.8 7.2h12.4" />
								<path d="M7.8 7.2l.9 11a1.8 1.8 0 0 0 1.8 1.6h2.9a1.8 1.8 0 0 0 1.8-1.6l.9-11" />
								<path d="M10.5 10.4l3 3M13.5 10.4l-3 3" />
							</svg>
						)
					}
				</div>
			</div>
		</div>
	</a>
</article>
