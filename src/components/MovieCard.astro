---
import {
	getAbsoluteCinemaStickerUrl,
	getCatalogFilterGenres,
	getMoviePath,
	getMoviePlatformLabel,
	getMoviePlatforms,
	getPositiveVerdictFilterId,
	getPosterUrl,
	getVerdictBadgeClass,
	getVerdictLabel,
	isAbsoluteCinemaMovie,
	normalizeSearchText,
} from '../lib/movies';
import { getNormalizedMoviePlatforms } from '../lib/platforms';
import PlatformBadgeGroup from './PlatformBadgeGroup.astro';
import type { Movie } from '../types/movie';

interface Props {
	movie: Movie;
	index: number;
}

const { movie, index } = Astro.props as Props;
const movieUrl = getMoviePath(movie.slug);
const posterUrl = getPosterUrl(movie.poster);
const verdictLabel = getVerdictLabel(movie);
const verdictClass = getVerdictBadgeClass(movie);
const catalogFilterGenres = getCatalogFilterGenres(movie).join(',');
const entryDelayMs = `${Math.min(index, 11) * 32}ms`;
const posterLoading = index < 8 ? 'eager' : 'lazy';
const posterFetchPriority = index < 4 ? 'high' : 'auto';
const quickCast = movie.mainCast.slice(0, 2).join(', ');
const moviePlatforms = getMoviePlatforms(movie);
const showAbsoluteCinemaSticker = isAbsoluteCinemaMovie(movie);
const absoluteCinemaStickerUrl = getAbsoluteCinemaStickerUrl();
const positiveVerdictFilterId =
	movie.verdict === 'recomendada' && !showAbsoluteCinemaSticker ? getPositiveVerdictFilterId(verdictLabel) : '';
const quickMeta = [String(movie.year), movie.category, getMoviePlatformLabel(movie)]
	.filter(Boolean)
	.join(' · ');
const searchableText = [
	movie.title,
	movie.originalTitle,
	movie.synopsis,
	String(movie.year),
	movie.category,
	movie.audienceRating,
	...moviePlatforms,
	movie.director,
	movie.productionCompany,
	...(movie.mainCast ?? []),
	verdictLabel,
	movie.slug,
].join(' ');
const searchableTextNormalized = normalizeSearchText(searchableText);
---

<article
	class={`movie-card movie-card--${verdictClass} fade-up`}
	style={`--item-delay: ${entryDelayMs};`}
	data-movie-card
	data-movie-search={searchableTextNormalized}
	data-movie-genres={catalogFilterGenres}
	data-movie-title={movie.title}
	data-movie-year={movie.year}
	data-movie-url={movieUrl}
	data-movie-poster-url={posterUrl}
	data-movie-meta={quickMeta}
	data-movie-cast={quickCast}
	data-movie-platforms={getNormalizedMoviePlatforms(movie).join(',')}
	data-movie-absolute-cinema={showAbsoluteCinemaSticker ? 'true' : 'false'}
	data-movie-positive-verdict-id={positiveVerdictFilterId}
>
	<a href={movieUrl} class="movie-card__link" aria-label={`Ver detalle de ${movie.title}`}>
		<div class="movie-card__poster-wrap">
			<img
				class="movie-card__poster"
				src={posterUrl}
				alt={`Poster de ${movie.title}`}
				loading={posterLoading}
				decoding="async"
				fetchpriority={posterFetchPriority}
				referrerpolicy="no-referrer"
				data-movie-poster
			/>
			{
				showAbsoluteCinemaSticker && (
					<img
						class="absolute-cinema-sticker movie-card__absolute-cinema-sticker"
						src={absoluteCinemaStickerUrl}
						alt="Absolute Cinema"
						loading={posterLoading}
						decoding="async"
						width="1254"
						height="1254"
					/>
				)
			}
			<span class={`badge movie-card__badge ${verdictClass}`}>{verdictLabel}</span>
		</div>
		<div class="movie-card__body">
			<div class="movie-card__header">
				<h2>{movie.title}</h2>
			</div>
			<div class="movie-card__footer">
				<div class="movie-card__meta">
					<p class="movie-card__year">{movie.year}</p>
				</div>
				<p class="movie-card__cta">{movie.category}</p>
				<p class="movie-card__audience-rating">{movie.audienceRating}</p>
				<PlatformBadgeGroup platforms={moviePlatforms} mode="tile" className="movie-card__platform-mark" />
			</div>
		</div>
	</a>
</article>
