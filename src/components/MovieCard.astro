---
import {
	getMoviePath,
	getPosterUrl,
	getRecommendationGenres,
	getVerdictBadgeClass,
	getVerdictLabel,
	normalizeSearchText,
} from '../lib/movies';
import type { Movie } from '../types/movie';

interface Props {
	movie: Movie;
	index: number;
}

const { movie, index } = Astro.props as Props;
const movieUrl = getMoviePath(movie.slug);
const posterUrl = getPosterUrl(movie.poster);
const verdictLabel = getVerdictLabel(movie);
const verdictClass = getVerdictBadgeClass(movie);
const recommendationGenres = getRecommendationGenres(movie).join(',');
const entryDelayMs = `${Math.min(index, 11) * 32}ms`;
const posterLoading = index < 8 ? 'eager' : 'lazy';
const posterFetchPriority = index < 4 ? 'high' : 'auto';

type VerdictGlyph = 'thumbs-up' | 'meh' | 'thumbs-down';

function getVerdictGlyph(badgeClass: string): VerdictGlyph {
	if (badgeClass === 'badge--recomendada') {
		return 'thumbs-up';
	}
	if (badgeClass === 'badge--zafa') {
		return 'meh';
	}
	return 'thumbs-down';
}

const verdictGlyph = getVerdictGlyph(verdictClass);
const quickCast = movie.mainCast.slice(0, 2).join(', ');
const quickMeta = [String(movie.year), movie.category, movie.releasePlatform ?? '']
	.filter(Boolean)
	.join(' · ');
const searchableText = [
	movie.title,
	movie.originalTitle,
	movie.synopsis,
	String(movie.year),
	movie.category,
	movie.releasePlatform ?? '',
	movie.director,
	movie.productionCompany,
	...(movie.mainCast ?? []),
	verdictLabel,
	movie.slug,
].join(' ');
const searchableTextNormalized = normalizeSearchText(searchableText);
---

<article
	class={`movie-card movie-card--${verdictGlyph} fade-up`}
	style={`--item-delay: ${entryDelayMs};`}
	data-movie-card
	data-movie-search={searchableTextNormalized}
	data-movie-genres={recommendationGenres}
	data-movie-title={movie.title}
	data-movie-year={movie.year}
	data-movie-url={movieUrl}
	data-movie-poster-url={posterUrl}
	data-movie-meta={quickMeta}
	data-movie-cast={quickCast}
>
	<a href={movieUrl} class="movie-card__link" aria-label={`Ver detalle de ${movie.title}`}>
		<div class="movie-card__poster-wrap">
			<img
				class="movie-card__poster"
				src={posterUrl}
				alt={`Poster de ${movie.title}`}
				loading={posterLoading}
				decoding="async"
				fetchpriority={posterFetchPriority}
				data-movie-poster
			/>
			<span class={`badge movie-card__badge ${verdictClass}`}>{verdictLabel}</span>
		</div>
		<div class="movie-card__body">
			<div class="movie-card__header">
				<h2>{movie.title}</h2>
			</div>
			<div class="movie-card__footer">
				<div class="movie-card__meta">
					<p class="movie-card__year">{movie.year}</p>
					{movie.releasePlatform && <span class="platform-chip">{movie.releasePlatform}</span>}
				</div>
				<p class="movie-card__cta">{movie.category}</p>
				<div class={`movie-card__glyph movie-card__glyph--${verdictGlyph}`} aria-hidden="true">
					{
						verdictGlyph === 'thumbs-up' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<path d="M8.2 10.5v8.2" />
								<path d="M4 11.4h4.2v7.3H4.8A1.8 1.8 0 0 1 3 16.9v-3.7a1.8 1.8 0 0 1 1-1.8z" />
								<path d="M8.2 18.7h7a2 2 0 0 0 2-1.6l1-4.7a1.9 1.9 0 0 0-1.9-2.3H12l.8-3a2.1 2.1 0 0 0-4.1-1.2l-.5 1.7" />
							</svg>
						)
					}
					{
						verdictGlyph === 'meh' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<circle cx="12" cy="12" r="8.5" />
								<path d="M9 10h.01M15 10h.01" />
								<path d="M9 15h6" />
							</svg>
						)
					}
					{
						verdictGlyph === 'thumbs-down' && (
							<svg viewBox="0 0 24 24" role="presentation">
								<g transform="translate(24 24) rotate(180)">
									<path d="M8.2 10.5v8.2" />
									<path d="M4 11.4h4.2v7.3H4.8A1.8 1.8 0 0 1 3 16.9v-3.7a1.8 1.8 0 0 1 1-1.8z" />
									<path d="M8.2 18.7h7a2 2 0 0 0 2-1.6l1-4.7a1.9 1.9 0 0 0-1.9-2.3H12l.8-3a2.1 2.1 0 0 0-4.1-1.2l-.5 1.7" />
								</g>
							</svg>
						)
					}
				</div>
			</div>
		</div>
	</a>
</article>
