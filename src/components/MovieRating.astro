---
interface Props {
	movieSlug: string;
}

const { movieSlug } = Astro.props as Props;
---

<section class="rating-card" data-rating-widget data-movie-slug={movieSlug}>
	<div class="rating-card__top">
		<p class="rating-card__title">Qué dice la gente</p>
		<p class="rating-card__summary">
			<span data-rating-average>Sin promedio todavía</span>
			<span aria-hidden="true">|</span>
			<span data-rating-count>Todavía sin votos</span>
		</p>
	</div>
	<div class="rating-stars" role="group" aria-label="Calificar película de 1 a 5 estrellas">
		<button type="button" data-star-value="1" aria-label="1 estrella">★</button>
		<button type="button" data-star-value="2" aria-label="2 estrellas">★</button>
		<button type="button" data-star-value="3" aria-label="3 estrellas">★</button>
		<button type="button" data-star-value="4" aria-label="4 estrellas">★</button>
		<button type="button" data-star-value="5" aria-label="5 estrellas">★</button>
	</div>
	<p class="rating-card__status" data-rating-status>Todavía nadie la puntuó. Meté el primer voto.</p>
</section>

<!-- Astro 6: keep browser logic in a typed local entrypoint so this component stays declarative. -->
<script src="../scripts/movie-rating-widget.ts"></script>
