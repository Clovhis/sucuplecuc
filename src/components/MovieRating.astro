---
interface Props {
	movieSlug: string;
}

const { movieSlug } = Astro.props as Props;
---

<section class="rating-card" data-rating-widget data-movie-slug={movieSlug}>
	<div class="rating-card__top">
		<p class="rating-card__title">Qué dice la gente</p>
		<p class="rating-card__summary">
			<span data-rating-average>Sin promedio todavía</span>
			<span aria-hidden="true">|</span>
			<span data-rating-count>Todavía sin votos</span>
		</p>
	</div>
	<div class="rating-stars" role="group" aria-label="Puntuar película del 1 al 10">
		{Array.from({ length: 10 }, (_, index) => index + 1).map((value) => (
			<button type="button" data-star-value={value} aria-label={`${value} de 10`} aria-pressed="false">{value}</button>
		))}
	</div>
	<p class="rating-card__status" data-rating-status role="status" aria-live="polite">Todavía nadie la puntuó. Meté el primer voto.</p>
</section>

<!-- Astro 6: keep browser logic in a typed local entrypoint so this component stays declarative. -->
<script src="../scripts/movie-rating-widget.ts"></script>
