---
import type { Movie } from '../types/movie';
import { formatCinePostaScore, getMovieCinePostaScore, getMovieLegacyVerdict } from '../lib/cineposta-score';

type Props = {
	movie: Pick<Movie, 'slug' | 'cinepostaScore' | 'verdict'>;
};

const { movie } = Astro.props as Props;

const barelyGoodReaction = {
	detail: 'Aprobó raspando: es buena, aunque llegó con lo justo.',
	kind: 'pass',
} as const;

const reactionByVerdict = {
	recomendada: {
		detail: 'El equipo la banca: pulgar arriba y plan de película resuelto.',
		kind: 'up',
	},
	zafa: {
		detail: 'No está mal, pero tampoco es para salir corriendo a verla.',
		kind: 'meh',
	},
	no_recomendada: {
		detail: 'El equipo no la compra: pulgar abajo y a buscar otra.',
		kind: 'down',
	},
	basura_atomica: {
		detail: 'Acá el equipo es unánime: pulgar abajo y a otra cosa.',
		kind: 'down',
	},
} as const;

const score = getMovieCinePostaScore(movie);
const reaction = score === 6 ? barelyGoodReaction : reactionByVerdict[getMovieLegacyVerdict(movie) ?? 'zafa'];
const scoreLabel = score === null ? 'Sin valorar' : formatCinePostaScore(score);
const headingId = `team-reaction-${movie.slug}`;
---

<section class={`movie-reaction movie-reaction--${reaction.kind}`} aria-labelledby={headingId}>
	<div class="movie-reaction__copy">
		<p class="movie-reaction__kicker">El equipo dice</p>
		<h2 id={headingId}>{scoreLabel}</h2>
		<p>{reaction.detail}</p>
	</div>
</section>
