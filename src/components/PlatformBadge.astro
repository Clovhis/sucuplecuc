---
import { getPlatformPresentation } from '../lib/platforms';

interface Props {
	platform?: string | null;
	className?: string;
	mode?: 'chip' | 'tile';
}

const { platform, className = '', mode = 'chip' } = Astro.props as Props;
const { variant, asset: platformAsset, displayLabel, accessibilityLabel, isKnownPlatform } = getPlatformPresentation(
	platform,
	{ mode },
);
const hasStyledVariant = variant !== 'default';

const rootClasses =
	mode === 'tile'
		? hasStyledVariant
			? ['platform-mark', 'platform-mark--tile', `platform-chip--${variant}`, className]
			: ['platform-mark', 'platform-mark--tile', className]
		: hasStyledVariant
			? ['platform-chip', platformAsset && 'platform-chip--brand', `platform-chip--${variant}`, className]
			: ['platform-chip', className];
---

{
	platform && (
		<span
			class:list={rootClasses}
			aria-label={hasStyledVariant || accessibilityLabel !== displayLabel ? `Plataforma: ${accessibilityLabel}` : undefined}
		>
			{
				variant === 'cine' ? (
					<span class="platform-chip__cine-label">{displayLabel}</span>
				) : isKnownPlatform && platformAsset ? (
					<img
						class:list={['platform-chip__logo', platformAsset?.wide && 'platform-chip__logo--wide']}
						src={platformAsset!.src}
						alt=""
						decoding="async"
						loading="lazy"
					/>
				) : mode === 'tile' ? (
					<span class="platform-mark__label">{displayLabel}</span>
				) : (
					<span>{displayLabel}</span>
				)
			}
			{(hasStyledVariant || accessibilityLabel !== displayLabel) && (
				<span class="u-visually-hidden">{accessibilityLabel}</span>
			)}
		</span>
	)
}
