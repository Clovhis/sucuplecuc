---
import { QUE_MIRO_HOY_PATH } from '../lib/seo';

interface Props {
	compact?: boolean;
	className?: string;
	id?: string;
}

const { compact = false, className = '', id } = Astro.props as Props;
const classes = ['postometro-teaser', compact ? 'postometro-teaser--compact' : '', className].filter(Boolean).join(' ');
const titleId = compact ? 'postometro-teaser-title-compact' : 'postometro-teaser-title';
---

<section id={id} class={classes} aria-labelledby={titleId}>
	<div class="postometro-teaser__art" aria-hidden="true">
		<img
			src="/images/home/cineposta-que-vemos-hoy-grupo.webp"
			alt=""
			width="1536"
			height="1024"
			loading="lazy"
			decoding="async"
		/>
	</div>
	<div class="postometro-teaser__copy">
		<p class="postometro-teaser__eyebrow">Selector de la noche</p>
		<h2 id={titleId} class="postometro-teaser__title">
			¿Qué vemos hoy?
		</h2>
		<p class="postometro-teaser__lead">
			Decinos cómo viene la noche y te acercamos una película que tenga sentido.
		</p>
		<ul class="postometro-teaser__steps" aria-label="Cómo funciona">
			<li>Elegí el plan</li>
			<li>Encontrá tu peli</li>
		</ul>
	</div>
	<div class="postometro-teaser__actions">
		<span class="postometro-teaser__time">En 20 segundos</span>
		<a class="postometro-teaser__link" href={QUE_MIRO_HOY_PATH}>
			Encontrá qué ver
			<svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
				<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />
			</svg>
		</a>
	</div>
</section>
