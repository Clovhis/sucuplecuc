---
import { QUE_MIRO_HOY_PATH } from '../lib/seo';

interface Props {
	compact?: boolean;
	className?: string;
	id?: string;
}

const { compact = false, className = '', id } = Astro.props as Props;
const classes = ['postometro-teaser', compact ? 'postometro-teaser--compact' : '', className].filter(Boolean).join(' ');
const titleId = compact ? 'postometro-teaser-title-compact' : 'postometro-teaser-title';
const characterSources = [
	'/images/home/cineposta-personaje-3d.webp',
	'/images/home/cineposta-personaje-3d-cinefila.webp',
	'/images/home/cineposta-personaje-3d-cineasta.webp',
	'/images/home/cineposta-personaje-3d-remotera.webp',
	'/images/home/cineposta-personaje-3d-cineclub.webp',
	'/images/home/cineposta-personaje-3d-inclusiva.webp',
];
---

<section id={id} class={classes} aria-labelledby={titleId}>
	<div class="postometro-teaser__art" aria-hidden="true">
		<img
			src={characterSources[0]}
			alt=""
			width="290"
			height="328"
			loading="lazy"
			decoding="async"
			data-postometro-character={!compact ? true : undefined}
			data-postometro-character-sources={!compact ? JSON.stringify(characterSources) : undefined}
		/>
	</div>
	<div class="postometro-teaser__copy">
		<h2 id={titleId} class="postometro-teaser__title">
			¿Qué vemos hoy?
		</h2>
		<p class="postometro-teaser__lead">
			¿No sabés qué mirar hoy? Armá la noche en 20 segundos: ánimo, tiempo, compañía, plataforma y cuánto peso querés bancarte.
		</p>
	</div>
	<div class="postometro-teaser__actions">
		<a class="postometro-teaser__link" href={QUE_MIRO_HOY_PATH}>
			Ver qué pinta
		</a>
	</div>
</section>

{!compact && <script src="../scripts/postometro-character.ts"></script>}
