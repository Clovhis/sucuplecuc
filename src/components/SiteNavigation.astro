---
const base = import.meta.env.BASE_URL;
// A same-page fragment keeps the catalog's current search and filter query.
const homeSection = (id: string) => `${Astro.url.pathname === base ? '' : base}#${id}`;
const icons = {
  film: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 8h4M3 16h4M17 8h4M17 16h4"/>',
  news: '<path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h4"/><path d="M19 8h2v12H3V8h2"/>',
  cinema: '<path d="M3 6h18v4a2 2 0 0 0 0 4v4H3v-4a2 2 0 0 0 0-4zM16 8v2M16 12v2M16 16v.01"/>',
  screen: '<rect x="3" y="5" width="18" height="13" rx="2"/><path d="M8 21h8M12 18v3m-2-12 5 3-5 3z"/>',
  bookmark: '<path d="M6 3h12v18l-6-4-6 4z"/>',
  people: '<circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M17 5a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 5v1"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m16 8-2.5 5.5L8 16l2.5-5.5z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18M8 14h2M14 14h2M8 17h2"/>',
  game: '<path d="M7 7h10a3 3 0 0 1 3 2l2 9a2 2 0 0 1-3 2l-4-3H9l-4 3a2 2 0 0 1-3-2l2-9a3 3 0 0 1 3-2zM8 10v5M5.5 12.5h5M16 11h.01M18 14h.01"/>',
  chat: '<path d="M4 4h16v12H9l-5 4zM8 8h8M8 12h5"/>',
  radar: '<circle cx="12" cy="12" r="9"/><path d="M12 3v9l6 6M8 5a8 8 0 0 0 11 11"/><circle cx="8" cy="14" r="1"/>',
};
const primary = [
  { href: homeSection('catalogo-filtros'), label: 'Películas', icon: icons.film },
  { href: `${base}editorial/`, label: 'Noticias y notas', icon: icons.news },
];
const sections = [
  { href: homeSection('cinema-release-carousel'), label: 'En cines', icon: icons.cinema },
  { href: homeSection('streaming-release-carousel'), label: 'Streaming', icon: icons.screen },
  { href: homeSection('weekly-recommendations'), label: 'Recomendadas', icon: icons.bookmark },
  { href: `${base}personas/`, label: 'Personas', icon: icons.people },
  { href: `${base}que-miro-hoy/`, label: 'Qué ver', icon: icons.compass },
];
const more = [
  { href: homeSection('proximos-estrenos'), label: 'Próximos estrenos', icon: icons.calendar },
  { href: homeSection('radar-de-cine'), label: 'Radar de cine', icon: icons.radar },
  { href: `${base}juegos/simulador-carrera-actor/`, label: 'Juego de cine', icon: icons.game },
  { href: `${base}comunidad/`, label: 'Comunidad', icon: icons.chat },
];
const current = (href: string) => !href.includes('#') && Astro.url.pathname.startsWith(href) ? 'true' : undefined;
---

<nav class="site-navigation" aria-label="Secciones de CinePosta">
  <div class="site-navigation__inner">
    <div class="site-navigation__primary">
      {primary.map(link => <a class="site-navigation__link" href={link.href} aria-current={current(link.href)}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon} /><span>{link.label}</span>
      </a>)}
    </div>
    <details class="site-navigation__sections" open>
      <summary>Secciones <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
      <div class="site-navigation__links">
        {sections.map(link => <a class="site-navigation__link" href={link.href} aria-current={current(link.href)}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon} /><span>{link.label}</span>
        </a>)}
        <details class="site-navigation__more">
          <summary>Más <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
          <div class="site-navigation__extra">
            {more.map(link => <a class="site-navigation__link" href={link.href} aria-current={current(link.href)}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon} /><span>{link.label}</span>
            </a>)}
          </div>
        </details>
      </div>
    </details>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.site-navigation');
  const sections = nav?.querySelector<HTMLDetailsElement>('.site-navigation__sections');
  const more = nav?.querySelector<HTMLDetailsElement>('.site-navigation__more');
  const compact = matchMedia('(max-width: 1000px)');
  const sync = () => {
    if (sections) sections.open = !compact.matches;
    if (more) more.open = compact.matches;
  };
  sync();
  compact.addEventListener('change', sync);
  const markLocation = () => {
    nav?.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach(link => {
      const url = new URL(link.href);
      if (url.pathname === location.pathname && url.hash === location.hash) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  markLocation();
  addEventListener('hashchange', markLocation);
  nav?.addEventListener('click', event => {
    if (!(event.target instanceof Element) || !event.target.closest('a')) return;
    if (sections && compact.matches) sections.open = false;
    if (more && !compact.matches) more.open = false;
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !nav?.contains(event.target)) {
      if (more && !compact.matches) more.open = false;
      if (sections && compact.matches) sections.open = false;
    }
  });
  nav?.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const disclosure = compact.matches ? sections : more;
    if (disclosure?.open) {
      disclosure.open = false;
      disclosure.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-navigation {
    --nav-ink: #c5c9d0;
    --nav-accent: #e6b291;
    --nav-line: #343b45;
    position: relative;
    z-index: 200;
    border-bottom: 1px solid var(--nav-line);
    background: #101318;
    color: var(--nav-ink);
    font: 500 .8rem/1.3 var(--font-sans);
  }
  :global(.skip-link:focus) { z-index: 201; }
  .site-navigation__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: min(1180px, calc(100% - 2rem));
    min-height: 3.25rem;
    margin-inline: auto;
  }
  .site-navigation__primary, .site-navigation__links { display: flex; align-items: center; gap: 1.5rem; }
  .site-navigation__sections { margin-left: auto; }
  .site-navigation__sections > summary { display: none; }
  .site-navigation__link, summary {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 3.25rem;
    padding: .25rem 0;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .site-navigation__link { position: relative; }
  .site-navigation__link::after {
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    background: var(--nav-accent);
    content: '';
    opacity: 0;
  }
  .site-navigation__link:hover, .site-navigation__link[aria-current], summary:hover, details[open] > summary { color: var(--nav-accent); }
  .site-navigation__link:hover::after, .site-navigation__link[aria-current]::after { opacity: 1; }
  .site-navigation__link:focus-visible, summary:focus-visible { outline: 2px solid var(--nav-accent); outline-offset: 3px; }
  svg { width: 17px; height: 17px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
  summary svg { width: 14px; height: 14px; }
  details[open] > summary svg { transform: rotate(180deg); }
  .site-navigation__more { position: relative; margin-left: .25rem; padding-left: 1.25rem; }
  .site-navigation__more::before { position: absolute; left: 0; top: 1.15rem; height: 1rem; border-left: 1px solid var(--nav-line); content: ''; }
  .site-navigation__extra {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    min-width: 230px;
    padding: .5rem 1rem;
    border: 1px solid var(--nav-line);
    background: #101318;
  }
  .site-navigation__extra .site-navigation__link { display: flex; min-height: 44px; }
  @media (max-width: 1100px) and (min-width: 1001px) {
    .site-navigation__inner, .site-navigation__primary, .site-navigation__links { gap: 1rem; }
  }
  @media (max-width: 1000px) {
    .site-navigation__inner { display: block; position: relative; min-height: 48px; }
    .site-navigation__primary { gap: 1.25rem; padding-right: 100px; }
    .site-navigation__link, summary { min-height: 48px; }
    .site-navigation__sections { margin: 0; }
    .site-navigation__sections > summary { display: inline-flex; position: absolute; top: 0; right: 0; }
    .site-navigation__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.25rem; border-top: 1px solid var(--nav-line); padding-block: .5rem; }
    .site-navigation__links .site-navigation__link { white-space: normal; }
    .site-navigation__more { display: block; grid-column: 1 / -1; margin: .5rem 0 0; padding: .5rem 0 0; border-top: 1px solid var(--nav-line); }
    .site-navigation__extra { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.25rem; min-width: 0; padding: 0; border: 0; }
    .site-navigation__more > summary, .site-navigation__more::before { display: none; }
  }
  @media (max-width: 360px) {
    .site-navigation { font-size: .75rem; }
    .site-navigation__primary { gap: .85rem; padding-right: 90px; }
    .site-navigation__primary svg { display: none; }
  }
</style>
