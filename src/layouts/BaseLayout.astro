---
import '../styles/global.css';
import DonationGate from '../components/DonationGate.astro';
import { ADSENSE_CLIENT_ID } from '../lib/adsense';
import {
	ABOUT_PATH,
	CONTACT_PATH,
	COPYRIGHT_PATH,
	EDITORIAL_POLICY_PATH,
	METHODOLOGY_PATH,
	PEOPLE_PATH,
	PRIVACY_PATH,
	QUE_MIRO_HOY_PATH,
	SITE_LANGUAGE,
	SITE_LOCALE,
	SITE_NAME,
	SOURCES_AND_DATA_PATH,
} from '../lib/seo';
import { DEFAULT_SUPABASE_URL } from '../lib/supabaseClient';

interface Props {
	title: string;
	description: string;
	image?: string;
	openGraphType?: 'article' | 'website';
	structuredData?: Array<Record<string, unknown>>;
	noindex?: boolean;
	allowAds?: boolean;
}

const {
	title,
	description,
	image,
	openGraphType = 'website',
	structuredData = [],
	noindex = false,
	allowAds = true,
} = Astro.props as Props;
const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: Astro.url.toString();
const assetBase = import.meta.env.BASE_URL;
const supabaseOrigin = new URL(import.meta.env.PUBLIC_SUPABASE_URL || DEFAULT_SUPABASE_URL).origin;
const contentSecurityPolicy = [
	"default-src 'self'",
	"base-uri 'self'",
	"object-src 'none'",
	"form-action 'self'",
	"img-src 'self' data: https:",
	`connect-src 'self' ${supabaseOrigin} https:`,
	"font-src 'self' https://fonts.gstatic.com data:",
	"style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
	"script-src 'self' 'unsafe-inline' 'unsafe-eval' https:",
	"frame-src https:",
	"manifest-src 'self'",
	'upgrade-insecure-requests',
].join('; ');
const footerLinks = [
	{ href: import.meta.env.BASE_URL, label: 'Inicio' },
	{ href: QUE_MIRO_HOY_PATH, label: 'Qué vemos hoy' },
	{ href: PEOPLE_PATH, label: 'Personas' },
	{ href: METHODOLOGY_PATH, label: 'Cómo funciona' },
	{ href: ABOUT_PATH, label: 'Sobre' },
	{ href: EDITORIAL_POLICY_PATH, label: 'Editorial' },
	{ href: SOURCES_AND_DATA_PATH, label: 'Fuentes' },
	{ href: COPYRIGHT_PATH, label: 'Copyright' },
	{ href: CONTACT_PATH, label: 'Contacto' },
	{ href: PRIVACY_PATH, label: 'Privacidad' },
];
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
		<meta
			name="robots"
			content={
				noindex
					? 'noindex, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
					: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
			}
		/>
		<meta name="author" content={SITE_NAME} />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		{
			allowAds && (
				<script
					is:inline
					async
					src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
					crossorigin="anonymous"
				></script>
			)
		}
		<meta name="theme-color" content="#06070a" />
		<meta name="application-name" content={SITE_NAME} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content={openGraphType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={SITE_LOCALE} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{image && <meta property="og:image" content={image} />}
		{image && <meta name="twitter:image" content={image} />}
		<link rel="canonical" href={canonical} />
		<link rel="alternate" href={canonical} hreflang={SITE_LANGUAGE.toLowerCase()} />
		<link rel="alternate" href={canonical} hreflang="x-default" />
		<link rel="icon" href={`${assetBase}favicon.ico`} sizes="any" />
		<link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${assetBase}favicon-32x32.png`} />
		<link rel="icon" type="image/png" sizes="48x48" href={`${assetBase}favicon-48x48.png`} />
		<link rel="icon" type="image/png" sizes="192x192" href={`${assetBase}favicon-192x192.png`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${assetBase}apple-touch-icon.png`} />
		<link rel="manifest" href={`${assetBase}site.webmanifest`} />
		<link rel="shortcut icon" href={`${assetBase}favicon.ico`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Spline+Sans+Mono:wght@500;600&display=swap"
			rel="stylesheet"
		/>
		{
			structuredData.map((entry) => (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
			))
		}
	</head>
	<body>
		<a class="skip-link" href="#main-content">Saltar al contenido principal</a>
		<DonationGate />
		<slot />
		<footer class="site-footer">
			<div class="site-footer__inner container">
				<div class="site-footer__brand">
					<p class="site-footer__copy">
						<strong>{SITE_NAME}</strong> es un proyecto editorial independiente de reseñas cortas, datos de catálogo y recomendaciones para decidir qué mirar sin chamuyo.
					</p>
					<a
						class="site-footer__donate"
						href="https://cafecito.app/cineposta"
						target="_blank"
						rel="noopener noreferrer"
					>
						<img
							class="site-header__donate-logo"
							src={`${assetBase}brand/cafecito-logo.svg`}
							alt=""
							aria-hidden="true"
						/>
						Apoyá el sitio
					</a>
				</div>
				<nav class="site-footer__nav" aria-label="Navegación del sitio">
					{
						footerLinks.map((link) => (
							<a class="site-footer__link" href={link.href}>
								{link.label}
							</a>
						))
					}
				</nav>
				<p class="site-footer__legal">
					© {currentYear} {SITE_NAME}. Hecho desde Argentina. Las marcas, posters y materiales citados pertenecen a sus titulares.
				</p>
			</div>
		</footer>
	</body>
</html>
