---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/seo';

const pageTitle = `Cómo funciona ${SITE_NAME} | Veredictos y metodología`;
const pageDescription =
	'Cine Posta explica cómo arma sus reseñas breves, sus veredictos y su criterio editorial: una guía argentina, directa y práctica para decidir qué mirar.';

const verdicts = [
	{
		name: 'Absolute Cinema',
		copy: 'Es el sello máximo. Acá entran las obras maestras, los clásicos totales y esas pelis que no solo recomendamos: las defendemos a muerte.',
	},
	{
		name: 'Recomendada',
		copy: 'Está buena de verdad. Si ya te llama un poco, hay muchas chances de que te guste.',
	},
	{
		name: 'Zafa',
		copy: 'Tiene algo para ofrecer, pero no es prioridad. Puede entrar justo según tu mood, el género o el elenco.',
	},
	{
		name: 'Malísima',
		copy: 'No alcanza. Puede tener alguna idea o algún momento suelto, pero en conjunto no levanta.',
	},
	{
		name: 'Basura atómica',
		copy: 'Nivel desastre. Solo suma si vas por morbo, completismo o para verla y putearla con amigos.',
	},
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<main id="main-content" class="container about-page methodology-page">
		<div class="page-actions">
			<a class="page-action page-action--home" href={import.meta.env.BASE_URL}>Volver al inicio</a>
		</div>

		<section class="about-page__hero fade-up" style="--item-delay: 0ms;">
			<p class="about-page__kicker">Criterio editorial</p>
			<h1 class="about-page__title">Cómo funciona Cine Posta</h1>
			<p class="about-page__lead">
				Esto no intenta ser crítica académica. Es una guía práctica, directa y bien de acá para decidir rápido si una película va con tu noche o si conviene seguir de largo.
			</p>
		</section>

		<section class="about-page__grid methodology-page__grid">
			<article class="about-page__card fade-up" style="--item-delay: 80ms;">
				<h2>Qué miramos</h2>
				<p>
					Miramos si la película cumple la promesa que vende: tono, ritmo, actuaciones, duración, género y ganas reales de recomendarla.
				</p>
				<p>
					La reseña es corta porque la decisión también suele ser corta: ¿la veo hoy, la dejo para después o ni me gasto?
				</p>
			</article>

			<article class="about-page__card fade-up" style="--item-delay: 140ms;">
				<h2>Cómo se escribe</h2>
				<p>
					Cine Posta escribe con voz propia: rioplatense, directa y sin hacerse la importante. La idea es orientar, no posar de crítico iluminado.
				</p>
				<p>
					Los datos técnicos ayudan, pero el centro es la experiencia: qué te puede dar la peli y qué te puede hacer perder el tiempo.
				</p>
			</article>

			<article class="about-page__card fade-up" style="--item-delay: 200ms;">
				<h2>Qué no hacemos</h2>
				<p>
					No puntuamos como una planilla, no fingimos neutralidad absoluta y no estiramos reseñas para rellenar.
				</p>
				<p>
					Si una película es chica, rara, fallida o incómoda, igual puede entrar. Lo importante es decir con claridad para quién puede funcionar.
				</p>
			</article>
		</section>

		<section class="methodology-page__verdicts fade-up" style="--item-delay: 260ms;" aria-labelledby="verdictos-title">
			<div class="methodology-page__section-head">
				<p class="about-page__kicker">Diccionario posta</p>
				<h2 id="verdictos-title">Qué significa cada veredicto</h2>
				<p>
					A veces el badge cambia y dice cosas como "Muy buena", "Imperdible" u "Obra maestra", pero abajo de eso estos son los escalones reales con los que ordenamos el veredicto.
				</p>
			</div>
			<div class="methodology-page__verdict-grid">
				{verdicts.map((verdict) => (
					<article class="methodology-page__verdict-card">
						<h3>{verdict.name}</h3>
						<p>{verdict.copy}</p>
					</article>
				))}
			</div>
		</section>
	</main>
</BaseLayout>
