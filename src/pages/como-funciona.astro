---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBrandLink from '../components/HomeBrandLink.astro';
import { CINEPOSTA_SCORES, formatCinePostaScore } from '../lib/cineposta-score';
import { SITE_NAME } from '../lib/seo';

const pageTitle = `Cómo funciona ${SITE_NAME} | Scores y metodología`;
const pageDescription =
	'Cine Posta explica cómo arma sus reseñas breves, su score del 1 al 10 y su criterio editorial: una guía argentina, directa y práctica para decidir qué mirar.';

const scoreDescriptions = {
	1: 'Un desastre de punta a punta. Puede servir para el morbo, el completismo o una noche de verla y putearla con amigos.',
	2: 'Casi nada funciona y lo poco rescatable no alcanza para sostenerla.',
	3: 'Tiene alguna idea o momento suelto, pero el conjunto sigue quedando muy abajo.',
	4: 'Falla más de lo que acierta. Solo entra si el género, el elenco o la curiosidad te tiran fuerte.',
	5: 'Mitad y mitad: puede acompañar un rato, aunque no es una prioridad.',
	6: 'Cumple lo que promete y deja una experiencia positiva, sin llegar a destacarse demasiado.',
	7: 'Está muy bien y la recomendamos con confianza. Es el primer umbral fuerte para elegir qué ver.',
	8: 'Se destaca de verdad: una recomendación clara, sólida y con bastante para recordar.',
	9: 'Una obra maestra. De esas películas que justifican buscarles un lugar cuanto antes.',
	10: 'El sello máximo de Cine Posta: películas extraordinarias que defendemos a muerte.',
} as const;

const scores = CINEPOSTA_SCORES.map((score) => ({
	name: formatCinePostaScore(score),
	copy: scoreDescriptions[score],
}));
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<main id="main-content" class="container about-page methodology-page">
		<div class="page-actions">
			<HomeBrandLink className="page-action page-action--home" />
		</div>

		<section class="about-page__hero fade-up" style="--item-delay: 0ms;">
			<p class="about-page__kicker">Criterio editorial</p>
			<h1 class="about-page__title">Cómo funciona Cine Posta</h1>
			<p class="about-page__lead">
				Esto no intenta ser crítica académica. Es una guía práctica, directa y bien de acá para decidir rápido si una película va con tu noche o si conviene seguir de largo.
			</p>
		</section>

		<section class="about-page__grid methodology-page__grid">
			<article class="about-page__card fade-up" style="--item-delay: 80ms;">
				<h2>Qué miramos</h2>
				<p>
					Miramos si la película cumple la promesa que vende: tono, ritmo, actuaciones, duración, género y ganas reales de recomendarla.
				</p>
				<p>
					La reseña es corta porque la decisión también suele ser corta: ¿la veo hoy, la dejo para después o ni me gasto?
				</p>
			</article>

			<article class="about-page__card fade-up" style="--item-delay: 140ms;">
				<h2>Cómo se escribe</h2>
				<p>
					Cine Posta escribe con voz propia: rioplatense, directa y sin hacerse la importante. La idea es orientar, no posar de crítico iluminado.
				</p>
				<p>
					Los datos técnicos ayudan, pero el centro es la experiencia: qué te puede dar la peli y qué te puede hacer perder el tiempo.
				</p>
			</article>

			<article class="about-page__card fade-up" style="--item-delay: 200ms;">
				<h2>Qué no hacemos</h2>
				<p>
					El número no reemplaza la reseña ni finge una neutralidad absoluta: resume un criterio editorial, no una cuenta matemática.
				</p>
				<p>
					Si una película es chica, rara, fallida o incómoda, igual puede entrar. Lo importante es decir con claridad para quién puede funcionar.
				</p>
			</article>
		</section>

		<section class="methodology-page__verdicts fade-up" style="--item-delay: 260ms;" aria-labelledby="verdictos-title">
			<div class="methodology-page__section-head">
				<p class="about-page__kicker">Diccionario posta</p>
				<h2 id="verdictos-title">Qué significa cada score</h2>
				<p>
					El número es la fuente de verdad y siempre aparece con su nombre. Así podés comparar, ordenar y filtrar sin perder la lectura humana de la nota.
				</p>
			</div>
			<div class="methodology-page__verdict-grid">
				{scores.map((verdict) => (
					<article class="methodology-page__verdict-card">
						<h3>{verdict.name}</h3>
						<p>{verdict.copy}</p>
					</article>
				))}
			</div>
		</section>
	</main>
</BaseLayout>
