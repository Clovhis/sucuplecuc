---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBrandLink from '../components/HomeBrandLink.astro';
import { COMMUNITY_PATH, getMovieCommunityPath } from '../lib/community';
import { getLatestReviewMovies, getMovies, getPosterUrl } from '../lib/movies';
import { createSimplePageStructuredData, SITE_NAME } from '../lib/seo';

const pageTitle = `Foro Cineposta | ${SITE_NAME}`;
const pageDescription = 'Foro Cineposta: el rincón para tirar factos, recomendaciones y opiniones de cine sin vender humo.';
const movies = getMovies();
const discussionMovies = getLatestReviewMovies(movies, 12);
const communityDiscussionVisuals = Object.fromEntries(movies.map((movie) => [movie.slug, {
	posterSrc: getPosterUrl(movie.poster),
	facts: `${movie.category} · ${movie.year}`,
}]));
const communityDiscussionVisualsJson = JSON.stringify(communityDiscussionVisuals).replace(/</g, '\\u003c');
const structuredData = createSimplePageStructuredData(COMMUNITY_PATH, pageTitle, pageDescription);
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData} allowAds={false}>
	<main id="main-content" class="container community-page">
		<nav class="community-page__nav" aria-label="Navegación principal">
			<HomeBrandLink className="community-page__home-link" label="Cine Posta: volver al inicio" />
			<a class="community-page__current-link" href={COMMUNITY_PATH} aria-current="page">Comunidad</a>
		</nav>
		<section class="community-page__hero fade-up" style="--item-delay: 0ms;">
			<div class="community-page__hero-content">
				<p class="community-page__eyebrow">La comunidad de Cine Posta</p>
				<h1>Foro Cineposta</h1>
				<p class="community-page__tagline" data-community-banner>Vení a tirar factos sobre esa película que te dejó pensando.</p>
				<p class="community-page__lead">Una discusión por peli, con gente que también se queda hasta los créditos. Caé con una opinión, una recomendación o una toma polémica.</p>
			</div>
			<div class="community-page__hero-illustration" aria-hidden="true">
				<img src="/images/community/foro-cineposta-comunidad.png" alt="" width="1536" height="1024" decoding="async" fetchpriority="high" />
			</div>
		</section>
		<div class="community-page__content">
			<section class="community-page__comments fade-up" style="--item-delay: 80ms;" aria-labelledby="conversacion">
				<div class="community-page__section-heading"><div><h2 id="conversacion">Discusiones recientes</h2></div><p>Una discusión por película.</p></div>
				<ul class="community-discussion-list" data-community-discussion-list aria-live="polite">
					{discussionMovies.map((movie) => <li data-community-discussion-slug={movie.slug} data-community-discussion-facts={`${movie.category} · ${movie.year}`}><a href={getMovieCommunityPath(movie.slug)}><img class="community-discussion-list__poster" src={getPosterUrl(movie.poster)} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /><span class="community-discussion-list__body"><strong>{movie.title}</strong><span class="community-discussion-list__facts">{movie.category} · {movie.year} · Abrir discusión</span></span></a></li>)}
				</ul>
			</section>
			<aside class="community-page__rules fade-up" style="--item-delay: 160ms;" aria-labelledby="reglas-sala">
				<h2 id="reglas-sala">Código de la sala</h2>
				<ul><li>Picanteá la discusión, no a la persona del otro lado.</li><li>Si vas a soltar una bomba del final, marcala como spoiler y todos felices.</li><li>Spam, links turbios y cadenas: directo al tacho.</li><li>Podés amar u odiar una peli; tirá argumentos y no patadas.</li></ul>
				<p class="community-page__privacy-note">Los mensajes se guardan temporalmente y cada película conserva un solo hilo. Más información en nuestra <a href="/politica-de-privacidad/">política de privacidad</a>.</p>
			</aside>
		</div>
	</main>
</BaseLayout>

<script is:inline id="community-discussion-visuals" type="application/json" set:html={communityDiscussionVisualsJson}></script>
<script src="../scripts/community-discussions.ts"></script>
<script src="../scripts/community-banner.ts"></script>
