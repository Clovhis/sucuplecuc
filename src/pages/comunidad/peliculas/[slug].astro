---
import { getMovies, getMoviePath } from '../../../lib/movies';
import aliases from '../../../data/movie-aliases.json';

export function getStaticPaths() {
	const movies = getMovies();
	const paths = movies.map((movie) => ({ params: { slug: movie.slug }, props: { movie } }));
	for (const [legacy, canonical] of Object.entries(aliases)) {
		const movie = movies.find((entry) => entry.slug === canonical);
		if (movie) paths.push({ params: { slug: legacy }, props: { movie } });
	}
	return paths;
}

const { movie } = Astro.props;
const destination = getMoviePath(movie.slug);
---
<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<title>{movie.title} | CinePosta</title>
		<link rel="canonical" href={`https://www.cineposta.com.ar${destination}`} />
		<meta http-equiv="refresh" content={`0;url=${destination}`} />
	</head>
	<body><p>La película está en <a href={destination}>{movie.title} ({movie.year})</a>.</p></body>
</html>
