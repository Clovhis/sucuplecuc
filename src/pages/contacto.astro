---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBrandLink from '../components/HomeBrandLink.astro';
import {
	CONTACT_EMAIL,
	CONTACT_PATH,
	EDITORIAL_TEAM_NAME,
	EDITORIAL_TEAM_PATH,
	PRESS_EMAIL,
	SITE_NAME,
	createSimplePageStructuredData,
} from '../lib/seo';

const pageTitle = `Contacto | ${SITE_NAME}`;
const pageDescription =
	'Contacto de Cine Posta para consultas generales, prensa, correcciones editoriales y revisiones de material o datos.';
const structuredData = createSimplePageStructuredData(CONTACT_PATH, pageTitle, pageDescription, 'ContactPage');
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<main id="main-content" class="container about-page">
		<div class="page-actions">
			<HomeBrandLink className="page-action page-action--home" />
		</div>

		<section class="about-page__hero fade-up" style="--item-delay: 0ms;">
			<div class="about-page__hero-copy">
				<p class="about-page__kicker">Canales abiertos</p>
				<h1 class="about-page__title">Contacto</h1>
				<p class="about-page__lead">
					Si tenés una consulta sobre el sitio, una corrección de datos, un tema de prensa o un pedido de revisión de
					material, este es el punto de contacto oficial de {SITE_NAME}.
				</p>
			</div>
			<div class="about-page__hero-art" aria-hidden="true">
				<img
					src="/images/home/cineposta-personaje-telefono-90s.webp"
					alt=""
					width="1536"
					height="1024"
					decoding="async"
				/>
			</div>
		</section>

		<section class="about-page__grid">
			<article class="about-page__card fade-up" style="--item-delay: 30ms;">
				<h2>Responsabilidad editorial</h2>
				<p>
					La responsabilidad editorial de Cine Posta está a cargo de <a href={EDITORIAL_TEAM_PATH}>{EDITORIAL_TEAM_NAME}</a>.
				</p>
			</article>
			<article class="about-page__card fade-up" style="--item-delay: 60ms;">
				<h2>Consultas generales</h2>
				<p>
					Escribí a
					<a href={`mailto:${CONTACT_EMAIL}?subject=Cine%20Posta%20-%20Consulta%20general`}>{CONTACT_EMAIL}</a>.
				</p>
				<p>Este canal sirve para consultas generales, sugerencias y correcciones editoriales.</p>
			</article>

			<article class="about-page__card fade-up" style="--item-delay: 120ms;">
				<h2>Prensa y colaboraciones</h2>
				<p>
					Para prensa, invitaciones, notas o colaboraciones, escribí a
					<a href={`mailto:${PRESS_EMAIL}?subject=Cine%20Posta%20-%20Prensa`}>{PRESS_EMAIL}</a>.
				</p>
				<p>Si podés, usá el asunto <code>Cine Posta - Prensa</code> para ordenar mejor el contacto.</p>
			</article>

			<article class="about-page__card fade-up" style="--item-delay: 180ms;">
				<h2>Correcciones de datos</h2>
				<p>
					Si ves una fecha mal cargada, un elenco incompleto o una disponibilidad que quedó desactualizada, mandá el
					link de la ficha y el dato que debería revisarse.
				</p>
				<p>La disponibilidad de plataformas siempre se contrasta con servicios oficiales antes de marcarse como confirmada.</p>
			</article>

			<article class="about-page__card fade-up" style="--item-delay: 240ms;">
				<h2>Aclaración importante</h2>
				<p>
					{SITE_NAME} no hostea películas, no ofrece descargas, no comparte torrents y no entrega enlaces a streaming
					no autorizado.
				</p>
				<p>Las consultas relacionadas con acceso ilegal a contenido no tienen respuesta editorial ni soporte.</p>
			</article>
		</section>
	</main>
</BaseLayout>
