---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBrandLink from '../../components/HomeBrandLink.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { editorialAsset, formatEditorialDate, getEditorials, getEditorialPath, type Editorial } from '../../lib/editorial';
import { getMovies, getMoviePath } from '../../lib/movies';
export function getStaticPaths() { return getEditorials().map((entry) => ({ params: { slug: entry.slug }, props: { entry } })); }
interface Props { entry: Editorial; }
const { entry } = Astro.props;
const movie = entry.movieSlug ? getMovies().find((movie) => movie.slug === entry.movieSlug) : undefined;
const image = new URL(editorialAsset(entry.cover.src), Astro.site).href;
const structuredData = [{ '@context': 'https://schema.org', '@type': 'Article', headline: entry.title, description: entry.excerpt, datePublished: entry.date, author: { '@type': 'Organization', name: entry.author }, image, articleSection: entry.type, keywords: entry.tags.join(', '), timeRequired: `PT${entry.readingTime}M`, mainEntityOfPage: new URL(getEditorialPath(entry.slug), Astro.site).href }];
---
<BaseLayout title={`${entry.title} | CinePosta Editorial`} description={entry.excerpt} image={image} openGraphType="article" structuredData={structuredData}>
  <main id="main-content" class="container editorial-page">
    <nav class="page-actions" aria-label="Navegación editorial"><HomeBrandLink className="page-action page-action--home" /><a class="page-action" href={`${import.meta.env.BASE_URL}editorial/`}>Editorial CinePosta</a></nav>
    <article>
      <header><p class="kicker">{entry.type} · CinePosta</p><h1>{entry.title}</h1><p class="excerpt">{entry.excerpt}</p><p class="meta">Por {entry.author} · <time datetime={entry.date}>{formatEditorialDate(entry.date)}</time> · {entry.readingTime} min de lectura</p><p class="meta">{entry.spoilers ? 'Contiene spoilers' : 'Sin spoilers fuertes'}</p></header>
      <div class="editorial-body">{entry.content.map((block) => block.type === 'paragraph' ? <p>{block.text}</p> : <EditorialImage image={block} />)}</div>
      <footer><ul aria-label="Temas">{entry.tags.map((tag) => <li>{tag}</li>)}</ul>{movie && <aside class="movie-link"><span>La película en CinePosta</span><a href={getMoviePath(movie.slug)}>Ver ficha de {movie.title} →</a></aside>}<a class="back" href={`${import.meta.env.BASE_URL}editorial/`}>Volver a Editorial CinePosta →</a></footer>
    </article>
  </main>
</BaseLayout>
<style>
  .editorial-page { padding-block: 2rem 4rem; }
  article { max-width: 760px; margin: 2.5rem auto 0; }
  h1 { font-size: clamp(2rem, 5.2vw, 3.4rem); line-height: 1.12; letter-spacing: -.025em; text-wrap: balance; margin: 1rem 0 1.5rem; overflow-wrap: anywhere; }
  .kicker { color: var(--accent-soft); text-transform: uppercase; font: .8rem var(--font-mono); }
  .excerpt { font-size: 1.25rem; color: var(--muted); line-height: 1.6; }
  .meta { font-size: .85rem; color: var(--muted); }
  header { padding-bottom: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .editorial-body > p { font-size: clamp(1.0625rem, 2vw, 1.1875rem); line-height: 1.85; margin: 0 0 1.5rem; }
  footer { border-top: 1px solid var(--line); padding-top: 1.5rem; margin-top: 2rem; }
  ul { display: flex; gap: .6rem; flex-wrap: wrap; list-style: none; padding: 0; }
  li { padding: .3rem .7rem; background: var(--surface); border-radius: 6px; color: var(--muted); font-size: .8rem; }
  .movie-link { display: grid; gap: .7rem; padding: 1.5rem; margin-top: 2rem; background: var(--surface); border-left: 3px solid var(--accent); }
  .movie-link span { color: var(--muted); font-size: .85rem; }
  a { color: var(--accent-soft); }
  .back { display: inline-block; padding-block: 1rem; margin-top: 1rem; }
</style>
