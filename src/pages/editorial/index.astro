---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBrandLink from '../../components/HomeBrandLink.astro';
import EditorialCard from '../../components/EditorialCard.astro';
import { getEditorials } from '../../lib/editorial';
const entries = getEditorials();
---
<BaseLayout title="Editorial CinePosta | Historias y opiniones de cine" description="Editoriales, notas, especiales y opiniones de CinePosta. Cine para seguir conversando después de los créditos.">
  <main id="main-content" class="container editorial-index">
    <div class="page-actions"><HomeBrandLink className="page-action page-action--home" /></div>
    <header><p class="kicker">Desde CinePosta</p><h1>Editorial CinePosta</h1><p>Lo que nos queda dando vueltas después de los créditos.</p></header>
    <section aria-label="Publicaciones"><div class="section-heading"><h2 class="section-title">Todas las publicaciones</h2><p>De la más reciente a la más antigua</p></div><div class="grid">{entries.map((entry) => <EditorialCard entry={entry} />)}</div></section>
  </main>
</BaseLayout>
<style>
  .editorial-index { padding-block: 2rem 4rem; }
  header { max-width: 760px; margin-block: 2rem 3rem; }
  .kicker { color: var(--accent-soft); text-transform: uppercase; font: .8rem var(--font-mono); }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.15; margin-block: .8rem; }
  header > p:last-child { color: var(--muted); font-size: 1.2rem; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; border-bottom: 1px solid var(--line-strong); padding-bottom: 1rem; margin-bottom: 1.5rem; color: var(--muted); }
  .section-title { font-size: .875rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; margin: 0; }
  .section-heading p { margin: 0; font-size: .8rem; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 1.5rem; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
