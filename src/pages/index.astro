---
import BaseLayout from '../layouts/BaseLayout.astro';
import MovieCard from '../components/MovieCard.astro';
import { getMovies, RECOMMENDATION_GENRE_OPTIONS } from '../lib/movies';

const movies = getMovies();
const pageTitle = 'Cine Posta | Reseñas cortas sin humo';
const pageDescription =
	'Reseñas cortas de peliculas. Directo, honesto y al grano.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<header class="site-header container">
		<div class="site-header__line">
			<div class="site-header__brand-column">
				<a class="site-header__brand" href={import.meta.env.BASE_URL} aria-label="Ir al inicio">
					<img
						class="site-header__logo"
						src={`${import.meta.env.BASE_URL}brand/cineposta-logo-full.png`}
						alt="Cine Posta"
					/>
				</a>
				<div class="site-header__copy">
					<p class="site-header__tagline">Reseñas super cortas y honestas</p>
					<p class="site-header__rotating-copy" data-rotating-copy>
						Sin humo, sin metaforas raras, sin chamuyo.
					</p>
				</div>
			</div>
			<div class="site-header__support">
				<a
					class="site-header__donate"
					href="https://cafecito.app/cineposta"
					target="_blank"
					rel="noopener noreferrer"
				>
					Invitá un cafecito
				</a>
				<p class="site-header__donate-copy" data-donate-copy>No seas raton.</p>
			</div>
		</div>
	</header>

	<main class="container">
		{
			movies.length > 0 ? (
				<>
					<section class="movie-search" data-movie-search-root>
						<div class="home-genre-filter" data-home-genre-filter>
							<p class="home-genre-filter__label">Elegí género</p>
							<div class="home-genre-filter__chips" role="group" aria-label="Filtros por género">
								{
									RECOMMENDATION_GENRE_OPTIONS.map((genre) => (
										<button
											type="button"
											class="home-genre-filter__chip"
											data-home-genre-chip
											data-home-genre-id={genre.id}
											aria-pressed="false"
										>
											{genre.label}
										</button>
									))
								}
							</div>
						</div>
						<label for="movie-search-input" class="movie-search__label">BUSCAR PELÍCULA</label>
						<input
							id="movie-search-input"
							class="movie-search__input"
							type="search"
							placeholder="Titulo, año, plataforma o rating..."
							autocomplete="off"
							data-movie-search-input
						/>
						<div
							class="movie-search__status"
							data-movie-search-status
							role="status"
							aria-live="polite"
							aria-atomic="true"
							hidden
						>
							<span class="movie-search__status-spinner" aria-hidden="true"></span>
							<p class="movie-search__status-copy" data-movie-search-status-copy>
								Bancá que carga el videoclub...
							</p>
						</div>
						<p class="movie-search__summary" data-movie-search-summary>
							{movies.length} títulos publicados.
						</p>
						<p class="message-box movie-search__empty" data-movie-search-empty hidden>
							No encontramos peliculas con ese criterio.
						</p>
					</section>

					<section class="movie-grid" aria-label="Peliculas publicadas" data-movie-search-grid>
						{movies.map((movie, index) => <MovieCard movie={movie} index={index} />)}
					</section>
				</>
			) : (
				<p class="message-box">Todavia no hay peliculas cargadas. Agrega la primera entrada manual.</p>
			)
		}
	</main>
</BaseLayout>

<script>
	const searchRoot = document.querySelector('[data-movie-search-root]');
	if (searchRoot instanceof HTMLElement) {
		const homeBrandLink = document.querySelector('.site-header__brand');
		const input = searchRoot.querySelector('[data-movie-search-input]');
		const emptyState = searchRoot.querySelector('[data-movie-search-empty]');
		const statusBox = searchRoot.querySelector('[data-movie-search-status]');
		const statusCopy = searchRoot.querySelector('[data-movie-search-status-copy]');
		const summary = searchRoot.querySelector('[data-movie-search-summary]');
		const cards = Array.from(document.querySelectorAll('[data-movie-card]'));
		const genreChips = Array.from(searchRoot.querySelectorAll('[data-home-genre-chip]'));
		const homeStateKey = 'cineposta:home-list-state:v1';
		const catalogLoadingPhrases = [
			'Bancá que carga el videoclub...',
			'Estamos acomodando los posters.',
			'Le estamos soplando el polvo a la videoteca.',
			'Estamos prendiendo todas las pantallas.',
			'Un segundo, que el catálogo es grandote.',
		];
		const searchLoadingPhrases = [
			'Bancá, estamos buscando esa peli.',
			'Revolviendo el videoclub...',
			'Estamos filtrando títulos y posters.',
			'A ver si aparece entre tanto quilombo.',
			'No te vayas, ya salen los resultados.',
		];
		let activeGenre = null;

		if (input instanceof HTMLInputElement) {
			const movieIndex = cards.flatMap((card) => {
				if (!(card instanceof HTMLElement)) return [];
				const poster = card.querySelector('[data-movie-poster]');
				return [
					{
						element: card,
						searchable: card.dataset.movieSearch ?? '',
						genres: new Set(
							(card.dataset.movieGenres ?? '')
								.split(',')
								.map((value) => value.trim())
								.filter(Boolean),
						),
						poster: poster instanceof HTMLImageElement ? poster : null,
					},
				];
			});

			const normalize = (value) =>
				value
					.toLowerCase()
					.normalize('NFD')
					.replace(/[\u0300-\u036f]/g, '')
					.trim();
			let lastAppliedQuery = '';
			let lastAppliedGenre = '';
			let filterTimer = 0;
			let filterFrame = 0;
			let statusRotateTimer = 0;
			let statusHideTimer = 0;
			let statusToken = 0;
			let skipPersistOnPageHide = false;
			let activeStatusPhrases = [];
			let activeStatusIndex = 0;

			const getVisibleEntries = () => movieIndex.filter((entry) => !entry.element.hidden);

			const updateSummary = (visibleCount) => {
				if (!(summary instanceof HTMLElement)) return;
				const query = normalize(input.value);
				const hasQuery = query.length > 0;
				const hasGenre = Boolean(activeGenre);
				if (!hasQuery && !hasGenre) {
					summary.textContent = `${visibleCount} títulos publicados.`;
					return;
				}

				const parts = [];
				if (hasGenre) {
					parts.push('género activo');
				}
				if (hasQuery) {
					parts.push(`búsqueda "${input.value.trim()}"`);
				}

				summary.textContent = `${visibleCount} resultado${visibleCount === 1 ? '' : 's'} para ${parts.join(' + ')}.`;
			};

			const stopStatusRotation = () => {
				window.clearInterval(statusRotateTimer);
				statusRotateTimer = 0;
			};

			const hideStatus = () => {
				window.clearTimeout(statusHideTimer);
				stopStatusRotation();
				if (statusBox instanceof HTMLElement) {
					statusBox.hidden = true;
				}
			};

			const showStatus = (phrases) => {
				if (!(statusBox instanceof HTMLElement) || !(statusCopy instanceof HTMLElement)) return;
				const nextPhrases = Array.isArray(phrases) && phrases.length > 0 ? phrases : catalogLoadingPhrases;
				const signature = nextPhrases.join('|');
				if (signature !== activeStatusPhrases.join('|')) {
					activeStatusPhrases = nextPhrases.slice();
					activeStatusIndex = 0;
				}
				statusCopy.textContent = activeStatusPhrases[activeStatusIndex] ?? 'Bancá...';
				statusBox.hidden = false;
				window.clearTimeout(statusHideTimer);

				if (statusRotateTimer !== 0) return;
				statusRotateTimer = window.setInterval(() => {
					if (!(statusCopy instanceof HTMLElement) || activeStatusPhrases.length === 0) return;
					activeStatusIndex = (activeStatusIndex + 1) % activeStatusPhrases.length;
					statusCopy.textContent = activeStatusPhrases[activeStatusIndex];
				}, 1350);
			};

			const prioritizeVisiblePosters = (entries) => {
				entries.slice(0, 10).forEach((entry, index) => {
					if (!(entry.poster instanceof HTMLImageElement)) return;
					entry.poster.decoding = 'async';
					entry.poster.loading = index < 5 ? 'eager' : 'lazy';
					entry.poster.setAttribute('fetchpriority', index < 3 ? 'high' : 'auto');
				});
			};

			const syncStatusWithVisiblePosters = (mode, visibleCount) => {
				const visibleEntries = getVisibleEntries();
				const pendingImages = visibleEntries
					.slice(0, mode === 'catalog' ? 12 : 8)
					.map((entry) => entry.poster)
					.filter((poster) => poster instanceof HTMLImageElement);
				const imagesToWait = pendingImages.filter((poster) => !poster.complete);
				const nextToken = ++statusToken;

				updateSummary(typeof visibleCount === 'number' ? visibleCount : visibleEntries.length);
				prioritizeVisiblePosters(visibleEntries);

				if (imagesToWait.length === 0) {
					statusHideTimer = window.setTimeout(() => {
						if (nextToken === statusToken) {
							hideStatus();
						}
					}, 120);
					return;
				}

				showStatus(mode === 'catalog' ? catalogLoadingPhrases : searchLoadingPhrases);

				let remainingImages = imagesToWait.length;

				const finish = () => {
					if (nextToken !== statusToken) return;
					hideStatus();
				};

				const handlePosterSettled = () => {
					if (nextToken !== statusToken) return;
					remainingImages -= 1;
					if (remainingImages <= 0) {
						finish();
					}
				};

				for (const poster of imagesToWait) {
					poster.addEventListener('load', handlePosterSettled, { once: true });
					poster.addEventListener('error', handlePosterSettled, { once: true });
				}

				statusHideTimer = window.setTimeout(finish, mode === 'catalog' ? 3200 : 1800);
			};

			const persistHomeState = () => {
				try {
					const payload = {
						query: input.value,
						genre: activeGenre,
						scrollY: Math.max(0, Math.round(window.scrollY)),
						ts: Date.now(),
					};
					sessionStorage.setItem(homeStateKey, JSON.stringify(payload));
				} catch {
					// Ignore storage errors.
				}
			};

			const toggleGenre = (genreId) => {
				activeGenre = activeGenre === genreId ? null : genreId;
				return activeGenre;
			};

			const runFilter = (force = false) => {
				const query = normalize(input.value);
				const genreKey = activeGenre ?? '';
				if (!force && query === lastAppliedQuery && genreKey === lastAppliedGenre) {
					const visibleCount = getVisibleEntries().length;
					updateSummary(visibleCount);
					return visibleCount;
				}

				lastAppliedQuery = query;
				lastAppliedGenre = genreKey;
				let visibleCount = 0;

				for (const entry of movieIndex) {
					const genreMatch = !activeGenre || entry.genres.has(activeGenre);
					const queryMatch = query.length === 0 || entry.searchable.includes(query);
					const show = genreMatch && queryMatch;
					if (entry.element.hidden === show) {
						entry.element.hidden = !show;
					}
					if (show) visibleCount += 1;
				}

				if (emptyState instanceof HTMLElement) {
					emptyState.hidden = visibleCount > 0;
				}

				updateSummary(visibleCount);
				return visibleCount;
			};

			const resetCatalog = (mode = 'catalog') => {
				activeGenre = null;
				input.value = '';
				applyGenreUI();
				sessionStorage.removeItem(homeStateKey);
				const visibleCount = runFilter(true);
				syncStatusWithVisiblePosters(mode, visibleCount);
				return visibleCount;
			};

			const scheduleFilter = () => {
				showStatus(searchLoadingPhrases);
				window.clearTimeout(filterTimer);
				filterTimer = window.setTimeout(() => {
					window.cancelAnimationFrame(filterFrame);
					filterFrame = window.requestAnimationFrame(() => {
						const visibleCount = runFilter();
						persistHomeState();
						syncStatusWithVisiblePosters('search', visibleCount);
					});
				}, 120);
			};

			const restoreHomeState = () => {
				let parsed = null;
				try {
					const raw = sessionStorage.getItem(homeStateKey);
					if (raw) {
						parsed = JSON.parse(raw);
					}
				} catch {
					parsed = null;
				}

				if (!parsed || typeof parsed !== 'object') {
					const visibleCount = runFilter(true);
					syncStatusWithVisiblePosters('catalog', visibleCount);
					return;
				}

				const ageMs = Date.now() - Number(parsed.ts ?? 0);
				if (!Number.isFinite(ageMs) || ageMs > 1000 * 60 * 30) {
					sessionStorage.removeItem(homeStateKey);
					const visibleCount = runFilter(true);
					syncStatusWithVisiblePosters('catalog', visibleCount);
					return;
				}

				if (typeof parsed.query === 'string') {
					input.value = parsed.query;
				}
				if (typeof parsed.genre === 'string' && parsed.genre.length > 0) {
					activeGenre = parsed.genre;
					applyGenreUI();
				}

				lastAppliedQuery = '';
				lastAppliedGenre = '';
				const mode =
					((typeof parsed.query === 'string' && parsed.query.trim().length > 0) ||
						Boolean(activeGenre))
					? 'search'
					: 'catalog';
				const visibleCount = runFilter(true);
				syncStatusWithVisiblePosters(mode, visibleCount);

				const savedScrollY = Number(parsed.scrollY);
				if (Number.isFinite(savedScrollY) && savedScrollY > 0) {
					window.requestAnimationFrame(() => {
						window.scrollTo(0, savedScrollY);
					});
				}

				sessionStorage.removeItem(homeStateKey);
			};

			const cardLinks = movieIndex
				.map((entry) => entry.element.querySelector('a'))
				.filter((link) => link instanceof HTMLAnchorElement);

			for (const link of cardLinks) {
				link.addEventListener('click', persistHomeState, { passive: true });
			}

			const applyGenreUI = () => {
				for (const chip of genreChips) {
					if (!(chip instanceof HTMLButtonElement)) continue;
					const chipGenre = chip.dataset.homeGenreId;
					const isActive = Boolean(chipGenre && chipGenre === activeGenre);
					chip.classList.toggle('is-active', isActive);
					chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
				}
			};

			for (const chip of genreChips) {
				if (!(chip instanceof HTMLButtonElement)) continue;
				chip.addEventListener('click', () => {
					const nextGenre = chip.dataset.homeGenreId ?? null;
					const isResetInteraction = activeGenre === nextGenre;
					toggleGenre(nextGenre);
					if (isResetInteraction) {
						input.value = '';
					}
					applyGenreUI();
					showStatus(searchLoadingPhrases);
					const visibleCount = runFilter(true);
					syncStatusWithVisiblePosters('search', visibleCount);
					persistHomeState();
				});
			}

			applyGenreUI();
			input.addEventListener('input', () => {
				scheduleFilter();
			});
			if (homeBrandLink instanceof HTMLAnchorElement) {
				homeBrandLink.addEventListener('click', (event) => {
					event.preventDefault();
					skipPersistOnPageHide = true;
					showStatus(catalogLoadingPhrases);
					resetCatalog('catalog');
					window.requestAnimationFrame(() => {
						window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
					});
				});
			}
			window.addEventListener('pagehide', () => {
				if (skipPersistOnPageHide) {
					skipPersistOnPageHide = false;
					return;
				}
				persistHomeState();
			});
			showStatus(catalogLoadingPhrases);
			restoreHomeState();
		}
	}
</script>

