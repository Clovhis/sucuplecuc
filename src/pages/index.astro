---
import BaseLayout from '../layouts/BaseLayout.astro';
import CinemaReleaseCarousel from '../components/CinemaReleaseCarousel.astro';
import CinemaNewsTicker from '../components/CinemaNewsTicker.astro';
import MovieCard from '../components/MovieCard.astro';
import PostometroTeaser from '../components/PostometroTeaser.astro';
import PlatformBadge from '../components/PlatformBadge.astro';
import { getCinemaNews } from '../lib/cinemaNews';
import { getEditorialRankings } from '../lib/editorialRankings';
import {
	getLatestReviewMovies,
	getHomeMovieShowcase,
	getMovies,
	getPosterUrl,
	getCurrentTheatricalMovieReleases,
	getCurrentStreamingMovieReleases,
	getSubgenreFilterOptions,
	getUpcomingMovieReleases,
	RECOMMENDATION_GENRE_OPTIONS,
} from '../lib/movies';
import { getPersonSearchEntries } from '../lib/people';
import { getPlatformFilterOptions } from '../lib/platforms';
import { ABOUT_PATH, COMMUNITY_PATH, CONTACT_PATH, PEOPLE_PATH, SITE_DESCRIPTION, SITE_NAME, createHomeStructuredData } from '../lib/seo';

const cinemaNews = await getCinemaNews();
const movies = getMovies();
const featuredPeople = getPersonSearchEntries();
const platformOptions = getPlatformFilterOptions(movies);
const subgenreOptions = getSubgenreFilterOptions(movies);
const editorialGenreFilterIds = new Set(['superheroes', 'oscar-mejor-pelicula', 'pelicula-nacional']);
const primaryGenreOptions = RECOMMENDATION_GENRE_OPTIONS.filter(
	(option) => !editorialGenreFilterIds.has(option.id),
);
const editorialFilterOptions = RECOMMENDATION_GENRE_OPTIONS.filter((option) =>
	editorialGenreFilterIds.has(option.id),
);
const upcomingReleases = getUpcomingMovieReleases(new Date(), 5);
const currentTheatricalReleases = getCurrentTheatricalMovieReleases(new Date(), 12)
	.map((release) => ({
		...release,
		embedUrl: getYoutubeAutoplayEmbedUrlFromVideoUrl(release.videoUrl, false),
		watchUrl: release.videoUrl,
	}))
	.filter((release) => release.embedUrl);
const currentStreamingReleases = getCurrentStreamingMovieReleases(new Date(), 12)
	.map((release) => ({
		...release,
		embedUrl: getYoutubeAutoplayEmbedUrlFromVideoUrl(release.videoUrl, false),
		watchUrl: release.videoUrl,
	}))
	.filter((release) => release.embedUrl);
const editorialRankings = getEditorialRankings(movies);
const editorialRankingPools = editorialRankings.map((ranking) => ({
	id: ranking.id,
	movies: ranking.candidateMovies,
}));
const INITIAL_HOME_MOVIE_COUNT = 12;
const HOME_RECENT_LOAD_SLOTS = 4;
const initialHomeMovies = getHomeMovieShowcase(movies, INITIAL_HOME_MOVIE_COUNT, HOME_RECENT_LOAD_SLOTS);
const initialHomeMovieSlugs = new Set(initialHomeMovies.map((movie) => movie.slug));
const deferredHomeMovies = movies.filter((movie) => !initialHomeMovieSlugs.has(movie.slug));
const latestReviewCards = getLatestReviewMovies(movies, 3).map((movie) => ({
	slug: movie.slug,
	title: movie.title,
	publishedAt: movie.reviewPublishedAt ?? movie.releaseDate,
	year: movie.year,
	posterUrl: getPosterUrl(movie.poster),
	url: `${import.meta.env.BASE_URL}peliculas/${movie.slug}/`,
}));
const movieCountLabel = new Intl.NumberFormat('es-AR').format(movies.length);
const personCountLabel = new Intl.NumberFormat('es-AR').format(featuredPeople.length);
const pageTitle = 'Cine Posta (Cineposta) | Reseñas cortas y sin chamuyo de películas';
const pageDescription = SITE_DESCRIPTION;
const structuredData = createHomeStructuredData(movies, pageTitle, pageDescription);
const siteBrandLogo = `${import.meta.env.BASE_URL}brand/cineposta-logo-full.png`;
const welcomeCharacters = `${import.meta.env.BASE_URL}images/home/cineposta-bienvenida-personajes.png`;
const actorCareerGameArt = `${import.meta.env.BASE_URL}images/home/cineposta-simulador-carrera-actor.png`;
const actorCareerGamePath = `${import.meta.env.BASE_URL}juegos/simulador-carrera-actor/`;
const UPCOMING_SUGGESTION_TITLE_MAX_CHARS = 40;
const UPCOMING_SUGGESTION_SYNOPSIS_MAX_CHARS = 170;

function formatUpcomingReleaseDate(value: string) {
	const releaseDate = new Date(`${value}T00:00:00Z`);
	if (Number.isNaN(releaseDate.getTime())) {
		return value;
	}

	return new Intl.DateTimeFormat('es-AR', {
		day: 'numeric',
		month: 'short',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(releaseDate);
}

function getYoutubeAutoplayEmbedUrlFromVideoUrl(videoUrl: string, autoplay = true) {
	const parsedUrl = new URL(videoUrl);
	const videoId = parsedUrl.hostname.includes('youtu.be')
		? parsedUrl.pathname.replace(/^\/+/, '')
		: parsedUrl.searchParams.get('v');

	if (!videoId) {
		return '';
	}

	const params = new URLSearchParams({
		playsinline: '1',
		rel: '0',
		modestbranding: '1',
	});
	if (autoplay) {
		params.set('autoplay', '1');
		params.set('mute', '1');
	}

	return `https://www.youtube.com/embed/${videoId}?${params.toString()}`;
}

function truncateText(value: string, maxChars: number) {
	if (value.length <= maxChars) {
		return value;
	}

	const trimmed = value.slice(0, maxChars + 1).trim();
	const lastSpaceIndex = trimmed.lastIndexOf(' ');
	const safeText = lastSpaceIndex > Math.floor(maxChars * 0.6) ? trimmed.slice(0, lastSpaceIndex) : trimmed.slice(0, maxChars);

	return `${safeText.trimEnd()}…`;
}

const upcomingMovieSuggestions = upcomingReleases
	.map((release) => {
		const synopsis =
			release.synopsis ??
			`Estreno programado para el ${formatUpcomingReleaseDate(release.releaseDate)}.`;

		return {
			...release,
			watchUrl: release.videoUrl,
		embedUrl: getYoutubeAutoplayEmbedUrlFromVideoUrl(release.videoUrl),
			sourceUrl: release.sourceUrl ?? release.videoUrl,
			synopsis,
			displayTitle: truncateText(release.title, UPCOMING_SUGGESTION_TITLE_MAX_CHARS),
			displaySynopsis: truncateText(synopsis, UPCOMING_SUGGESTION_SYNOPSIS_MAX_CHARS),
		};
	})
	.filter((release) => release.embedUrl);
const upcomingMovieSuggestion = upcomingMovieSuggestions[0] ?? null;
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<header class="site-header container">
		<h1 class="u-visually-hidden">{SITE_NAME}: reseñas súper cortas y sin chamuyo de películas</h1>
		{
			movies.length > 0 && (
				<section
					class="site-search-bar fade-up"
					style="--item-delay: 0ms;"
					data-movie-search-root
					aria-label="Buscar en el catálogo"
				>
					<a class="site-header__brand" href="/" aria-label="Cine Posta: reiniciar filtros y volver al inicio">
						<img
							class="site-header__brand-logo"
							src={siteBrandLogo}
							alt="Cine Posta"
							width="520"
							height="168"
							decoding="async"
						/>
					</a>
					<section class="movie-search movie-search--top">
						<label for="movie-search-input" class="movie-search__label u-visually-hidden">
							Buscar película
						</label>
						<div class="movie-search__input-wrap">
							<span class="movie-search__input-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" role="presentation">
									<circle cx="11" cy="11" r="6.5"></circle>
									<path d="M16 16l4 4"></path>
								</svg>
							</span>
							<input
								id="movie-search-input"
								class="movie-search__input"
								type="search"
								placeholder="Título, actor, director, año, plataforma o veredicto..."
								autocomplete="off"
								data-movie-search-input
							/>
							<button
								type="button"
								class="movie-search__clear"
								data-movie-search-clear
								aria-label="Borrar búsqueda"
								hidden
							>
								<span aria-hidden="true">×</span>
							</button>
							<div
								class="movie-search__dropdown"
								data-movie-search-dropdown
								aria-label="Sugerencias rápidas"
								hidden
							>
								<p class="movie-search__dropdown-copy" data-movie-search-dropdown-copy></p>
								<div class="movie-search__suggestions" data-movie-search-suggestions></div>
							</div>
						</div>
					</section>
					{
						featuredPeople.length > 0 && (
							<div hidden data-person-search-index aria-hidden="true">
								{
									featuredPeople.map((person) => (
										<a
											data-person-search-entry
											data-person-search={person.searchableText}
											data-person-title={person.title}
											data-person-url={person.url}
											data-person-poster-url={person.posterUrl}
											data-person-meta={person.meta}
											data-person-age={person.ageLabel}
											data-person-nationality={person.nationalityLabel}
											data-person-known-for={person.knownFor}
										>
											{person.title}
										</a>
									))
								}
							</div>
						)
					}
					<div class="site-header__actions">
						<a class="site-header__community" href={COMMUNITY_PATH}>Comunidad</a>
						<a class="site-header__contact" href={CONTACT_PATH}>
							Prensa / Contacto
						</a>
					</div>
					<p class="movie-search__summary u-visually-hidden" data-movie-search-summary>
						{movies.length} títulos publicados.
					</p>
				</section>
			)
		}
	</header>

	<main id="main-content" class="container home-catalog">
		<section class="home-welcome fade-up" style="--item-delay: 35ms;" aria-labelledby="home-welcome-title">
			<div class="home-welcome__content">
				<p class="home-welcome__eyebrow">¿Primera vez por acá?</p>
				<h2 id="home-welcome-title">¿Qué somos?</h2>
				<p class="home-welcome__copy">
					Somos un sitio argentino de reseñas cortas y sin chamuyo para decidir qué mirar. Entrás, chusmeás y te llevás una señal clara sin vueltas. <strong>No alojamos películas, torrents, descargas ni enlaces piratas:</strong> te orientamos hacia opciones oficiales.
				</p>
				<ul class="home-welcome__details" aria-label="Cómo usar Cine Posta">
					<li>
						<strong>Sin login</strong>
						<span>No hace falta crear usuario ni acordarte de una password.</span>
					</li>
					<li>
						<strong>Sin Ads</strong>
						<span>La experiencia va al grano, sin banners cortándote la búsqueda.</span>
					</li>
					<li>
						<strong>Filtros al final</strong>
						<span>Bajá hasta el catálogo y buscá por título, actor, género, plataforma o veredicto.</span>
					</li>
				</ul>
				<div class="home-welcome__actions">
					<a class="home-welcome__link" href="#catalogo-filtros">Ir al filtro de películas <span aria-hidden="true">↓</span></a>
					<a class="home-welcome__link home-welcome__link--secondary" href={ABOUT_PATH}>Conocé cómo funciona <span aria-hidden="true">→</span></a>
				</div>
			</div>
			<div class="home-welcome__art" aria-hidden="true">
				<img
					src={welcomeCharacters}
					alt=""
					width="1792"
					height="896"
					decoding="async"
				/>
			</div>
		</section>
		<section class="home-actor-game fade-up" style="--item-delay: 50ms;" aria-labelledby="home-actor-game-title" data-home-actor-game>
			<a class="home-actor-game__link" href={actorCareerGamePath}>
				<div class="home-actor-game__content">
					<p class="home-actor-game__eyebrow"><span aria-hidden="true">✦</span> Minijuego nuevo</p>
					<h2 id="home-actor-game-title">Construí tu carrera en el cine</h2>
					<p class="home-actor-game__copy">
						Elegí tu oficio y pasá de un rodaje croto a la alfombra roja.
					</p>
					<span class="home-actor-game__cta">Jugar al simulador <span aria-hidden="true">→</span></span>
				</div>
				<div class="home-actor-game__art" aria-hidden="true">
					<span class="home-actor-game__art-label">Del primer casting a los premios</span>
					<img
						src={actorCareerGameArt}
						alt=""
						width="1536"
						height="1024"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</a>
		</section>
		{
			movies.length > 0 ? (
				<>
					<section class="home-community-promo fade-up" style="--item-delay: 55ms;" aria-labelledby="home-community-promo-title">
						<div class="home-community-promo__content">
							<p class="home-community-promo__eyebrow">Comunidad</p>
							<h2 id="home-community-promo-title">Foro Cineposta</h2>
							<p data-community-home-banner>¿La viste? Vení a debatirla sin humo.</p>
						</div>
						<div class="home-community-promo__illustration" aria-hidden="true">
							<img src="/images/community/foro-cineposta-banner-trio-transparent.png" alt="" width="1910" height="823" loading="lazy" decoding="async" />
						</div>
						<a href={COMMUNITY_PATH}>Ir a la comunidad</a>
					</section>
					<section class="home-catalog__mobile-teaser fade-up" style="--item-delay: 80ms;" aria-label="Qué vemos hoy">
						<PostometroTeaser compact={true} />
					</section>

					<div class="home-catalog__desktop-extra">
						<section class="catalog-shell fade-up" style="--item-delay: 80ms;">
							<h2 class="u-visually-hidden">Filtros del catálogo y últimas reseñas</h2>
							<div class="catalog-shell__main">
								<div class="catalog-shell__filters">
									<PostometroTeaser />
									{
										featuredPeople.length > 0 && (
										<section class="home-people-showcase" aria-label="Base de datos de actrices y actores">
											<div class="home-people-showcase__header">
												<div class="home-people-showcase__heading">
													<p class="home-people-showcase__eyebrow">Base de datos</p>
													<h3 class="home-people-showcase__title">Actrices y actores del catálogo</h3>
												</div>
												<div class="home-people-showcase__intro" aria-label="Cobertura actual de la base">
													<ul class="home-people-showcase__stats">
														<li class="home-people-showcase__stat">
															<strong>{movieCountLabel}+</strong>
															<span>películas</span>
														</li>
														<li class="home-people-showcase__stat">
															<strong>{personCountLabel}+</strong>
															<span>personas</span>
														</li>
													</ul>
													<p class="home-people-showcase__description">
														Perfiles con bio, edad, origen y filmografía conectada para entrar rápido a
														cada ficha.
													</p>
												</div>
											</div>
											<div class="home-character home-character--peeking" aria-hidden="true">
												<img
													src="/images/home/cineposta-personaje-asoma.webp"
													alt=""
													width="360"
													height="194"
													loading="lazy"
													decoding="async"
												/>
											</div>
											<div class="home-people-showcase__grid" data-home-people-grid data-people-index-url={PEOPLE_PATH}></div>
										</section>
									)
								}
								</div>
								<aside class="catalog-shell__upcoming" aria-labelledby="latest-reviews-title">
									<h3 id="latest-reviews-title" class="catalog-shell__upcoming-title">
										Últimas reseñas
									</h3>
									{
										latestReviewCards.length > 0 ? (
											<ol class="upcoming-release-list">
												{
													latestReviewCards.map((movie) => (
														<li class="upcoming-release-list__item">
															<a
																class="upcoming-release-list__card"
																href={movie.url}
																aria-label={`Leer la reseña de ${movie.title}`}
																title={`Leer la reseña de ${movie.title}`}
															>
																<div class="upcoming-release-list__media">
																	<img
																		class="upcoming-release-list__image"
																		src={movie.posterUrl}
																		alt={`Poster de ${movie.title}`}
																		loading="lazy"
																		decoding="async"
																	/>
																	<span class="upcoming-release-list__play" aria-hidden="true">
																		Leer reseña
																	</span>
																</div>
																<div class="upcoming-release-list__content">
																	<p class="upcoming-release-list__title">{movie.title}</p>
																	<time
																		class="upcoming-release-list__date"
																		datetime={movie.publishedAt}
																	>
																		{movie.publishedAt
																			? formatUpcomingReleaseDate(movie.publishedAt)
																			: movie.year}
																	</time>
																</div>
															</a>
														</li>
													))
												}
											</ol>
										) : (
											<p class="catalog-shell__upcoming-empty">Estamos acomodando el catálogo.</p>
										)
									}
								</aside>
							</div>
						</section>
					</div>

					<div class="home-catalog__desktop-extra">
						<CinemaNewsTicker
							items={cinemaNews.items}
							sourceLabel={cinemaNews.sourceLabel}
							updatedLabel={cinemaNews.updatedLabel}
							isFallback={cinemaNews.isFallback}
						/>
					</div>

					<CinemaReleaseCarousel releases={currentTheatricalReleases} />
					<CinemaReleaseCarousel
						releases={currentStreamingReleases}
						sectionId="streaming-release-carousel"
						title="Streaming"
						availability="Películas para ver ahora mismo en casa"
						listLabel="Estrenos de streaming con trailer disponible"
						showPlatform={true}
					/>

					{
						editorialRankings.length > 0 && (
							<section class="editorial-rankings fade-up" style="--item-delay: 120ms;" aria-labelledby="editorial-rankings-title">
								<div class="editorial-rankings__header">
									<h2 id="editorial-rankings-title">Sugerencias rápidas</h2>
								</div>
								<div class="editorial-rankings__grid">
									{editorialRankings.map((ranking, rankingIndex) => (
										<article
											class={`editorial-rankings__card editorial-rankings__card--${ranking.id}`}
											style={`--ranking-order: ${rankingIndex};`}
										>
											<ol data-editorial-ranking-list={ranking.id}>
												{ranking.movies.map((entry) => (
													<li>
														<a href={entry.url}>
															<span class="editorial-rankings__movie">
																<span class="editorial-rankings__movie-title">{entry.title}</span>
																<small>{entry.year} · {entry.verdictLabel}</small>
																<span
																	class={`editorial-rankings__meter editorial-rankings__meter--${entry.meterKind}`}
																	aria-label={`${entry.meterLabel}: ${entry.meterScore}%`}
																>
																	<span class="editorial-rankings__meter-copy">
																		<span>{entry.meterLabel}</span>
																		<strong>{entry.meterScore}%</strong>
																	</span>
																	<span class="editorial-rankings__meter-track" aria-hidden="true">
																		<span
																			class="editorial-rankings__meter-fill"
																			style={`--editorial-meter-level: ${entry.meterScore}%;`}
																		></span>
																	</span>
																</span>
															</span>
														</a>
													</li>
												))}
											</ol>
										</article>
									))}
								</div>
								<script
									id="editorial-ranking-data"
									type="application/json"
									is:inline
									set:html={JSON.stringify(editorialRankingPools)}
								></script>
							</section>
						)
					}

					{
						upcomingMovieSuggestion && (
							<section
								class="weekly-suggestion fade-up"
								style="--item-delay: 135ms;"
								aria-labelledby="upcoming-suggestion-title"
								data-upcoming-suggestion-root
								data-upcoming-active-index="0"
							>
								<div class="weekly-suggestion__shell">
									<div class="weekly-suggestion__media">
										<div class="weekly-suggestion__player">
											<iframe
												class="weekly-suggestion__frame"
												src={upcomingMovieSuggestions[0].embedUrl}
												title={`Trailer oficial de ${upcomingMovieSuggestions[0].title}`}
												loading="eager"
												allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
												referrerpolicy="strict-origin-when-cross-origin"
												allowfullscreen
												data-upcoming-suggestion-frame
											></iframe>
										</div>
									</div>
									<div class="weekly-suggestion__content" aria-live="polite">
										<div class="weekly-suggestion__header">
											<div>
												<h2 id="upcoming-suggestion-title">Próximos estrenos</h2>
											</div>
										</div>
										<h3 data-upcoming-suggestion-name>{upcomingMovieSuggestions[0].displayTitle}</h3>
										<p class="weekly-suggestion__meta">
											<time
												datetime={upcomingMovieSuggestions[0].releaseDate}
												data-upcoming-suggestion-date
											>
												{formatUpcomingReleaseDate(upcomingMovieSuggestions[0].releaseDate)}
											</time>
											<span data-upcoming-suggestion-platform>Cine</span>
										</p>
										<p class="weekly-suggestion__synopsis" data-upcoming-suggestion-synopsis>
											{upcomingMovieSuggestions[0].displaySynopsis}
										</p>
										<ol class="weekly-suggestion__queue" aria-label="Agenda de próximos estrenos">
											{
												upcomingMovieSuggestions.map((release, index) => (
													<li
														class={`weekly-suggestion__queue-item${index === 0 ? ' weekly-suggestion__queue-item--active' : ''}`}
														data-upcoming-suggestion-queue-item
														data-upcoming-suggestion-queue-index={index}
														aria-current={index === 0 ? 'true' : undefined}
													>
														<span class="weekly-suggestion__queue-title">{release.title}</span>
														<time class="weekly-suggestion__queue-date" datetime={release.releaseDate}>
															{formatUpcomingReleaseDate(release.releaseDate)}
														</time>
													</li>
												))
											}
										</ol>
										<div class="weekly-suggestion__actions">
											{
												upcomingMovieSuggestions.length > 1 && (
													<div
														class="weekly-suggestion__nav"
														role="group"
														aria-label="Cambiar próximo estreno"
													>
														<button
															class="weekly-suggestion__next"
															type="button"
															aria-label="Pasar a otro estreno"
															data-upcoming-suggestion-next
														>
															<span>Otro estreno</span>
															<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
																<path d="M9 5l7 7-7 7"></path>
															</svg>
														</button>
														<span class="weekly-suggestion__count" data-upcoming-suggestion-count>
															1 de {upcomingMovieSuggestions.length}
														</span>
													</div>
												)
											}
										</div>
									</div>
								</div>
								<script
									id="upcoming-suggestion-data"
									type="application/json"
									is:inline
									set:html={JSON.stringify(upcomingMovieSuggestions)}
								></script>
							</section>
						)
					}

					<section id="catalogo-filtros" class="home-results-tools fade-up" style="--item-delay: 140ms;" aria-labelledby="home-results-tools-title">
						<div class="home-results-tools__header">
							<div>
								<h2 id="home-results-tools-title">Películas publicadas</h2>
							</div>
							<p class="home-results-tools__counter" aria-label={`${movieCountLabel} películas en el catálogo`}>
								<strong>{movieCountLabel}</strong>
								<span>películas en catálogo</span>
							</p>
						</div>
						<div class="home-results-tools__filters">
							<div class="home-results-tools__filter-column home-results-tools__filter-column--left">
								{
									platformOptions.length > 0 && (
										<section class="home-platform-filter" data-home-platform-filter>
											<p class="home-genre-filter__label">Dónde la querés ver</p>
											<div class="home-platform-filter__chips" role="group" aria-label="Filtros por plataforma">
												{
													platformOptions.map((platform) => (
														<button
															type="button"
															class="home-platform-filter__chip"
															data-home-platform-chip
															data-home-platform-id={platform.normalizedLabel}
															data-home-platform-label={platform.displayLabel}
															aria-label={`Filtrar por ${platform.displayLabel}`}
															aria-pressed="false"
															title={platform.displayLabel}
														>
															<PlatformBadge
																platform={platform.normalizedLabel}
																className="home-platform-filter__badge"
															/>
														</button>
													))
												}
											</div>
										</section>
									)
								}
								{
									editorialFilterOptions.length > 0 && (
										<section class="home-genre-filter home-genre-filter--editorial" data-home-editorial-filter>
											<p class="home-genre-filter__label">Otros filtros</p>
											<div class="home-genre-filter__chips" role="group" aria-label="Filtros editoriales">
												{
													editorialFilterOptions.map((genre) => (
														<button
															type="button"
															class="home-genre-filter__chip home-genre-filter__chip--editorial"
															data-home-genre-chip
															data-home-genre-id={genre.id}
															data-home-genre-kind="editorial"
															aria-pressed="false"
														>
															{genre.label}
														</button>
													))
												}
											</div>
										</section>
									)
								}
							</div>
							<div class="home-results-tools__filter-column home-results-tools__filter-column--right">
								<section class="home-genre-filter" data-home-genre-filter>
									<p class="home-genre-filter__label">Qué género pinta</p>
									<div class="home-genre-filter__chips" role="group" aria-label="Filtros por género">
										{
											primaryGenreOptions.map((genre) => (
												<button
													type="button"
													class="home-genre-filter__chip"
													data-home-genre-chip
													data-home-genre-id={genre.id}
													data-home-genre-kind="genre"
													aria-pressed="false"
												>
													{genre.label}
												</button>
											))
										}
									</div>
								</section>
								{
									subgenreOptions.length > 0 && (
										<section class="home-genre-filter home-genre-filter--subgenre" data-home-subgenre-filter>
											<div class="home-genre-filter__heading">
												<p class="home-genre-filter__label">Subgéneros</p>
												<p class="home-genre-filter__hint">Para afinar más la búsqueda</p>
											</div>
											<div class="home-genre-filter__chips" role="group" aria-label="Filtros por subgénero">
												{
													subgenreOptions.map((subgenre) => (
														<button
															type="button"
															class="home-genre-filter__chip home-genre-filter__chip--subgenre"
															data-home-subgenre-chip
															data-home-subgenre-id={subgenre.id}
															aria-pressed="false"
														>
															{subgenre.label}
														</button>
													))
												}
											</div>
										</section>
									)
								}
							</div>
						</div>
						<div class="home-results-tools__feedback">
							<div
								class="movie-search__status"
								data-movie-search-status
								role="status"
								aria-live="polite"
								aria-atomic="true"
								hidden
							>
								<span class="movie-search__status-spinner" aria-hidden="true"></span>
								<p class="movie-search__status-copy" data-movie-search-status-copy>
									Bancá, que estoy acomodando el videoclub...
								</p>
							</div>
							<p class="message-box movie-search__empty" data-movie-search-empty hidden>
								No apareció nada con ese combo. Probá aflojar algún filtro.
							</p>
						</div>
					</section>

					<section
						class="movie-grid"
						aria-label="Películas publicadas"
						data-movie-search-grid
						data-movie-initial-count={initialHomeMovies.length}
						data-movie-total-count={movies.length}
					>
						{initialHomeMovies.map((movie, index) => <MovieCard movie={movie} index={index} />)}
					</section>
					<div hidden data-movie-card-templates aria-hidden="true">
						{
							deferredHomeMovies.map((movie, index) => (
								<template data-movie-card-template>
									<MovieCard movie={movie} index={index + initialHomeMovies.length} />
								</template>
							))
						}
					</div>
				</>
			) : (
				<p class="message-box">Todavía no cargamos ninguna peli. Meté la primera ficha manual.</p>
			)
		}
	</main>
</BaseLayout>

<script src="../scripts/community-banner.ts"></script>

<!-- Astro 6: page interactivity lives in a typed local module instead of an inline exception block. -->
<script src="../scripts/editorial-rankings.ts"></script>
<script src="../scripts/upcoming-suggestions.ts"></script>
<script src="../scripts/home-catalog.ts"></script>

