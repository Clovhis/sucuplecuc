---
import BaseLayout from '../layouts/BaseLayout.astro';
import CinemaNewsTicker from '../components/CinemaNewsTicker.astro';
import MovieCard from '../components/MovieCard.astro';
import { getCinemaNews } from '../lib/cinemaNews';
import { getMovies, RECOMMENDATION_GENRE_OPTIONS } from '../lib/movies';
import { ABOUT_PATH, SITE_DESCRIPTION, SITE_NAME, createHomeStructuredData } from '../lib/seo';

const cinemaNews = await getCinemaNews();
const movies = getMovies();
const pageTitle = 'Cine Posta (Cineposta) | Reseñas cortas y honestas de películas';
const pageDescription = SITE_DESCRIPTION;
const structuredData = createHomeStructuredData(movies, pageTitle, pageDescription);
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<header class="site-header container">
		{
			movies.length > 0 && (
				<section
					class="site-search-bar fade-up"
					style="--item-delay: 0ms;"
					data-movie-search-root
					aria-label="Buscar en el catálogo"
				>
					<div class="site-search-bar__meta">
						<p class="site-search-bar__eyebrow">Buscar en el catálogo</p>
						<p class="site-search-bar__copy">
							Escribí un título, año, plataforma o rating y filtrá el videoclub al toque.
						</p>
						<p class="movie-search__summary" data-movie-search-summary>{movies.length} títulos publicados.</p>
					</div>
					<section class="movie-search movie-search--top">
						<label for="movie-search-input" class="movie-search__label u-visually-hidden">
							Buscar película
						</label>
						<div class="movie-search__input-wrap">
							<span class="movie-search__input-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" role="presentation">
									<circle cx="11" cy="11" r="6.5"></circle>
									<path d="M16 16l4 4"></path>
								</svg>
							</span>
							<input
								id="movie-search-input"
								class="movie-search__input"
								type="search"
								placeholder="Título, año, plataforma o rating..."
								autocomplete="off"
								data-movie-search-input
							/>
							<div
								class="movie-search__dropdown"
								data-movie-search-dropdown
								aria-label="Sugerencias rápidas"
								hidden
							>
								<p class="movie-search__dropdown-copy" data-movie-search-dropdown-copy></p>
								<div class="movie-search__suggestions" data-movie-search-suggestions></div>
							</div>
						</div>
					</section>
					<div class="site-search-bar__feedback">
						<div
							class="movie-search__status"
							data-movie-search-status
							role="status"
							aria-live="polite"
							aria-atomic="true"
							hidden
						>
							<span class="movie-search__status-spinner" aria-hidden="true"></span>
							<p class="movie-search__status-copy" data-movie-search-status-copy>
								Bancá que carga el videoclub...
							</p>
						</div>
						<p class="message-box movie-search__empty" data-movie-search-empty hidden>
							No encontramos peliculas con ese criterio.
						</p>
					</div>
				</section>
			)
		}
		<div class="site-header__line">
			<div class="site-header__brand-column">
				<a class="site-header__brand" href={import.meta.env.BASE_URL} aria-label="Ir al inicio">
					<img
						class="site-header__logo"
						src={`${import.meta.env.BASE_URL}brand/cineposta-logo-full.png`}
						alt="Cine Posta"
					/>
				</a>
				<div class="site-header__copy">
					<h1 class="site-header__tagline">{SITE_NAME}: reseñas super cortas y honestas de películas</h1>
					<p class="site-header__rotating-copy">También nos encontrás buscando Cineposta, todo junto.</p>
					<p class="site-header__rotating-copy" data-rotating-copy>
						Sin humo, sin metaforas raras, sin chamuyo.
					</p>
				</div>
			</div>
			<div class="site-header__support">
				<div class="site-header__support-card site-header__support-card--donate">
					<div class="site-header__actions">
						<a
							class="site-header__donate"
							href="https://cafecito.app/cineposta"
							target="_blank"
							rel="noopener noreferrer"
						>
							<img
								class="site-header__donate-logo"
								src={`${import.meta.env.BASE_URL}brand/cafecito-logo.svg`}
								alt=""
								aria-hidden="true"
							/>
							Invitá un cafecito
						</a>
					</div>
					<p class="site-header__donate-copy" data-donate-copy>Tu ayuda mantiene viva la data posta.</p>
				</div>
				<div class="site-header__support-card site-header__support-card--contact">
					<a
						class="site-header__contact-link"
						href="mailto:yosoyvargas@hotmail.com?subject=Cine%20Posta%20-%20Contacto%20y%20Prensa"
						aria-label="Enviar email de contacto o prensa"
					>
						Contacto / Prensa
					</a>
					<a class="site-header__contact-link" href={ABOUT_PATH} aria-label="Ir a la página Sobre Cine Posta">
						Sobre Cine Posta
					</a>
				</div>
			</div>
		</div>
	</header>

	<main id="main-content" class="container home-catalog">
		<CinemaNewsTicker
			items={cinemaNews.items}
			sourceLabel={cinemaNews.sourceLabel}
			updatedLabel={cinemaNews.updatedLabel}
			isFallback={cinemaNews.isFallback}
		/>

		{
			movies.length > 0 ? (
				<>
					<section class="catalog-shell fade-up" style="--item-delay: 80ms;">
						<div class="catalog-shell__intro">
							<p class="catalog-shell__kicker">Explorá el catálogo</p>
							<p class="catalog-shell__copy">
								Reseñas cortas y directas para elegir rápido qué ver.
							</p>
							<p class="catalog-shell__copy">
								Filtrá o buscá directo. Cada ficha te lleva a películas, actores y directores relacionados.
							</p>
						</div>
						<section class="catalog-shell__filters home-genre-filter" data-home-genre-filter>
							<p class="home-genre-filter__label">Elegí género</p>
							<div class="home-genre-filter__chips" role="group" aria-label="Filtros por género">
								{
									RECOMMENDATION_GENRE_OPTIONS.map((genre) => (
										<button
											type="button"
											class="home-genre-filter__chip"
											data-home-genre-chip
											data-home-genre-id={genre.id}
											aria-pressed="false"
										>
											{genre.label}
										</button>
									))
								}
							</div>
						</section>
					</section>

					<section class="movie-grid" aria-label="Peliculas publicadas" data-movie-search-grid>
						{movies.map((movie, index) => <MovieCard movie={movie} index={index} />)}
					</section>
				</>
			) : (
				<p class="message-box">Todavia no hay peliculas cargadas. Agrega la primera entrada manual.</p>
			)
		}
	</main>
</BaseLayout>

<script>
	const searchRoot = document.querySelector('[data-movie-search-root]');
	if (searchRoot instanceof HTMLElement) {
		const homeBrandLink = document.querySelector('.site-header__brand');
		const input = searchRoot.querySelector('[data-movie-search-input]');
		const emptyState = searchRoot.querySelector('[data-movie-search-empty]');
		const statusBox = searchRoot.querySelector('[data-movie-search-status]');
		const statusCopy = searchRoot.querySelector('[data-movie-search-status-copy]');
		const summary = searchRoot.querySelector('[data-movie-search-summary]');
		const suggestionsBox = searchRoot.querySelector('[data-movie-search-dropdown]');
		const suggestionsCopy = searchRoot.querySelector('[data-movie-search-dropdown-copy]');
		const suggestionsList = searchRoot.querySelector('[data-movie-search-suggestions]');
		const cards = Array.from(document.querySelectorAll('[data-movie-card]'));
		const genreChips = Array.from(document.querySelectorAll('[data-home-genre-chip]'));
		const homeStateKey = 'cineposta:home-list-state:v1';
		const catalogLoadingPhrases = [
			'Bancá que carga el videoclub...',
			'Estamos acomodando los posters.',
			'Le estamos soplando el polvo a la videoteca.',
			'Estamos prendiendo todas las pantallas.',
			'Un segundo, que el catálogo es grandote.',
		];
		const searchLoadingPhrases = [
			'Bancá, estamos buscando esa peli.',
			'Revolviendo el videoclub...',
			'Estamos filtrando títulos y posters.',
			'A ver si aparece entre tanto quilombo.',
			'No te vayas, ya salen los resultados.',
		];
		let activeGenre = null;

		if (input instanceof HTMLInputElement) {
			const movieIndex = cards.flatMap((card) => {
				if (!(card instanceof HTMLElement)) return [];
				const poster = card.querySelector('[data-movie-poster]');
				const link = card.querySelector('a');
				return [
					{
						element: card,
						searchable: card.dataset.movieSearch ?? '',
						title: card.dataset.movieTitle ?? '',
						year: card.dataset.movieYear ?? '',
						url:
							card.dataset.movieUrl ??
							(link instanceof HTMLAnchorElement ? link.href : ''),
						posterUrl:
							card.dataset.moviePosterUrl ??
							(poster instanceof HTMLImageElement ? poster.currentSrc || poster.src : ''),
						meta: card.dataset.movieMeta ?? '',
						cast: card.dataset.movieCast ?? '',
						genres: new Set(
							(card.dataset.movieGenres ?? '')
								.split(',')
								.map((value) => value.trim())
								.filter(Boolean),
						),
						poster: poster instanceof HTMLImageElement ? poster : null,
					},
				];
			});

			const normalize = (value) =>
				value
					.toLowerCase()
					.normalize('NFD')
					.replace(/[\u0300-\u036f]/g, '')
					.trim();
			let lastAppliedQuery = '';
			let lastAppliedGenre = '';
			let filterTimer = 0;
			let filterFrame = 0;
			let statusRotateTimer = 0;
			let statusHideTimer = 0;
			let statusToken = 0;
			let skipPersistOnPageHide = false;
			let activeStatusPhrases = [];
			let activeStatusIndex = 0;
			let activeSuggestionIndex = -1;
			let currentSuggestions = [];

			const getVisibleEntries = () => movieIndex.filter((entry) => !entry.element.hidden);

			const hideSuggestions = () => {
				activeSuggestionIndex = -1;
				currentSuggestions = [];
				if (suggestionsBox instanceof HTMLElement) {
					suggestionsBox.hidden = true;
				}
				if (suggestionsList instanceof HTMLElement) {
					suggestionsList.replaceChildren();
				}
			};

			const updateSuggestionHighlight = () => {
				if (!(suggestionsList instanceof HTMLElement)) return;
				const options = Array.from(suggestionsList.querySelectorAll('[data-movie-search-suggestion]'));
				for (const option of options) {
					if (!(option instanceof HTMLAnchorElement)) continue;
					const optionIndex = Number(option.dataset.suggestionIndex ?? '-1');
					const isActive = optionIndex === activeSuggestionIndex;
					option.classList.toggle('is-active', isActive);
				}
			};

			const getSuggestionScore = (entry, query) => {
				const normalizedTitle = normalize(entry.title);
				const normalizedMeta = normalize(`${entry.meta} ${entry.cast}`);
				let score = 300;

				if (normalizedTitle.startsWith(query)) score -= 180;
				else if (normalizedTitle.includes(query)) score -= 120;
				else if (entry.searchable.startsWith(query)) score -= 90;
				else if (entry.searchable.includes(query)) score -= 40;

				if (entry.year === query) score -= 35;
				if (normalizedMeta.includes(query)) score -= 20;

				return score;
			};

			const renderSuggestions = (query, matchingEntries) => {
				if (
					!(suggestionsBox instanceof HTMLElement) ||
					!(suggestionsList instanceof HTMLElement) ||
					!(suggestionsCopy instanceof HTMLElement)
				) {
					return;
				}

				if (query.length === 0 || matchingEntries.length === 0) {
					hideSuggestions();
					return;
				}

				const suggestions = matchingEntries
					.slice()
					.sort((left, right) => getSuggestionScore(left, query) - getSuggestionScore(right, query))
					.slice(0, 6);

				currentSuggestions = suggestions;
				activeSuggestionIndex = -1;
				suggestionsCopy.textContent = `${matchingEntries.length} coincidencia${
					matchingEntries.length === 1 ? '' : 's'
				} rápida${matchingEntries.length === 1 ? '' : 's'}.`;

				const suggestionNodes = suggestions.map((entry, index) => {
					const link = document.createElement('a');
					link.className = 'movie-search__suggestion';
					link.href = entry.url;
					link.dataset.movieSearchSuggestion = 'true';
					link.dataset.suggestionIndex = String(index);

					const poster = document.createElement('img');
					poster.className = 'movie-search__suggestion-poster';
					poster.src = entry.posterUrl;
					poster.alt = '';
					poster.loading = 'lazy';
					poster.decoding = 'async';

					const body = document.createElement('span');
					body.className = 'movie-search__suggestion-body';

					const title = document.createElement('span');
					title.className = 'movie-search__suggestion-title';
					title.textContent = entry.title;

					const meta = document.createElement('span');
					meta.className = 'movie-search__suggestion-meta';
					meta.textContent = entry.meta;

					body.append(title, meta);

					if (entry.cast) {
						const cast = document.createElement('span');
						cast.className = 'movie-search__suggestion-cast';
						cast.textContent = entry.cast;
						body.append(cast);
					}

					link.append(poster, body);
					return link;
				});

				suggestionsList.replaceChildren(...suggestionNodes);
				suggestionsBox.hidden = false;
			};

			const updateSummary = (visibleCount) => {
				if (!(summary instanceof HTMLElement)) return;
				const query = normalize(input.value);
				const hasQuery = query.length > 0;
				const hasGenre = Boolean(activeGenre);
				if (!hasQuery && !hasGenre) {
					summary.textContent = `${visibleCount} títulos publicados.`;
					return;
				}

				const parts = [];
				if (hasGenre) {
					parts.push('género activo');
				}
				if (hasQuery) {
					parts.push(`búsqueda "${input.value.trim()}"`);
				}

				summary.textContent = `${visibleCount} resultado${visibleCount === 1 ? '' : 's'} para ${parts.join(' + ')}.`;
			};

			const stopStatusRotation = () => {
				window.clearInterval(statusRotateTimer);
				statusRotateTimer = 0;
			};

			const hideStatus = () => {
				window.clearTimeout(statusHideTimer);
				stopStatusRotation();
				if (statusBox instanceof HTMLElement) {
					statusBox.hidden = true;
				}
			};

			const showStatus = (phrases) => {
				if (!(statusBox instanceof HTMLElement) || !(statusCopy instanceof HTMLElement)) return;
				const nextPhrases = Array.isArray(phrases) && phrases.length > 0 ? phrases : catalogLoadingPhrases;
				const signature = nextPhrases.join('|');
				if (signature !== activeStatusPhrases.join('|')) {
					activeStatusPhrases = nextPhrases.slice();
					activeStatusIndex = 0;
				}
				statusCopy.textContent = activeStatusPhrases[activeStatusIndex] ?? 'Bancá...';
				statusBox.hidden = false;
				window.clearTimeout(statusHideTimer);

				if (statusRotateTimer !== 0) return;
				statusRotateTimer = window.setInterval(() => {
					if (!(statusCopy instanceof HTMLElement) || activeStatusPhrases.length === 0) return;
					activeStatusIndex = (activeStatusIndex + 1) % activeStatusPhrases.length;
					statusCopy.textContent = activeStatusPhrases[activeStatusIndex];
				}, 1350);
			};

			const prioritizeVisiblePosters = (entries) => {
				entries.slice(0, 10).forEach((entry, index) => {
					if (!(entry.poster instanceof HTMLImageElement)) return;
					entry.poster.decoding = 'async';
					entry.poster.loading = index < 5 ? 'eager' : 'lazy';
					entry.poster.setAttribute('fetchpriority', index < 3 ? 'high' : 'auto');
				});
			};

			const syncStatusWithVisiblePosters = (mode, visibleCount) => {
				const visibleEntries = getVisibleEntries();
				const pendingImages = visibleEntries
					.slice(0, mode === 'catalog' ? 12 : 8)
					.map((entry) => entry.poster)
					.filter((poster) => poster instanceof HTMLImageElement);
				const imagesToWait = pendingImages.filter((poster) => !poster.complete);
				const nextToken = ++statusToken;

				updateSummary(typeof visibleCount === 'number' ? visibleCount : visibleEntries.length);
				prioritizeVisiblePosters(visibleEntries);

				if (imagesToWait.length === 0) {
					statusHideTimer = window.setTimeout(() => {
						if (nextToken === statusToken) {
							hideStatus();
						}
					}, 120);
					return;
				}

				showStatus(mode === 'catalog' ? catalogLoadingPhrases : searchLoadingPhrases);

				let remainingImages = imagesToWait.length;

				const finish = () => {
					if (nextToken !== statusToken) return;
					hideStatus();
				};

				const handlePosterSettled = () => {
					if (nextToken !== statusToken) return;
					remainingImages -= 1;
					if (remainingImages <= 0) {
						finish();
					}
				};

				for (const poster of imagesToWait) {
					poster.addEventListener('load', handlePosterSettled, { once: true });
					poster.addEventListener('error', handlePosterSettled, { once: true });
				}

				statusHideTimer = window.setTimeout(finish, mode === 'catalog' ? 3200 : 1800);
			};

			const persistHomeState = () => {
				try {
					const payload = {
						query: input.value,
						genre: activeGenre,
						scrollY: Math.max(0, Math.round(window.scrollY)),
						ts: Date.now(),
					};
					sessionStorage.setItem(homeStateKey, JSON.stringify(payload));
				} catch {
					// Ignore storage errors.
				}
			};

			const toggleGenre = (genreId) => {
				activeGenre = activeGenre === genreId ? null : genreId;
				return activeGenre;
			};

			const runFilter = (force = false) => {
				const query = normalize(input.value);
				const genreKey = activeGenre ?? '';
				if (!force && query === lastAppliedQuery && genreKey === lastAppliedGenre) {
					const visibleCount = getVisibleEntries().length;
					renderSuggestions(query, getVisibleEntries());
					updateSummary(visibleCount);
					return visibleCount;
				}

				lastAppliedQuery = query;
				lastAppliedGenre = genreKey;
				let visibleCount = 0;
				const matchingEntries = [];

				for (const entry of movieIndex) {
					const genreMatch = !activeGenre || entry.genres.has(activeGenre);
					const queryMatch = query.length === 0 || entry.searchable.includes(query);
					const show = genreMatch && queryMatch;
					if (entry.element.hidden === show) {
						entry.element.hidden = !show;
					}
					if (show) {
						visibleCount += 1;
						matchingEntries.push(entry);
					}
				}

				if (emptyState instanceof HTMLElement) {
					emptyState.hidden = visibleCount > 0;
				}

				renderSuggestions(query, matchingEntries);
				updateSummary(visibleCount);
				return visibleCount;
			};

			const resetCatalog = (mode = 'catalog') => {
				activeGenre = null;
				input.value = '';
				hideSuggestions();
				applyGenreUI();
				sessionStorage.removeItem(homeStateKey);
				const visibleCount = runFilter(true);
				syncStatusWithVisiblePosters(mode, visibleCount);
				return visibleCount;
			};

			const scheduleFilter = () => {
				showStatus(searchLoadingPhrases);
				window.clearTimeout(filterTimer);
				filterTimer = window.setTimeout(() => {
					window.cancelAnimationFrame(filterFrame);
					filterFrame = window.requestAnimationFrame(() => {
						const visibleCount = runFilter();
						persistHomeState();
						syncStatusWithVisiblePosters('search', visibleCount);
					});
				}, 120);
			};

			const restoreHomeState = () => {
				let parsed = null;
				try {
					const raw = sessionStorage.getItem(homeStateKey);
					if (raw) {
						parsed = JSON.parse(raw);
					}
				} catch {
					parsed = null;
				}

				if (!parsed || typeof parsed !== 'object') {
					const visibleCount = runFilter(true);
					syncStatusWithVisiblePosters('catalog', visibleCount);
					return;
				}

				const ageMs = Date.now() - Number(parsed.ts ?? 0);
				if (!Number.isFinite(ageMs) || ageMs > 1000 * 60 * 30) {
					sessionStorage.removeItem(homeStateKey);
					const visibleCount = runFilter(true);
					syncStatusWithVisiblePosters('catalog', visibleCount);
					return;
				}

				if (typeof parsed.query === 'string') {
					input.value = parsed.query;
				}
				if (typeof parsed.genre === 'string' && parsed.genre.length > 0) {
					activeGenre = parsed.genre;
					applyGenreUI();
				}

				lastAppliedQuery = '';
				lastAppliedGenre = '';
				const mode =
					((typeof parsed.query === 'string' && parsed.query.trim().length > 0) ||
						Boolean(activeGenre))
					? 'search'
					: 'catalog';
				const visibleCount = runFilter(true);
				syncStatusWithVisiblePosters(mode, visibleCount);

				const savedScrollY = Number(parsed.scrollY);
				if (Number.isFinite(savedScrollY) && savedScrollY > 0) {
					window.requestAnimationFrame(() => {
						window.scrollTo(0, savedScrollY);
					});
				}

				sessionStorage.removeItem(homeStateKey);
			};

			const cardLinks = movieIndex
				.map((entry) => entry.element.querySelector('a'))
				.filter((link) => link instanceof HTMLAnchorElement);

			for (const link of cardLinks) {
				link.addEventListener('click', persistHomeState, { passive: true });
			}

			const applyGenreUI = () => {
				for (const chip of genreChips) {
					if (!(chip instanceof HTMLButtonElement)) continue;
					const chipGenre = chip.dataset.homeGenreId;
					const isActive = Boolean(chipGenre && chipGenre === activeGenre);
					chip.classList.toggle('is-active', isActive);
					chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
				}
			};

			for (const chip of genreChips) {
				if (!(chip instanceof HTMLButtonElement)) continue;
				chip.addEventListener('click', () => {
					const nextGenre = chip.dataset.homeGenreId ?? null;
					const isResetInteraction = activeGenre === nextGenre;
					toggleGenre(nextGenre);
					if (isResetInteraction) {
						input.value = '';
					}
					applyGenreUI();
					showStatus(searchLoadingPhrases);
					const visibleCount = runFilter(true);
					syncStatusWithVisiblePosters('search', visibleCount);
					persistHomeState();
				});
			}

			applyGenreUI();
			input.addEventListener('input', () => {
				scheduleFilter();
			});
			input.addEventListener('focus', () => {
				if (input.value.trim().length > 0 && currentSuggestions.length > 0 && suggestionsBox instanceof HTMLElement) {
					suggestionsBox.hidden = false;
				}
			});
			input.addEventListener('keydown', (event) => {
				if (currentSuggestions.length === 0) {
					if (event.key === 'Escape') {
						hideSuggestions();
					}
					return;
				}

				if (event.key === 'ArrowDown') {
					event.preventDefault();
					activeSuggestionIndex = Math.min(activeSuggestionIndex + 1, currentSuggestions.length - 1);
					updateSuggestionHighlight();
					return;
				}

				if (event.key === 'ArrowUp') {
					event.preventDefault();
					activeSuggestionIndex = Math.max(activeSuggestionIndex - 1, 0);
					updateSuggestionHighlight();
					return;
				}

				if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
					event.preventDefault();
					persistHomeState();
					window.location.href = currentSuggestions[activeSuggestionIndex].url;
					return;
				}

				if (event.key === 'Escape') {
					hideSuggestions();
				}
			});
			if (suggestionsList instanceof HTMLElement) {
				suggestionsList.addEventListener('mousemove', (event) => {
					const suggestion = event.target instanceof Element
						? event.target.closest('[data-movie-search-suggestion]')
						: null;
					if (!(suggestion instanceof HTMLAnchorElement)) return;
					activeSuggestionIndex = Number(suggestion.dataset.suggestionIndex ?? '-1');
					updateSuggestionHighlight();
				});
				suggestionsList.addEventListener('click', (event) => {
					const suggestion = event.target instanceof Element
						? event.target.closest('[data-movie-search-suggestion]')
						: null;
					if (!(suggestion instanceof HTMLAnchorElement)) return;
					persistHomeState();
				});
			}
			document.addEventListener('pointerdown', (event) => {
				if (!(event.target instanceof Node) || searchRoot.contains(event.target)) return;
				hideSuggestions();
			});
			if (homeBrandLink instanceof HTMLAnchorElement) {
				homeBrandLink.addEventListener('click', (event) => {
					event.preventDefault();
					skipPersistOnPageHide = true;
					showStatus(catalogLoadingPhrases);
					resetCatalog('catalog');
					window.requestAnimationFrame(() => {
						window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
					});
				});
			}
			window.addEventListener('pagehide', () => {
				if (skipPersistOnPageHide) {
					skipPersistOnPageHide = false;
					return;
				}
				persistHomeState();
			});
			showStatus(catalogLoadingPhrases);
			restoreHomeState();
		}
	}
</script>

