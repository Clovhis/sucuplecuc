---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getMovieEditorialSummary,
	getMovies,
	getMoviePlatformLabel,
	getMoviePlatforms,
	getPosterUrl,
	getVerdictBadgeClass,
	getVerdictLabel,
} from '../../lib/movies';
import { getMoviePeopleGroups } from '../../lib/people';
import MovieRating from '../../components/MovieRating.astro';
import AwardMark from '../../components/AwardMark.astro';
import PlatformBadgeGroup from '../../components/PlatformBadgeGroup.astro';
import { getAwardVisualKey } from '../../lib/awards';
import { createMovieStructuredData } from '../../lib/seo';
import type { Movie } from '../../types/movie';

export function getStaticPaths() {
	const movies = getMovies();
	return movies.map((movie) => ({
		params: { slug: movie.slug },
		props: { movie },
	}));
}

const { movie } = Astro.props as { movie: Movie };
const allMovies = getMovies();
const pageTitle = `${movie.title} (${movie.year}) | Cine Posta`;
const pageDescription = movie.synopsis;
const posterUrl = getPosterUrl(movie.poster);
const verdictClass = getVerdictBadgeClass(movie);
const editorialSummary = getMovieEditorialSummary(movie, allMovies);
const peopleGroups = getMoviePeopleGroups(movie);
const moviePlatforms = getMoviePlatforms(movie);
const moviePlatformLabel = getMoviePlatformLabel(movie);
const currentDate = new Date();
type PersonDateParts = {
	year: number;
	month?: number;
	day?: number;
	precision: 1 | 2 | 3;
};

const currentDateParts = {
	year: currentDate.getUTCFullYear(),
	month: currentDate.getUTCMonth() + 1,
	day: currentDate.getUTCDate(),
	precision: 3,
} satisfies PersonDateParts;
const personDateFormatter = new Intl.DateTimeFormat('es-AR', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});
const personMonthFormatter = new Intl.DateTimeFormat('es-AR', {
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});
const normalizedCategory = String(movie.category || '')
	.normalize('NFD')
	.replace(/[\u0300-\u036f]/g, '')
	.toLowerCase()
	.trim();
const isAnimatedTitle = normalizedCategory === 'anime' || normalizedCategory === 'animacion';
const castSectionTitle = isAnimatedTitle ? 'Voces originales' : 'Elenco';
const screenshotUrls = (movie.screenshots ?? [])
	.filter((value) => typeof value === 'string' && value.trim().length > 0)
	.slice(0, 2)
	.map((value) => getPosterUrl(value));
const hasScreenshotGallery = screenshotUrls.length >= 2;
const trailerEmbedUrl = movie.trailerYoutubeId
	? `https://www.youtube.com/embed/${movie.trailerYoutubeId}`
	: '';
const trailerWatchUrl = movie.trailerYoutubeId
	? `https://www.youtube.com/watch?v=${movie.trailerYoutubeId}`
	: '';
const awardMeta = {
	oscar: { label: 'Oscar' },
	grammy: { label: 'Grammy' },
	cannes: { label: 'Cannes' },
} as const;

const groupedAwards = (['oscar', 'grammy', 'cannes'] as const)
	.map((awardType) => {
		const wins = (movie.awards?.wins ?? []).filter((win) => win.award === awardType);
		return {
			awardType,
			wins,
			count: wins.length,
			label: awardMeta[awardType].label,
		};
	})
	.filter((group) => group.count > 0);

const awardCategories = groupedAwards.flatMap((group) =>
	group.wins.map((win) => ({
		awardType: group.awardType,
		label: group.label,
		category: win.category,
		recipient: win.recipient,
		isBestPicture:
			group.awardType === 'oscar' &&
			win.category
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toLowerCase()
				.trim() === 'mejor pelicula',
		year: win.year,
	})),
);
const relatedIntro = `Si ${movie.title} te gustó, seguí con alguna de estas.`;
const structuredData = createMovieStructuredData(movie, pageTitle, pageDescription);
const personProfileReturnPath = encodeURIComponent(Astro.url.pathname);

function getPersonProfileHref(profilePath?: string): string | undefined {
	if (!profilePath) {
		return undefined;
	}

	return `${profilePath}?backTo=${personProfileReturnPath}`;
}

function getAudienceRatingLabel(audienceRating: string): string {
	const normalized = String(audienceRating ?? '')
		.trim()
		.toUpperCase();

	if (!normalized) {
		return 'Clasificación no disponible';
	}

	if (normalized === 'ATP') {
		return 'Apta para todo público';
	}

	if (normalized.startsWith('+')) {
		return `Mayores de ${normalized.slice(1)} años`;
	}

	return normalized;
}

function parsePersonDate(value?: string): PersonDateParts | undefined {
	if (!value) {
		return undefined;
	}

	const match = String(value).match(/^(\d{4})(?:-(\d{2})(?:-(\d{2}))?)?$/);
	if (!match) {
		return undefined;
	}

	const year = Number.parseInt(match[1], 10);
	const month = match[2] ? Number.parseInt(match[2], 10) : undefined;
	const day = match[3] ? Number.parseInt(match[3], 10) : undefined;
	const precision: PersonDateParts['precision'] = day ? 3 : month ? 2 : 1;

	if (!Number.isInteger(year)) {
		return undefined;
	}

	return { year, month, day, precision };
}

function getPersonAge(person: {
	birthDate?: string;
	birthYear?: number;
	deathDate?: string;
	deathYear?: number;
}): number | undefined {
	const birthParts =
		parsePersonDate(person.birthDate) ??
		(person.birthYear ? { year: person.birthYear, precision: 1 } : undefined);
	const endParts =
		parsePersonDate(person.deathDate) ??
		(person.deathYear ? { year: person.deathYear, precision: 1 } : currentDateParts);

	if (!birthParts || !endParts || endParts.year < birthParts.year) {
		return undefined;
	}

	let age = endParts.year - birthParts.year;
	const birthMonth = birthParts.month ?? 0;
	const endMonth = endParts.month ?? 0;
	const birthDay = birthParts.day ?? 0;
	const endDay = endParts.day ?? 0;

	if (birthParts.precision >= 2 && endParts.precision >= 2 && endMonth < birthMonth) {
		age -= 1;
	} else if (
		birthParts.precision >= 3 &&
		endParts.precision >= 3 &&
		endMonth === birthMonth &&
		endDay < birthDay
	) {
		age -= 1;
	}

	return age >= 0 ? age : undefined;
}

function formatPersonDate(value?: string): string | undefined {
	const parts = parsePersonDate(value);
	if (!parts) {
		return undefined;
	}

	if (parts.precision >= 3) {
		return personDateFormatter.format(new Date(Date.UTC(parts.year, (parts.month ?? 1) - 1, parts.day ?? 1)));
	}

	if (parts.precision === 2) {
		return personMonthFormatter.format(new Date(Date.UTC(parts.year, (parts.month ?? 1) - 1, 1)));
	}

	return String(parts.year);
}

function getBirthSummary(person: { birthDate?: string; birthYear?: number }): string | undefined {
	const formattedDate = formatPersonDate(person.birthDate);
	if (formattedDate) {
		return `Nació el ${formattedDate}`;
	}

	if (person.birthYear) {
		return `Nació en ${person.birthYear}`;
	}

	return undefined;
}

function getDeathSummary(person: {
	birthDate?: string;
	birthYear?: number;
	deathDate?: string;
	deathYear?: number;
}): string | undefined {
	if (!person.deathDate && !person.deathYear) {
		return undefined;
	}

	const formattedDate = formatPersonDate(person.deathDate) ?? (person.deathYear ? String(person.deathYear) : undefined);
	if (!formattedDate) {
		return undefined;
	}

	const ageAtDeath = getPersonAge(person);
	if (ageAtDeath !== undefined) {
		return `Falleció el ${formattedDate} a los ${ageAtDeath} años`;
	}

	return `Falleció el ${formattedDate}`;
}

function shouldHideLivingAge(person: { birthDate?: string; birthYear?: number; deathDate?: string; deathYear?: number }): boolean {
	if (person.deathDate || person.deathYear) {
		return false;
	}

	const age = getPersonAge(person);
	return age !== undefined && age > 110;
}
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	image={posterUrl}
	openGraphType="article"
	structuredData={structuredData}
>
	<main id="main-content" class="container">
		<div class="page-actions">
			<a class="page-action page-action--history" href={import.meta.env.BASE_URL} data-history-back>
				Volver
			</a>
			<a class="page-action page-action--home" href={import.meta.env.BASE_URL}>Ir al listado</a>
		</div>

		<section class="movie-detail">
			{
				hasScreenshotGallery ? (
					<div class="movie-detail__gallery fade-up" style="--item-delay: 0ms;">
						{screenshotUrls.map((imageUrl, index) => (
							<div class="movie-detail__shot-wrap">
								<img
									class="movie-detail__shot"
									src={imageUrl}
									alt={`Screenshot ${index + 1} de ${movie.title}`}
									loading="lazy"
									referrerpolicy="no-referrer"
								/>
							</div>
						))}
					</div>
				) : (
					<div class="movie-detail__poster fade-up" style="--item-delay: 0ms;">
						<img src={posterUrl} alt={`Poster de ${movie.title}`} referrerpolicy="no-referrer" />
					</div>
				)
			}

			<div class="movie-detail__panel fade-up" style="--item-delay: 100ms;">
				<h1 class="movie-detail__title">{movie.title}</h1>
				<div class="movie-detail__meta">
					<span>{movie.year}</span>
					<span class={`badge ${verdictClass}`}>{getVerdictLabel(movie)}</span>
					<PlatformBadgeGroup platforms={moviePlatforms} />
				</div>
				<section class="movie-detail__showcase" aria-label="Trailer y elenco destacado">
					<div class="movie-detail__hero-stack">
						{trailerEmbedUrl ? (
							<div class="trailer-shell">
								<div class="trailer-shell__header">
									<span class="trailer-shell__eyebrow">Trailer oficial</span>
									<strong class="trailer-shell__title">Ver trailer de {movie.title}</strong>
								</div>
								<iframe
									class="trailer-frame"
									src={trailerEmbedUrl}
									title={`Trailer de ${movie.title}`}
									loading="lazy"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									referrerpolicy="strict-origin-when-cross-origin"
									allowfullscreen
								></iframe>
								<a
									class="trailer-shell__external"
									href={trailerWatchUrl}
									target="_blank"
									rel="noopener noreferrer"
									referrerpolicy="no-referrer"
								>
									Abrir en YouTube
								</a>
							</div>
						) : (
							<p class="message-box">Trailer no disponible.</p>
						)}
						{
							movie.synopsis && (
								<section class="movie-detail__synopsis-card" aria-label="De que se trata">
									<p class="movie-detail__synopsis-kicker">De que se trata</p>
									<p class="movie-detail__synopsis">{movie.synopsis}</p>
								</section>
							)
						}
						{
							movie.review && (
								<section class="movie-detail__review-card" aria-label="Reseña honesta">
									<p class="movie-detail__review-kicker">Reseña honesta</p>
									<p class="movie-detail__review">{movie.review}</p>
								</section>
							)
						}
					</div>
					{
						(peopleGroups.directors.length > 0 || peopleGroups.cast.length > 0) && (
							<section class="movie-detail__people-panel" aria-label="Elenco principal y dirección">
								{
									peopleGroups.directors.length > 0 && (
										<div class="movie-detail__people-block">
											<p class="movie-detail__people-title">
												{peopleGroups.directors.length > 1 ? 'Dirección' : 'Director'}
											</p>
									<ul class="movie-detail__people-grid" role="list">
												{peopleGroups.directors.map((person) => (
													<li>
														<article class="movie-detail__person-card">
															{
																person.profilePath ? (
																	<a
																		class="movie-detail__person-avatar movie-detail__person-avatar--link"
																		href={getPersonProfileHref(person.profilePath)}
																		aria-label={`Ver perfil de ${person.creditedName}`}
																	>
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</a>
																) : (
																	<div class="movie-detail__person-avatar">
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</div>
																)
															}
															<div class="movie-detail__person-copy">
																<p class="movie-detail__person-role">Dirección</p>
																<p class="movie-detail__person-name">
																	{
																		person.profilePath ? (
																			<a
																				class="movie-detail__person-name-link"
																				href={getPersonProfileHref(person.profilePath)}
																			>
																				{person.creditedName}
																			</a>
																		) : (
																			person.creditedName
																		)
																	}
																</p>
																<p class="movie-detail__person-meta">
																	{getBirthSummary(person) ? (
																		<>
																			<span>{getBirthSummary(person)}</span>
																			{person.deathDate || person.deathYear ? (
																				<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																			) : shouldHideLivingAge(person) ? (
																				<span>Edad no confirmada</span>
																			) : (
																				<span
																					class="movie-detail__person-age"
																					data-birth-date={person.birthDate}
																					data-birth-year={person.birthYear}
																				>
																					{getPersonAge(person)} años
																				</span>
																			)}
																		</>
																	) : person.deathDate || person.deathYear ? (
																		<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																	) : (
																		<span>Fecha de nacimiento no disponible</span>
																	)}
																</p>
																<p class="movie-detail__person-origin">
																	{person.nationalityPrimary ?? 'Nacionalidad no disponible'}
																</p>
															</div>
														</article>
													</li>
												))}
											</ul>
										</div>
									)
								}
								{
									peopleGroups.cast.length > 0 && (
										<div class="movie-detail__people-block">
											<p class="movie-detail__people-title">{castSectionTitle}</p>
									<ul class="movie-detail__people-grid" role="list">
												{peopleGroups.cast.map((person) => (
													<li>
														<article class="movie-detail__person-card">
															{
																person.profilePath ? (
																	<a
																		class="movie-detail__person-avatar movie-detail__person-avatar--link"
																		href={getPersonProfileHref(person.profilePath)}
																		aria-label={`Ver perfil de ${person.creditedName}`}
																	>
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</a>
																) : (
																	<div class="movie-detail__person-avatar">
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</div>
																)
															}
															<div class="movie-detail__person-copy">
																<p class="movie-detail__person-name">
																	{
																		person.profilePath ? (
																			<a
																				class="movie-detail__person-name-link"
																				href={getPersonProfileHref(person.profilePath)}
																			>
																				{person.creditedName}
																			</a>
																		) : (
																			person.creditedName
																		)
																	}
																</p>
																<p class="movie-detail__person-meta">
																	{getBirthSummary(person) ? (
																		<>
																			<span>{getBirthSummary(person)}</span>
																			{person.deathDate || person.deathYear ? (
																				<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																			) : shouldHideLivingAge(person) ? (
																				<span>Edad no confirmada</span>
																			) : (
																				<span
																					class="movie-detail__person-age"
																					data-birth-date={person.birthDate}
																					data-birth-year={person.birthYear}
																				>
																					{getPersonAge(person)} años
																				</span>
																			)}
																		</>
																	) : person.deathDate || person.deathYear ? (
																		<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																	) : (
																		<span>Fecha de nacimiento no disponible</span>
																	)}
																</p>
																<p class="movie-detail__person-origin">
																	{person.nationalityPrimary ?? 'Nacionalidad no disponible'}
																</p>
															</div>
														</article>
													</li>
												))}
											</ul>
										</div>
									)
								}
							</section>
						)
					}
				</section>
				<section class="movie-detail__info-tail" aria-label="Ficha técnica y datos extra">
					<div class="movie-detail__info-overview">
						<dl class="movie-detail__credits">
							<div class="movie-detail__credit-item">
								<dt>Titulo original</dt>
								<dd>{movie.originalTitle}</dd>
							</div>
							<div class="movie-detail__credit-item">
								<dt>Categoria</dt>
								<dd>{movie.category}</dd>
							</div>
							{
								moviePlatforms.length > 0 && (
									<div class="movie-detail__credit-item">
										<dt>{moviePlatforms.length > 1 ? 'Plataformas' : 'Plataforma'}</dt>
										<dd class="movie-detail__platform-value">
											<PlatformBadgeGroup platforms={moviePlatforms} />
											<span>{moviePlatformLabel}</span>
										</dd>
									</div>
								)
							}
							<div class="movie-detail__credit-item">
								<dt>Productora</dt>
								<dd>{movie.productionCompany}</dd>
							</div>
						</dl>
						{
							editorialSummary.related.length > 0 && (
								<section class="movie-detail__editorial-card movie-detail__editorial-card--related">
									<p class="movie-detail__editorial-copy">{relatedIntro}</p>
									<div class="movie-detail__related-list">
										{editorialSummary.related.map((recommendation) => (
											<a class="movie-detail__related-link" href={recommendation.url}>
												<span>{recommendation.title}</span>
												<span>{recommendation.year}</span>
											</a>
										))}
									</div>
								</section>
							)
						}
					</div>
					<div class="movie-detail__editorial-grid" aria-label="Datos utiles para decidir rapido">
						{
							editorialSummary.runtime && (
								<section class="movie-detail__editorial-card movie-detail__editorial-card--duration">
									<p class="movie-detail__editorial-kicker">Duración</p>
									<p class="movie-detail__runtime-value">{editorialSummary.runtime.formatted}</p>
								</section>
							)
						}
						<MovieRating movieSlug={movie.slug} />
						<section class="movie-detail__editorial-card movie-detail__editorial-card--audience-rating">
							<div class="movie-detail__audience-rating-top">
								<p class="movie-detail__editorial-kicker">Clasificación</p>
								<span class="movie-detail__audience-rating-chip">{movie.audienceRating}</span>
							</div>
							<p class="movie-detail__audience-rating-value">{getAudienceRatingLabel(movie.audienceRating)}</p>
						</section>
					</div>
					{
						groupedAwards.length > 0 && (
							<section class="movie-detail__awards-card" aria-label="Premios y galardones">
								<p class="movie-detail__awards-kicker">Premios y galardones</p>
								<div class="movie-detail__awards-groups">
									{groupedAwards.map((group) => (
										<div class="movie-detail__awards-group">
											<div class="movie-detail__awards-group-top">
												<span
													class={`movie-detail__award-brand movie-detail__award-brand--${group.awardType}`}
													aria-hidden="true"
												>
													<AwardMark
														award={group.awardType}
														class="movie-detail__award-brand-image"
														size={36}
													/>
												</span>
												<div class="movie-detail__awards-group-copy">
													<p class="movie-detail__awards-group-title">{group.label}</p>
													<p class="movie-detail__awards-group-count">
														{group.count} premio{group.count === 1 ? '' : 's'}
													</p>
												</div>
											</div>
										</div>
									))}
								</div>
								<ul class="movie-detail__awards-list">
									{awardCategories.map((award) => (
										<li class={award.isBestPicture ? 'movie-detail__award-item--top' : undefined}>
											<span
												class={`movie-detail__award-tag movie-detail__award-tag--${award.awardType}`}
												data-award={getAwardVisualKey(award.label)}
											>
												<AwardMark award={award.label} class="movie-detail__award-tag-icon" size={16} />
												<span>{award.label}</span>
											</span>
											<span>{award.category}</span>
											{award.recipient && (
												<span class="movie-detail__award-recipient">· {award.recipient}</span>
											)}
											{award.year && <span class="movie-detail__award-year">({award.year})</span>}
											{award.isBestPicture && (
												<span class="movie-detail__award-highlight">Premio mayor</span>
											)}
										</li>
									))}
								</ul>
							</section>
						)
					}
				</section>
			</div>
		</section>
	</main>
</BaseLayout>

<!-- Astro 6: keep ficha-detail browser logic in a typed local module so checks stay meaningful. -->
<script src="../../scripts/movie-detail.ts"></script>
