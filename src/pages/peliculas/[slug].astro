---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBrandLink from '../../components/HomeBrandLink.astro';
import {
	getAbsoluteCinemaStickerUrl,
	getCultMovieStickerUrl,
	getMovieEditorialSummary,
	getMoviePath,
	getMovies,
	getMoviePlatformLabel,
	getMoviePlatforms,
	getMovieSubgenres,
	getPosterUrl,
	getPrimaryGenreLabel,
	getYoutubeThumbnailUrl,
	getVerdictBadgeClass,
	getVerdictLabel,
	isAbsoluteCinemaMovie,
	isCultMovie,
} from '../../lib/movies';
import { getMoviePeopleGroups } from '../../lib/people';
import MovieRating from '../../components/MovieRating.astro';
import MovieReaction from '../../components/MovieReaction.astro';
import AwardMark from '../../components/AwardMark.astro';
import PlatformBadgeGroup from '../../components/PlatformBadgeGroup.astro';
import Lagrimometro from '../../components/Lagrimometro.astro';
import Jajametro from '../../components/Jajametro.astro';
import Cagazometro from '../../components/Cagazometro.astro';
import Explosiometro from '../../components/Explosiometro.astro';
import TrailerPlayer from '../../components/TrailerPlayer.astro';
import PostCreditsInfo from '../../components/PostCreditsInfo.astro';
import Sangrometro from '../../components/Sangrometro.astro';
import { getAwardVisualKey } from '../../lib/awards';
import { getMovieTenSecondTake } from '../../lib/editorialCopy';
import { getLagrimometroScore } from '../../lib/lagrimometro';
import { getJajametroScore } from '../../lib/jajametro';
import { getCagazometroScore } from '../../lib/cagazometro';
import { getExplosiometroScore } from '../../lib/explosiometro';
import { getSangrometroScore } from '../../lib/sangrometro';
import { EDITOR_NAME, EDITOR_PATH, METHODOLOGY_PATH, SITE_NAME, SITE_URL, createMovieStructuredData } from '../../lib/seo';
import { getMovieCommunityPath } from '../../lib/community';
import type { Movie } from '../../types/movie';

export function getStaticPaths() {
	const movies = getMovies();
	return movies.map((movie) => ({
		params: { slug: movie.slug },
		props: { movie },
	}));
}

const { movie } = Astro.props as { movie: Movie };
const allMovies = getMovies();
const pageTitle = `${movie.title} (${movie.year}) | Cine Posta`;
const pageDescription = movie.synopsis;
const posterUrl = getPosterUrl(movie.poster);
const verdictClass = getVerdictBadgeClass(movie);
const showAbsoluteCinemaSticker = isAbsoluteCinemaMovie(movie);
const absoluteCinemaStickerUrl = getAbsoluteCinemaStickerUrl();
const showCultMovieSticker = isCultMovie(movie);
const cultMovieStickerUrl = getCultMovieStickerUrl();
const editorialSummary = getMovieEditorialSummary(movie, allMovies);
const tenSecondTake = getMovieTenSecondTake(movie);
const peopleGroups = getMoviePeopleGroups(movie);
const moviePlatforms = getMoviePlatforms(movie);
const moviePlatformLabel = getMoviePlatformLabel(movie);
const primaryGenreLabel = getPrimaryGenreLabel(movie);
const movieSubgenres = getMovieSubgenres(movie);
const sangrometroScore = getSangrometroScore(movie);
const lagrimometroScore = sangrometroScore === undefined ? getLagrimometroScore(movie) : undefined;
const jajametroScore = sangrometroScore === undefined && lagrimometroScore === undefined ? getJajametroScore(movie) : undefined;
const cagazometroScore =
	sangrometroScore === undefined && lagrimometroScore === undefined && jajametroScore === undefined
		? getCagazometroScore(movie)
		: undefined;
const explosiometroScore =
	sangrometroScore === undefined &&
	lagrimometroScore === undefined &&
	jajametroScore === undefined &&
	cagazometroScore === undefined
		? getExplosiometroScore(movie)
		: undefined;
const shouldShowPostCreditsInfo = movie.postCreditsScenes !== undefined;
const currentDate = new Date();
type PersonDateParts = {
	year: number;
	month?: number;
	day?: number;
	precision: 1 | 2 | 3;
};

const currentDateParts = {
	year: currentDate.getUTCFullYear(),
	month: currentDate.getUTCMonth() + 1,
	day: currentDate.getUTCDate(),
	precision: 3,
} satisfies PersonDateParts;
const personDateFormatter = new Intl.DateTimeFormat('es-AR', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});
const personMonthFormatter = new Intl.DateTimeFormat('es-AR', {
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});
const normalizedCategory = String(movie.category || '')
	.normalize('NFD')
	.replace(/[\u0300-\u036f]/g, '')
	.toLowerCase()
	.trim();
const isAnimatedTitle = normalizedCategory === 'anime' || normalizedCategory === 'animacion';
const castSectionTitle = isAnimatedTitle ? 'Voces originales' : 'Elenco';
const screenshotUrls = (movie.screenshots ?? [])
	.filter((value) => typeof value === 'string' && value.trim().length > 0)
	.slice(0, 2)
	.map((value) => getPosterUrl(value));
const hasScreenshotGallery = screenshotUrls.length >= 2;
const trailerThumbnailUrl = getYoutubeThumbnailUrl(movie.trailerYoutubeId) || posterUrl;
const awardMeta = {
	oscar: { label: 'Oscar' },
	grammy: { label: 'Grammy' },
	cannes: { label: 'Cannes' },
} as const;

const groupedAwards = (['oscar', 'grammy', 'cannes'] as const)
	.map((awardType) => {
		const wins = (movie.awards?.wins ?? []).filter((win) => win.award === awardType);
		return {
			awardType,
			wins,
			count: wins.length,
			label: awardMeta[awardType].label,
		};
	})
	.filter((group) => group.count > 0);

const awardCategories = groupedAwards.flatMap((group) =>
	group.wins.map((win) => ({
		awardType: group.awardType,
		label: group.label,
		category: win.category,
		recipient: win.recipient,
		isBestPicture:
			group.awardType === 'oscar' &&
			win.category
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toLowerCase()
				.trim() === 'mejor pelicula',
		year: win.year,
	})),
);
const relatedIntro = `Si ${movie.title} te gustó, seguí por acá.`;
const movieCanonicalUrl = new URL(getMoviePath(movie.slug), SITE_URL).toString();
const shareText = `Mirá la reseña de ${movie.title} (${movie.year}) en ${SITE_NAME}`;
const whatsappShareUrl = `https://wa.me/?${new URLSearchParams({
	text: `${shareText} ${movieCanonicalUrl}`,
}).toString()}`;
const xShareUrl = `https://twitter.com/intent/tweet?${new URLSearchParams({
	text: shareText,
	url: movieCanonicalUrl,
}).toString()}`;
const structuredData = createMovieStructuredData(movie, pageTitle, pageDescription);
const reviewPurposeNote = 'Reseña corta y al hueso para decidir si verla o dejarla pasar.';
const editorialUpdatedLabel = movie.releaseDate
	? new Intl.DateTimeFormat('es-AR', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
			timeZone: 'UTC',
		}).format(new Date(`${movie.releaseDate}T00:00:00Z`))
	: '';
const tenSecondRows = [
	{ label: 'Veredicto', fact: tenSecondTake.verdict },
	{ label: 'Qué es', fact: tenSecondTake.identity },
	{ label: 'Ritmo', fact: tenSecondTake.pace },
	{ label: 'Antes de darle play', fact: tenSecondTake.plan },
	{ label: 'Intensidad', fact: tenSecondTake.intensity },
];

function getPersonProfileHref(profilePath?: string): string | undefined {
	if (!profilePath) {
		return undefined;
	}

	return profilePath;
}

function getAudienceRatingLabel(audienceRating: string): string {
	const normalized = String(audienceRating ?? '')
		.trim()
		.toUpperCase();

	if (!normalized) {
		return 'Clasificación no cargada';
	}

	if (normalized === 'ATP') {
		return 'Apta para todo público';
	}

	if (normalized.startsWith('+')) {
		return `Mayores de ${normalized.slice(1)} años`;
	}

	return normalized;
}

function parsePersonDate(value?: string): PersonDateParts | undefined {
	if (!value) {
		return undefined;
	}

	const match = String(value).match(/^(\d{4})(?:-(\d{2})(?:-(\d{2}))?)?$/);
	if (!match) {
		return undefined;
	}

	const year = Number.parseInt(match[1], 10);
	const month = match[2] ? Number.parseInt(match[2], 10) : undefined;
	const day = match[3] ? Number.parseInt(match[3], 10) : undefined;
	const precision: PersonDateParts['precision'] = day ? 3 : month ? 2 : 1;

	if (!Number.isInteger(year)) {
		return undefined;
	}

	return { year, month, day, precision };
}

function getPersonAge(person: {
	birthDate?: string;
	birthYear?: number;
	deathDate?: string;
	deathYear?: number;
}): number | undefined {
	const birthParts =
		parsePersonDate(person.birthDate) ??
		(person.birthYear ? { year: person.birthYear, precision: 1 } : undefined);
	const endParts =
		parsePersonDate(person.deathDate) ??
		(person.deathYear ? { year: person.deathYear, precision: 1 } : currentDateParts);

	if (!birthParts || !endParts || endParts.year < birthParts.year) {
		return undefined;
	}

	let age = endParts.year - birthParts.year;
	const birthMonth = birthParts.month ?? 0;
	const endMonth = endParts.month ?? 0;
	const birthDay = birthParts.day ?? 0;
	const endDay = endParts.day ?? 0;

	if (birthParts.precision >= 2 && endParts.precision >= 2 && endMonth < birthMonth) {
		age -= 1;
	} else if (
		birthParts.precision >= 3 &&
		endParts.precision >= 3 &&
		endMonth === birthMonth &&
		endDay < birthDay
	) {
		age -= 1;
	}

	return age >= 0 ? age : undefined;
}

function formatPersonDate(value?: string): string | undefined {
	const parts = parsePersonDate(value);
	if (!parts) {
		return undefined;
	}

	if (parts.precision >= 3) {
		return personDateFormatter.format(new Date(Date.UTC(parts.year, (parts.month ?? 1) - 1, parts.day ?? 1)));
	}

	if (parts.precision === 2) {
		return personMonthFormatter.format(new Date(Date.UTC(parts.year, (parts.month ?? 1) - 1, 1)));
	}

	return String(parts.year);
}

function getBirthSummary(person: { birthDate?: string; birthYear?: number }): string | undefined {
	const formattedDate = formatPersonDate(person.birthDate);
	if (formattedDate) {
		return `Nació el ${formattedDate}`;
	}

	if (person.birthYear) {
		return `Nació en ${person.birthYear}`;
	}

	return undefined;
}

function getDeathSummary(person: {
	birthDate?: string;
	birthYear?: number;
	deathDate?: string;
	deathYear?: number;
}): string | undefined {
	if (!person.deathDate && !person.deathYear) {
		return undefined;
	}

	const formattedDate = formatPersonDate(person.deathDate) ?? (person.deathYear ? String(person.deathYear) : undefined);
	if (!formattedDate) {
		return undefined;
	}

	const ageAtDeath = getPersonAge(person);
	if (ageAtDeath !== undefined) {
		return `Falleció el ${formattedDate} a los ${ageAtDeath} años`;
	}

	return `Falleció el ${formattedDate}`;
}

function shouldHideLivingAge(person: { birthDate?: string; birthYear?: number; deathDate?: string; deathYear?: number }): boolean {
	if (person.deathDate || person.deathYear) {
		return false;
	}

	const age = getPersonAge(person);
	return age !== undefined && age > 110;
}
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	image={posterUrl}
	openGraphType="article"
	structuredData={structuredData}
>
	<main id="main-content" class="container">
		<div class="page-actions">
			<a class="page-action page-action--history" href={import.meta.env.BASE_URL} data-history-back>
				Volver
			</a>
			<HomeBrandLink className="page-action page-action--home" label="Volver al inicio de Cine Posta" />
			<a class="page-action" href={getMovieCommunityPath(movie.slug)}>Abrir discusión</a>
		</div>

		<section class="movie-detail">
			{
				hasScreenshotGallery ? (
					<div class="movie-detail__gallery fade-up" style="--item-delay: 0ms;">
						{screenshotUrls.map((imageUrl, index) => (
							<div class="movie-detail__shot-wrap">
								<img
									class="movie-detail__shot"
									src={imageUrl}
									alt={`Screenshot ${index + 1} de ${movie.title}`}
									loading="lazy"
									referrerpolicy="no-referrer"
								/>
							</div>
						))}
						{showAbsoluteCinemaSticker && (
							<img
								class="absolute-cinema-sticker movie-sticker movie-detail__absolute-cinema-sticker"
								src={absoluteCinemaStickerUrl}
								alt="Absolute Cinema"
								loading="eager"
								decoding="async"
								width="1254"
								height="1254"
							/>
						)}
						{showCultMovieSticker && (
							<img
								class="cult-movie-sticker movie-sticker movie-detail__cult-movie-sticker"
								src={cultMovieStickerUrl}
								alt="De culto"
								loading="eager"
								decoding="async"
								width="1254"
								height="1254"
							/>
						)}
					</div>
				) : (
					<div class="movie-detail__poster fade-up" style="--item-delay: 0ms;">
						<img src={posterUrl} alt={`Poster de ${movie.title}`} referrerpolicy="no-referrer" data-cineposta-poster data-poster-search-title={movie.title} data-poster-search-year={movie.year} />
						{showAbsoluteCinemaSticker && (
							<img
								class="absolute-cinema-sticker movie-sticker movie-detail__absolute-cinema-sticker"
								src={absoluteCinemaStickerUrl}
								alt="Absolute Cinema"
								loading="eager"
								decoding="async"
								width="1254"
								height="1254"
							/>
						)}
						{showCultMovieSticker && (
							<img
								class="cult-movie-sticker movie-sticker movie-detail__cult-movie-sticker"
								src={cultMovieStickerUrl}
								alt="De culto"
								loading="eager"
								decoding="async"
								width="1254"
								height="1254"
							/>
						)}
					</div>
				)
			}

			<div class="movie-detail__panel fade-up" style="--item-delay: 100ms;">
				<header class="movie-detail__heading">
					<div class="movie-detail__intro">
						<h1 class="movie-detail__title">{movie.title}</h1>
						<div class="movie-detail__meta">
							<span>{movie.year}</span>
							<span class={`badge ${verdictClass}`}>{getVerdictLabel(movie)}</span>
							<PlatformBadgeGroup platforms={moviePlatforms} />
						</div>
						<div class="movie-detail__editorial-byline" aria-label="Datos editoriales de la reseña">
							<span>Publicado por {SITE_NAME}</span>
							<span aria-hidden="true">·</span>
							<a href={EDITOR_PATH}>Editado y revisado por {EDITOR_NAME}</a>
							{editorialUpdatedLabel && (
								<>
									<span aria-hidden="true">·</span>
									<time datetime={movie.releaseDate}>Estreno: {editorialUpdatedLabel}</time>
								</>
							)}
						</div>
						<p class="movie-detail__editorial-note">{reviewPurposeNote}</p>
					</div>
				</header>
				<section class="movie-detail__showcase" aria-label="Trailer y elenco destacado">
					<div class="movie-detail__hero-stack">
						{movie.trailerYoutubeId ? (
							<TrailerPlayer
								title={movie.title}
								year={movie.year}
								youtubeId={movie.trailerYoutubeId}
								thumbnailUrl={trailerThumbnailUrl}
							/>
						) : (
							<p class="message-box">Todavía no tenemos trailer cargado.</p>
						)}
						{
							sangrometroScore !== undefined && (
								<section id="sangrometro" class="movie-detail__sangrometro-card" aria-label="Sangrómetro">
									<div class="movie-detail__sangrometro-head">
										<p class="movie-detail__sangrometro-title">Sangrómetro</p>
									</div>
									<Sangrometro score={sangrometroScore} />
								</section>
							)
						}
						{
							lagrimometroScore !== undefined && (
								<section id="lagrimometro" class="movie-detail__lagrimometro-card" aria-label="Lagrimómetro">
									<div class="movie-detail__lagrimometro-head">
										<p class="movie-detail__lagrimometro-title">Lagrimómetro</p>
									</div>
									<Lagrimometro score={lagrimometroScore} />
								</section>
							)
						}
						{
							jajametroScore !== undefined && (
								<section id="jajametro" class="movie-detail__jajametro-card" aria-label="Jajámetro">
									<div class="movie-detail__jajametro-head">
										<p class="movie-detail__jajametro-title">Jajámetro</p>
									</div>
									<Jajametro score={jajametroScore} />
								</section>
							)
						}
						{
							cagazometroScore !== undefined && (
								<section id="cagazometro" class="movie-detail__cagazometro-card" aria-label="Cagazómetro">
									<div class="movie-detail__cagazometro-head">
										<p class="movie-detail__cagazometro-title">Cagazómetro</p>
									</div>
									<Cagazometro score={cagazometroScore} />
								</section>
							)
						}
						{
							explosiometroScore !== undefined && (
								<section id="explosiometro" class="movie-detail__explosiometro-card" aria-label="Explosiómetro">
									<div class="movie-detail__explosiometro-head">
										<p class="movie-detail__explosiometro-title">Explosiómetro</p>
									</div>
									<Explosiometro score={explosiometroScore} />
								</section>
							)
						}
						{
							shouldShowPostCreditsInfo && (
								<section id="post-credits" class="movie-detail__post-credits-card" aria-label="Escenas post-créditos">
									<div class="movie-detail__post-credits-head">
										<p class="movie-detail__post-credits-title">Escenas post-créditos</p>
									</div>
									<PostCreditsInfo scenes={movie.postCreditsScenes!} />
								</section>
							)
						}
						{
							movie.synopsis && (
								<section class="movie-detail__synopsis-card" aria-label="De qué se trata">
									<p class="movie-detail__synopsis-kicker">De qué va</p>
									<p class="movie-detail__synopsis">{movie.synopsis}</p>
								</section>
							)
						}
						{
							movie.review && (
								<section class="movie-detail__review-card" aria-label="Reseña honesta">
									<p class="movie-detail__review-kicker">La posta</p>
									<p class="movie-detail__review">{movie.review}</p>
									<a class="movie-detail__community-link" href={getMovieCommunityPath(movie.slug)}>💬 ¿La viste? Caé a Foro Cineposta y tirá tu opinión</a>
								</section>
							)
						}
					</div>
					<div class="movie-detail__side-stack">
						<section
							class="movie-share"
							aria-labelledby={`share-${movie.slug}`}
							data-movie-share
							data-share-url={movieCanonicalUrl}
							data-share-title={pageTitle}
							data-share-text={shareText}
						>
							<div class="movie-share__top">
								<p id={`share-${movie.slug}`} class="movie-share__title">Share</p>
								<p class="movie-share__hint">Pasá esta ficha por mensaje o redes.</p>
							</div>
							<div class="movie-share__actions" aria-label={`Compartir ${movie.title}`}>
								<button class="movie-share__button movie-share__button--primary" type="button" data-native-share hidden>
									Compartir
								</button>
								<a
									class="movie-share__button movie-share__button--whatsapp"
									href={whatsappShareUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Compartir ${movie.title} por WhatsApp`}
								>
									<img class="movie-share__logo movie-share__logo--whatsapp" src="/brand/social/whatsapp.svg" alt="" aria-hidden="true" loading="lazy" />
								</a>
								<a
									class="movie-share__button movie-share__button--x"
									href={xShareUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Compartir ${movie.title} en X`}
								>
									<img class="movie-share__logo movie-share__logo--x" src="/brand/social/x.svg" alt="" aria-hidden="true" loading="lazy" />
								</a>
								<button class="movie-share__button movie-share__button--copy" type="button" data-copy-share-url>
									Copiar URL
								</button>
							</div>
							<p class="movie-share__status" role="status" aria-live="polite" data-share-status></p>
						</section>
						<dl class="movie-detail__taxonomy" aria-label="Género y subgéneros">
							<div class="movie-detail__taxonomy-item">
								<dt>Género</dt>
								<dd>{primaryGenreLabel}</dd>
							</div>
							{
								movieSubgenres.length > 0 && (
									<div class="movie-detail__taxonomy-item movie-detail__taxonomy-item--subgenres">
										<dt>{movieSubgenres.length > 1 ? 'Subgéneros' : 'Subgénero'}</dt>
										<dd class="movie-detail__taxonomy-tags">
											{movieSubgenres.map((subgenre) => (
												<span class="movie-detail__taxonomy-tag">{subgenre}</span>
											))}
										</dd>
									</div>
								)
							}
						</dl>
						{
							(peopleGroups.directors.length > 0 || peopleGroups.cast.length > 0) && (
								<section class="movie-detail__people-panel" aria-label="Elenco principal y dirección">
								{
									peopleGroups.directors.length > 0 && (
										<div class="movie-detail__people-block">
											<h2 class="movie-detail__people-title">
												{peopleGroups.directors.length > 1 ? 'Dirección' : 'Director'}
											</h2>
											<ul class="movie-detail__people-grid" role="list">
												{peopleGroups.directors.map((person) => (
													<li>
														<article
															class={`movie-detail__person-card${person.profilePath ? ' movie-detail__person-card--profile' : ''}`}
														>
															{
																person.profilePath ? (
																	<a
																		class="movie-detail__person-avatar movie-detail__person-avatar--link"
																		href={getPersonProfileHref(person.profilePath)}
																		aria-label={`Ver perfil de ${person.creditedName}`}
																	>
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</a>
																) : (
																	<div class="movie-detail__person-avatar">
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</div>
																)
															}
															<div class="movie-detail__person-copy">
																<h3 class="movie-detail__person-name">
																	{
																		person.profilePath ? (
																			<a
																				class="movie-detail__person-name-link"
																				href={getPersonProfileHref(person.profilePath)}
																			>
																				{person.creditedName}
																			</a>
																		) : (
																			person.creditedName
																		)
																	}
																</h3>
																{
																	person.profilePath && (
																		<p class="movie-detail__person-badge-row">
																			<span class="movie-detail__person-flag">Tiene ficha</span>
																		</p>
																	)
																}
																<p class="movie-detail__person-origin">
																	{person.nationalityPrimary ?? 'Nacionalidad no disponible'}
																</p>
																{
																	(getBirthSummary(person) || getDeathSummary(person)) && (
																		<p class="movie-detail__person-meta">
																			{getBirthSummary(person) ? (
																				<>
																					<span>{getBirthSummary(person)}</span>
																					{person.deathDate || person.deathYear ? (
																						<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																					) : shouldHideLivingAge(person) ? (
																						<span>Edad no confirmada</span>
																					) : (
																						<span
																							class="movie-detail__person-age"
																							data-birth-date={person.birthDate}
																							data-birth-year={person.birthYear}
																						>
																							{getPersonAge(person)} años
																						</span>
																					)}
																				</>
																			) : (
																				<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																			)}
																		</p>
																	)
																}
															</div>
														</article>
													</li>
												))}
											</ul>
										</div>
									)
								}
								{
									peopleGroups.cast.length > 0 && (
										<div class="movie-detail__people-block">
											<h2 class="movie-detail__people-title">{castSectionTitle}</h2>
											<ul class="movie-detail__people-grid" role="list">
												{peopleGroups.cast.map((person) => (
													<li>
														<article
															class={`movie-detail__person-card${person.profilePath ? ' movie-detail__person-card--profile' : ''}`}
														>
															{
																person.profilePath ? (
																	<a
																		class="movie-detail__person-avatar movie-detail__person-avatar--link"
																		href={getPersonProfileHref(person.profilePath)}
																		aria-label={`Ver perfil de ${person.creditedName}`}
																	>
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</a>
																) : (
																	<div class="movie-detail__person-avatar">
																		{person.image || person.remoteImageUrl ? (
																			<img
																				src={person.image ?? person.remoteImageUrl}
																				alt={`Foto de ${person.creditedName}`}
																				loading="lazy"
																				referrerpolicy="no-referrer"
																			/>
																		) : (
																			<span aria-hidden="true">{person.initials}</span>
																		)}
																	</div>
																)
															}
															<div class="movie-detail__person-copy">
																<h3 class="movie-detail__person-name">
																	{
																		person.profilePath ? (
																			<a
																				class="movie-detail__person-name-link"
																				href={getPersonProfileHref(person.profilePath)}
																			>
																				{person.creditedName}
																			</a>
																		) : (
																			person.creditedName
																		)
																	}
																</h3>
																{
																	person.profilePath && (
																		<p class="movie-detail__person-badge-row">
																			<span class="movie-detail__person-flag">Tiene ficha</span>
																		</p>
																	)
																}
																<p class="movie-detail__person-origin">
																	{person.nationalityPrimary ?? 'Nacionalidad no disponible'}
																</p>
																{
																	(getBirthSummary(person) || getDeathSummary(person)) && (
																		<p class="movie-detail__person-meta">
																			{getBirthSummary(person) ? (
																				<>
																					<span>{getBirthSummary(person)}</span>
																					{person.deathDate || person.deathYear ? (
																						<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																					) : shouldHideLivingAge(person) ? (
																						<span>Edad no confirmada</span>
																					) : (
																						<span
																							class="movie-detail__person-age"
																							data-birth-date={person.birthDate}
																							data-birth-year={person.birthYear}
																						>
																							{getPersonAge(person)} años
																						</span>
																					)}
																				</>
																			) : (
																				<span class="movie-detail__person-death">{getDeathSummary(person)}</span>
																			)}
																		</p>
																	)
																}
															</div>
														</article>
													</li>
												))}
											</ul>
										</div>
									)
								}
								</section>
							)
						}
					</div>
				</section>
				<MovieReaction movie={movie} />
				{
					groupedAwards.length > 0 && (
						<section class="movie-detail__awards-card" aria-label="Premios y galardones">
							<p class="movie-detail__awards-kicker">Premios y galardones</p>
							<div class="movie-detail__awards-groups">
								{groupedAwards.map((group) => (
									<div class="movie-detail__awards-group">
										<div class="movie-detail__awards-group-top">
											<span
												class={`movie-detail__award-brand movie-detail__award-brand--${group.awardType}`}
												aria-hidden="true"
											>
												<AwardMark
													award={group.awardType}
													class="movie-detail__award-brand-image"
													size={50}
												/>
											</span>
											<div class="movie-detail__awards-group-copy">
												<p class="movie-detail__awards-group-title">{group.label}</p>
												<p class="movie-detail__awards-group-count">
													{group.count} premio{group.count === 1 ? '' : 's'}
												</p>
											</div>
										</div>
									</div>
								))}
							</div>
							<ul class="movie-detail__awards-list">
								{awardCategories.map((award) => (
									<li class={award.isBestPicture ? 'movie-detail__award-item--top' : undefined}>
										<span
											class={`movie-detail__award-tag movie-detail__award-tag--${award.awardType}`}
											data-award={getAwardVisualKey(award.label, award.category)}
										>
											<AwardMark award={award.label} category={award.category} class="movie-detail__award-tag-icon" size={16} />
											<span>{award.label}</span>
										</span>
										<span>{award.category}</span>
										{award.recipient && (
											<span class="movie-detail__award-recipient">· {award.recipient}</span>
										)}
										{award.year && <span class="movie-detail__award-year">({award.year})</span>}
										{award.isBestPicture && (
											<span class="movie-detail__award-highlight">Premio mayor</span>
										)}
									</li>
								))}
							</ul>
						</section>
					)
				}
				<section class="movie-detail__info-tail" aria-label="Ficha técnica y datos extra">
					<div class="movie-detail__info-overview">
						<dl class="movie-detail__credits">
							<div class="movie-detail__credit-item">
								<dt>Título original</dt>
								<dd>{movie.originalTitle}</dd>
							</div>
							<div class="movie-detail__credit-item">
								<dt>Género</dt>
								<dd>{primaryGenreLabel}</dd>
							</div>
							{
								movieSubgenres.length > 0 && (
									<div class="movie-detail__credit-item">
										<dt>{movieSubgenres.length > 1 ? 'Subgéneros' : 'Subgénero'}</dt>
										<dd class="movie-detail__taxonomy-tags">
											{movieSubgenres.map((subgenre) => (
												<span class="movie-detail__taxonomy-tag">{subgenre}</span>
											))}
										</dd>
									</div>
								)
							}
							{
								moviePlatforms.length > 0 && (
									<div class="movie-detail__credit-item">
										<dt>{moviePlatforms.length > 1 ? 'Plataformas' : 'Plataforma'}</dt>
										<dd class="movie-detail__platform-value">
											<PlatformBadgeGroup platforms={moviePlatforms} />
											<span class="u-visually-hidden">{moviePlatformLabel}</span>
										</dd>
									</div>
								)
							}
							<div class="movie-detail__credit-item">
								<dt>Productora</dt>
								<dd>{movie.productionCompany}</dd>
							</div>
						</dl>
						{
							editorialSummary.related.length > 0 && (
								<section class="movie-detail__editorial-card movie-detail__editorial-card--related">
									<p class="movie-detail__editorial-copy">{relatedIntro}</p>
									<div class="movie-detail__related-list">
										{editorialSummary.related.map((recommendation) => (
											<a class="movie-detail__related-link" href={recommendation.url}>
												<span>{recommendation.title}</span>
												<span>{recommendation.year}</span>
											</a>
										))}
									</div>
								</section>
							)
						}
					</div>
					<div class="movie-detail__editorial-grid" aria-label="Datos útiles para decidir rápido">
						{
							editorialSummary.runtime && (
								<section class="movie-detail__editorial-card movie-detail__editorial-card--duration">
									<p class="movie-detail__editorial-kicker">Duración</p>
									<p class="movie-detail__runtime-value">{editorialSummary.runtime.formatted}</p>
								</section>
							)
						}
						<MovieRating movieSlug={movie.slug} />
						<section class="movie-detail__editorial-card movie-detail__editorial-card--audience-rating">
							<div class="movie-detail__audience-rating-top">
								<p class="movie-detail__editorial-kicker">Clasificación</p>
								<span class="movie-detail__audience-rating-chip">{movie.audienceRating}</span>
							</div>
							<p class="movie-detail__audience-rating-value">{getAudienceRatingLabel(movie.audienceRating)}</p>
						</section>
					</div>
					<section class="movie-detail__ten-second-card" aria-labelledby={`ten-second-${movie.slug}`}>
						<div class="movie-detail__ten-second-head">
							<p class="movie-detail__ten-second-kicker">La Posta en 10 segundos</p>
							<a href={METHODOLOGY_PATH}>Cómo evaluamos las pelis</a>
						</div>
						<p class="movie-detail__ten-second-intro">
							Cinco señales rápidas para ubicarte: qué onda la peli, cuánto pide y con qué ánimo entra mejor.
						</p>
						<h2 id={`ten-second-${movie.slug}`} class="u-visually-hidden">La Posta en 10 segundos de {movie.title}</h2>
						<dl class="movie-detail__ten-second-list">
							{tenSecondRows.map((row) => (
								<div class="movie-detail__ten-second-row">
									<dt>{row.label}</dt>
									<dd>
										<span class="movie-detail__ten-second-value">{row.fact.value}</span>
										{row.fact.detail && <span class="movie-detail__ten-second-detail">{row.fact.detail}</span>}
									</dd>
								</div>
							))}
						</dl>
					</section>
				</section>
			</div>
		</section>
	</main>
</BaseLayout>

<!-- Astro 6: keep ficha-detail browser logic in a typed local module so checks stay meaningful. -->
<script src="../../scripts/movie-detail.ts"></script>
