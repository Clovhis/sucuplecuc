---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getMovieEditorialSummary,
	getMovies,
	getPosterUrl,
	getVerdictBadgeClass,
	getVerdictLabel,
} from '../../lib/movies';
import MovieRating from '../../components/MovieRating.astro';
import type { Movie } from '../../types/movie';

export function getStaticPaths() {
	const movies = getMovies();
	return movies.map((movie) => ({
		params: { slug: movie.slug },
		props: { movie },
	}));
}

const { movie } = Astro.props as { movie: Movie };
const allMovies = getMovies();
const pageTitle = `${movie.title} (${movie.year}) | Cine Posta`;
const pageDescription = movie.review;
const posterUrl = getPosterUrl(movie.poster);
const verdictClass = getVerdictBadgeClass(movie);
const editorialSummary = getMovieEditorialSummary(movie, allMovies);
const screenshotUrls = (movie.screenshots ?? [])
	.filter((value) => typeof value === 'string' && value.trim().length > 0)
	.slice(0, 2)
	.map((value) => getPosterUrl(value));
const hasScreenshotGallery = screenshotUrls.length >= 2;
const trailerEmbedUrl = movie.trailerYoutubeId
	? `https://www.youtube.com/embed/${movie.trailerYoutubeId}`
	: '';
const awardMeta = {
	oscar: { label: 'Oscar', icon: '🏆' },
	grammy: { label: 'Grammy', icon: '🎵' },
	cannes: { label: 'Cannes', icon: '🌴' },
} as const;

const groupedAwards = (['oscar', 'grammy', 'cannes'] as const)
	.map((awardType) => {
		const wins = (movie.awards?.wins ?? []).filter((win) => win.award === awardType);
		return {
			awardType,
			wins,
			count: wins.length,
			label: awardMeta[awardType].label,
			icon: awardMeta[awardType].icon,
		};
	})
	.filter((group) => group.count > 0);

const awardCategories = groupedAwards.flatMap((group) =>
	group.wins.map((win) => ({
		awardType: group.awardType,
		label: group.label,
		category: win.category,
		recipient: win.recipient,
		isBestPicture:
			group.awardType === 'oscar' &&
			win.category
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toLowerCase()
				.trim() === 'mejor pelicula',
		year: win.year,
	})),
);
const hasEditorialTopGrid =
	Boolean(editorialSummary.runtime) || editorialSummary.idealFor.length > 0;
const relatedIntro = `Si ${movie.title} te gustó, seguí con alguna de estas.`;
---

<BaseLayout title={pageTitle} description={pageDescription} image={posterUrl}>
	<main id="main-content" class="container">
		<div class="page-actions">
			<a class="page-action page-action--history" href={import.meta.env.BASE_URL} data-history-back>
				Volver
			</a>
			<a class="page-action page-action--home" href={import.meta.env.BASE_URL}>Ir al listado</a>
		</div>

		<section class="movie-detail">
			{
				hasScreenshotGallery ? (
					<div class="movie-detail__gallery fade-up" style="--item-delay: 0ms;">
						{screenshotUrls.map((imageUrl, index) => (
							<div class="movie-detail__shot-wrap">
								<img
									class="movie-detail__shot"
									src={imageUrl}
									alt={`Screenshot ${index + 1} de ${movie.title}`}
									loading="lazy"
								/>
							</div>
						))}
					</div>
				) : (
					<div class="movie-detail__poster fade-up" style="--item-delay: 0ms;">
						<img src={posterUrl} alt={`Poster de ${movie.title}`} />
					</div>
				)
			}

			<div class="movie-detail__panel fade-up" style="--item-delay: 100ms;">
				<h1 class="movie-detail__title">{movie.title}</h1>
				<div class="movie-detail__meta">
					<span>{movie.year}</span>
					<span class={`badge ${verdictClass}`}>{getVerdictLabel(movie)}</span>
					{movie.releasePlatform && <span class="platform-chip">{movie.releasePlatform}</span>}
				</div>
				{
					editorialSummary.bridge.length > 0 && (
						<section class="movie-detail__editorial-card movie-detail__editorial-card--bridge">
							<p class="movie-detail__editorial-copy">
								Te puede gustar si venís de{' '}
								{editorialSummary.bridge.map((recommendation, index) => (
									<>
										<a class="movie-detail__text-link" href={recommendation.url}>
											{recommendation.title}
										</a>
										{index < editorialSummary.bridge.length - 2
											? ', '
											: index === editorialSummary.bridge.length - 2
												? ' o '
												: ''}
									</>
								))}
							</p>
						</section>
					)
				}
				<dl class="movie-detail__credits">
					<div class="movie-detail__credit-item">
						<dt>Titulo original</dt>
						<dd>{movie.originalTitle}</dd>
					</div>
					<div class="movie-detail__credit-item">
						<dt>Categoria</dt>
						<dd>{movie.category}</dd>
					</div>
					<div class="movie-detail__credit-item">
						<dt>Director</dt>
						<dd>{movie.director}</dd>
					</div>
					<div class="movie-detail__credit-item">
						<dt>Actores principales</dt>
						<dd>{movie.mainCast.join(', ')}</dd>
					</div>
					<div class="movie-detail__credit-item">
						<dt>Productora</dt>
						<dd>{movie.productionCompany}</dd>
					</div>
				</dl>
				{
					hasEditorialTopGrid && (
						<div class="movie-detail__editorial-grid" aria-label="Datos utiles para decidir rapido">
							{
								editorialSummary.runtime && (
									<section class="movie-detail__editorial-card movie-detail__editorial-card--duration">
										<p class="movie-detail__editorial-kicker">Duración</p>
										<p class="movie-detail__runtime-value">{editorialSummary.runtime.formatted}</p>
									</section>
								)
							}
							{
								editorialSummary.idealFor.length > 0 && (
									<section class="movie-detail__editorial-card">
										<p class="movie-detail__editorial-kicker">Ideal para</p>
										<ul class="movie-detail__tag-list" aria-label="Ideal para">
											{editorialSummary.idealFor.map((tag) => (
												<li class="movie-detail__tag">{tag}</li>
											))}
										</ul>
									</section>
								)
							}
						</div>
					)
				}
				{
					groupedAwards.length > 0 && (
						<section class="movie-detail__awards-card" aria-label="Premios y galardones">
							<p class="movie-detail__awards-kicker">Premios y galardones</p>
							<div class="movie-detail__awards-groups">
								{groupedAwards.map((group) => (
									<div class="movie-detail__awards-group">
										<p class="movie-detail__awards-group-title">{group.label}</p>
										<div
											class="movie-detail__awards-icons"
											aria-label={`${group.count} premio${group.count === 1 ? '' : 's'} ${group.label}`}
										>
											{Array.from({ length: group.count }).map(() => (
												<span class={`movie-detail__award-icon movie-detail__award-icon--${group.awardType}`}>
													{group.icon}
												</span>
											))}
										</div>
										<p class="movie-detail__awards-group-count">
											{group.count} premio{group.count === 1 ? '' : 's'}
										</p>
									</div>
								))}
							</div>
							<ul class="movie-detail__awards-list">
								{awardCategories.map((award) => (
									<li class={award.isBestPicture ? 'movie-detail__award-item--top' : undefined}>
										<span class={`movie-detail__award-tag movie-detail__award-tag--${award.awardType}`}>
											{award.label}
										</span>
										<span>{award.category}</span>
										{award.recipient && (
											<span class="movie-detail__award-recipient">· {award.recipient}</span>
										)}
										{award.year && <span class="movie-detail__award-year">({award.year})</span>}
										{award.isBestPicture && (
											<span class="movie-detail__award-highlight">Premio mayor</span>
										)}
									</li>
								))}
							</ul>
						</section>
					)
				}
				<section class="movie-detail__review-card" aria-label="Reseña honesta">
					<p class="movie-detail__review-kicker">Reseña honesta</p>
					<p class="movie-detail__review">{movie.review}</p>
				</section>
				<MovieRating movieSlug={movie.slug} />
				{
					editorialSummary.related.length > 0 && (
						<section class="movie-detail__editorial-card movie-detail__editorial-card--related">
							<p class="movie-detail__editorial-copy">{relatedIntro}</p>
							<div class="movie-detail__related-list">
								{editorialSummary.related.map((recommendation) => (
									<a class="movie-detail__related-link" href={recommendation.url}>
										<span>{recommendation.title}</span>
										<span>{recommendation.year}</span>
									</a>
								))}
							</div>
						</section>
					)
				}

				{trailerEmbedUrl ? (
					<iframe
						class="trailer-frame"
						src={trailerEmbedUrl}
						title={`Trailer de ${movie.title}`}
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					/>
				) : (
					<p class="message-box">Trailer no disponible.</p>
				)}
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	const backLink = document.querySelector('[data-history-back]');
	if (backLink instanceof HTMLAnchorElement) {
		backLink.addEventListener('click', (event) => {
			let canUseHistoryBack = false;
			try {
				if (document.referrer) {
					const referrerUrl = new URL(document.referrer);
					canUseHistoryBack = referrerUrl.origin === window.location.origin;
				}
			} catch {
				canUseHistoryBack = false;
			}

			if (canUseHistoryBack && window.history.length > 1) {
				event.preventDefault();
				window.history.back();
			}
		});
	}
</script>
