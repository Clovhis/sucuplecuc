---
import type { GetStaticPaths } from 'astro';
import AwardMark from '../../components/AwardMark.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAwardDisplayLabel, getAwardVisualKey } from '../../lib/awards';
import {
	getPersonEditorialStatus,
	getPersonFilmography,
	getPersonProfileBySlug,
	getPersonProfiles,
	isPersonProfileIndexable,
} from '../../lib/people';
import { PEOPLE_PATH, createPersonStructuredData } from '../../lib/seo';

export const getStaticPaths: GetStaticPaths = () => {
	return getPersonProfiles().map((profile) => ({
		params: { slug: profile.slug },
		props: { profile },
	}));
};

const { profile } = Astro.props as {
	profile: NonNullable<ReturnType<typeof getPersonProfileBySlug>>;
};
const filmography = getPersonFilmography(profile.name);
const editorialStatus = getPersonEditorialStatus(profile);
const isIndexable = isPersonProfileIndexable(profile);
const knownForEntries = profile.knownFor
	.map((slug) => filmography.find((entry) => entry.movieSlug === slug))
	.filter((entry): entry is (typeof filmography)[number] => Boolean(entry));
const showcaseEntries = (knownForEntries.length > 0 ? knownForEntries : filmography).slice(0, 4);
const pageTitle = isIndexable
	? `Biografía de ${profile.name}: películas y premios | Cine Posta`
	: `Ficha de ${profile.name}: películas y premios | Cine Posta`;
const pageDescription = isIndexable
	? `${profile.name}: biografía editorial, datos verificables, premios y películas relacionadas dentro de Cine Posta.`
	: `${profile.name}: datos verificables, premios y películas relacionadas dentro de Cine Posta.`;
const profileImage =
	profile.profileImage ?? profile.image ?? profile.remoteImageUrl ?? '/posters/poster-no-disponible.svg';
const structuredData = createPersonStructuredData(profile, filmography, pageTitle, pageDescription);
const age = getAge(profile.birthDate, profile.birthYear, profile.deathDate, profile.deathYear);
const deathDateLabel = formatPersonDate(profile.deathDate) ?? profile.deathYear;
const lifeFactLabel = deathDateLabel ? 'Fallecimiento' : 'Edad';
const lifeFactValue = deathDateLabel
	? `${deathDateLabel}${age ? ` · ${age} años` : ''}`
	: age
		? `${age} años`
		: 'No confirmada';
const filmCountLabel = `${filmography.length} peli${filmography.length === 1 ? '' : 's'} fichada${filmography.length === 1 ? '' : 's'} en Cine Posta`;
const biographyParagraphs = profile.editorialBiography ?? [];
const visibleSources = Array.from(new Set(profile.referenceUrls ?? []));

function getAge(birthDate?: string, birthYear?: number, deathDate?: string, deathYear?: number): number | undefined {
	const currentDate = new Date();
	if (!birthDate && !birthYear) {
		return undefined;
	}

	const year = birthDate ? Number.parseInt(birthDate.slice(0, 4), 10) : birthYear;
	const month = birthDate ? Number.parseInt(birthDate.slice(5, 7), 10) : 1;
	const day = birthDate ? Number.parseInt(birthDate.slice(8, 10), 10) : 1;
	const endYear = deathDate ? Number.parseInt(deathDate.slice(0, 4), 10) : (deathYear ?? currentDate.getUTCFullYear());
	const endMonth = deathDate ? Number.parseInt(deathDate.slice(5, 7), 10) : (deathYear ? 1 : currentDate.getUTCMonth() + 1);
	const endDay = deathDate ? Number.parseInt(deathDate.slice(8, 10), 10) : (deathYear ? 1 : currentDate.getUTCDate());

	if (!year || !endYear) {
		return undefined;
	}

	let ageValue = endYear - year;
	if (
		endMonth < month ||
		(endMonth === month && endDay < day)
	) {
		ageValue -= 1;
	}

	return ageValue > 0 ? ageValue : undefined;
}

function formatPersonDate(value?: string): string | undefined {
	if (!value) {
		return undefined;
	}

	const date = new Date(`${value}T00:00:00Z`);
	if (Number.isNaN(date.getTime())) {
		return undefined;
	}

	return new Intl.DateTimeFormat('es-AR', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(date);
}

function getRoleLabel(role: 'actor' | 'director' | 'producer'): string {
	if (role === 'actor') return 'Actor';
	if (role === 'director') return 'Dirección';
	return 'Producción';
}

function getSourceLabel(url: string): string {
	try {
		return new URL(url).hostname.replace(/^www\./, '');
	} catch {
		return 'Fuente externa';
	}
}
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	image={profileImage}
	openGraphType="article"
	structuredData={structuredData}
	noindex={!isIndexable}
>
	<main id="main-content" class="container person-page" data-person-editorial-status={editorialStatus}>
		<div class="page-actions">
			<a class="page-action page-action--history" href={import.meta.env.BASE_URL} data-history-back>
				Volver
			</a>
			<a class="page-action page-action--home" href={PEOPLE_PATH}>Ver todas las fichas</a>
		</div>

		<section class="person-page__hero fade-up" style="--item-delay: 0ms;">
			<aside class="person-page__portrait-card">
				<div class="person-page__portrait-shell">
					<img src={profileImage} alt={`Retrato de ${profile.name}`} loading="eager" referrerpolicy="no-referrer" />
				</div>
				<div class="person-page__portrait-copy">
					<p class="person-page__eyebrow">Ficha posta</p>
					<h1 class="person-page__title">{profile.name}</h1>
					<p class="person-page__roles">{profile.roles.join(' · ')}</p>
				</div>
			</aside>

			<div class="person-page__hero-main">
				<p class="person-page__eyebrow">Para ubicarlo rápido</p>
				<p class="person-page__headline">{profile.headline}</p>

				<div class="person-page__facts" aria-label="Datos principales">
					<div class="person-page__fact">
						<span class="person-page__fact-label">Nacimiento</span>
						<strong>{formatPersonDate(profile.birthDate) ?? profile.birthYear ?? 'No cargado'}</strong>
					</div>
					<div class="person-page__fact">
						<span class="person-page__fact-label">{lifeFactLabel}</span>
						<strong>{lifeFactValue}</strong>
					</div>
					<div class="person-page__fact">
						<span class="person-page__fact-label">Origen</span>
						<strong>{profile.birthPlace ?? profile.nationalityPrimary ?? 'No cargado'}</strong>
					</div>
					<div class="person-page__fact">
						<span class="person-page__fact-label">Catálogo</span>
						<strong>{filmCountLabel}</strong>
					</div>
				</div>
			</div>

			<aside class="person-page__showcase" aria-label="Títulos destacados">
				<p class="person-page__showcase-title">Lo tenés de</p>
				<div class="person-page__showcase-grid">
					{showcaseEntries.map((entry) => (
						<a class="person-page__showcase-card" href={entry.url}>
							<img src={entry.poster} alt={`Poster de ${entry.title}`} loading="lazy" referrerpolicy="no-referrer" />
							<span>{entry.title}</span>
						</a>
					))}
				</div>
			</aside>
		</section>

		<section class="person-page__content">
			<article class="person-page__panel fade-up" style="--item-delay: 80ms;">
				<div class="person-page__section-head">
					<h2>{isIndexable ? `Biografía de ${profile.name}` : 'Biografía de ' + profile.name}</h2>
				</div>
				{biographyParagraphs.length > 0 && (
					<div class="person-page__bio-copy">
						{biographyParagraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				)}
			</article>

			<aside class="person-page__panel person-page__panel--awards fade-up" style="--item-delay: 120ms;">
				<div class="person-page__section-head">
					<p class="person-page__eyebrow">Galardones</p>
					<h2>Premios que más pesan</h2>
				</div>
				<ul class="person-page__award-list">
					{profile.awards.map((award) => (
						<li class="person-page__award-item" data-award={getAwardVisualKey(award.label, award.category)}>
							<span class="person-page__award-mark-shell" aria-hidden="true">
								<AwardMark award={award.label} category={award.category} class="person-page__award-mark" size={128} />
							</span>
							<div class="person-page__award-copy">
								<div class="person-page__award-head">
									<p class="person-page__award-label">{getAwardDisplayLabel(award.label, award.category)}</p>
								</div>
								<p class="person-page__award-category">{award.category}</p>
								{award.work && <p class="person-page__award-work">{award.work}</p>}
							</div>
							{award.year && <span class="person-page__award-year">{award.year}</span>}
						</li>
					))}
				</ul>
			</aside>

			<section class="person-page__panel person-page__panel--filmography fade-up" style="--item-delay: 160ms;">
				<div class="person-page__section-head">
					<p class="person-page__eyebrow">Filmografía</p>
					<h2>Películas donde aparece en Cine Posta</h2>
				</div>
				<div class="person-page__filmography-grid">
					{filmography.map((entry) => (
						<a class="person-page__film-card" href={entry.url}>
							<div class="person-page__film-poster">
								<img src={entry.poster} alt={`Poster de ${entry.title}`} loading="lazy" referrerpolicy="no-referrer" />
							</div>
							<div class="person-page__film-copy">
								<div class="person-page__film-topline">
									<h3>{entry.title}</h3>
									<span>{entry.year}</span>
								</div>
								<div class="person-page__film-tags" aria-label="Rol en la película">
									{entry.roles.map((role) => (
										<span class="person-page__film-tag">{getRoleLabel(role)}</span>
									))}
								</div>
							</div>
						</a>
					))}
				</div>
			</section>

			{
				visibleSources.length > 0 && (
					<section class="person-page__panel person-page__panel--sources fade-up" style="--item-delay: 180ms;">
						<div class="person-page__section-head">
							<p class="person-page__eyebrow">Referencias</p>
							<h2>Fuentes consultables</h2>
						</div>
						<ul class="person-page__source-list">
							{visibleSources.map((url) => (
								<li><a href={url} target="_blank" rel="noopener noreferrer">{getSourceLabel(url)}</a></li>
							))}
						</ul>
					</section>
				)
			}

		</section>
	</main>
</BaseLayout>

<script src="../../scripts/person-detail.ts"></script>
