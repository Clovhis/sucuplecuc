---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizeSearchText } from '../../lib/movies';
import { getPersonAge, getPersonAgeLabel, getPersonFilmography, getPersonProfiles } from '../../lib/people';
import { PEOPLE_PATH, createSimplePageStructuredData } from '../../lib/seo';

const peopleEntries = getPersonProfiles()
	.map((profile) => {
		const filmography = getPersonFilmography(profile.name);
		const age = getPersonAge(profile);
		const awardCount = profile.awards.length;
		const normalizedRoles = profile.roles
			.map((role) => normalizeSearchText(role).replace(/\s+/g, ' '))
			.filter(Boolean);
		const nationalityLabel = profile.nationalityPrimary?.trim() ?? 'No disponible';
		const nationalityFilter = normalizeSearchText(nationalityLabel).replace(/\s+/g, ' ');
		const searchableText = normalizeSearchText(
			[
				profile.name,
				profile.headline,
				profile.roles.join(' '),
				profile.nationalityPrimary ?? '',
				profile.birthPlace ?? '',
				filmography.map((entry) => entry.title).join(' '),
			].join(' '),
		).replace(/\s+/g, ' ');
		return {
			profile,
			age,
			ageLabel: getPersonAgeLabel(profile),
			filmography,
			filmCount: filmography.length,
			awardCount,
			normalizedRoles,
			nationalityLabel,
			nationalityFilter,
			searchableText,
			showcaseTitles: filmography
				.slice(0, 3)
				.map((entry) => entry.title)
				.join(' · '),
			image:
				profile.profileImage ??
				profile.image ??
				profile.remoteImageUrl ??
				'/posters/poster-no-disponible.svg',
		};
	})
	.sort((left, right) => left.profile.name.localeCompare(right.profile.name, 'es'));

const connectedMovieCount = new Set(
	peopleEntries.flatMap((entry) => entry.filmography.map((movie) => movie.movieSlug)),
).size;
const unknownAgeCount = peopleEntries.filter((entry) => typeof entry.age !== 'number').length;
const roleOptions = Array.from(
	new Map(
		peopleEntries.flatMap((entry) =>
			entry.profile.roles.map((role) => [normalizeSearchText(role).replace(/\s+/g, ' '), role] as const),
		),
	).entries(),
)
	.map(([value, label]) => ({ value, label }))
	.sort((left, right) => left.label.localeCompare(right.label, 'es'));
const nationalityOptions = Array.from(
	new Map(
		peopleEntries
			.filter((entry) => entry.nationalityLabel !== 'No disponible')
			.map((entry) => [entry.nationalityFilter, entry.nationalityLabel] as const),
	).entries(),
)
	.map(([value, label]) => ({ value, label }))
	.sort((left, right) => left.label.localeCompare(right.label, 'es'));
const sortOptions = [
	{ value: 'alpha-asc', label: 'Nombre · A a Z' },
	{ value: 'alpha-desc', label: 'Nombre · Z a A' },
	{ value: 'catalog-desc', label: 'Más películas primero' },
	{ value: 'catalog-asc', label: 'Menos películas primero' },
	{ value: 'awards-desc', label: 'Más premios primero' },
	{ value: 'awards-asc', label: 'Menos premios primero' },
	{ value: 'age-desc', label: 'Mayor edad primero' },
	{ value: 'age-asc', label: 'Menor edad primero' },
] as const;
const ageOptions = [
	{ value: '', label: 'Todas' },
	{ value: 'under-40', label: 'Menos de 40' },
	{ value: '40-54', label: '40 a 54' },
	{ value: '55-69', label: '55 a 69' },
	{ value: '70-plus', label: '70 o más' },
] as const;
const catalogOptions = [
	{ value: '', label: 'Todos' },
	{ value: '1-2', label: '1 a 2 pelis' },
	{ value: '3-5', label: '3 a 5 pelis' },
	{ value: '6-9', label: '6 a 9 pelis' },
	{ value: '10-plus', label: '10 o más' },
] as const;
const awardsOptions = [
	{ value: '', label: 'Todos' },
	{ value: 'with-awards', label: 'Con premios' },
	{ value: '1', label: '1 premio' },
	{ value: '2-3', label: '2 a 3 premios' },
	{ value: '4-plus', label: '4 o más' },
] as const;
const pageTitle = 'Personas de Cine Posta: actores, directores y perfiles';
const pageDescription = `Explorá ${peopleEntries.length} perfiles de actores, directores y figuras del catálogo de Cine Posta, conectados con ${connectedMovieCount} películas fichadas.`;
const structuredData = createSimplePageStructuredData(PEOPLE_PATH, pageTitle, pageDescription);
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<main id="main-content" class="container people-index">
		<div class="page-actions">
			<a class="page-action page-action--home" href={import.meta.env.BASE_URL}>Ir al listado</a>
		</div>

		<section class="people-index__hero fade-up" style="--item-delay: 0ms;">
			<div class="people-index__hero-copy">
				<p class="people-index__eyebrow">Archivo de Cine Posta · Personas</p>
				<h1 class="people-index__title">Encontrá quién está detrás de cada película</h1>
				<p class="people-index__dek">
					Actores, actrices, directores y nombres clave, ordenados como un gran fichero de cine.
					Buscá a alguien o abrí los filtros si querés afinar la pesquisa.
				</p>
				<div class="people-index__stats" aria-label="Resumen del archivo">
					<span><strong>{peopleEntries.length}</strong> perfiles</span>
					<span><strong>{connectedMovieCount}</strong> películas conectadas</span>
					<span><strong>{peopleEntries.filter((entry) => entry.filmCount > 0).length}</strong> filmografías</span>
				</div>
			</div>
			<figure class="people-index__hero-art" aria-hidden="true">
				<img
					src="/images/people/cineposta-personajes-archivo-90s.webp"
					alt=""
					width="1536"
					height="1024"
					fetchpriority="high"
				/>
			</figure>
		</section>

		<section class="people-index__toolbar fade-up" style="--item-delay: 40ms;" aria-labelledby="people-explorer-title">
			<div class="people-index__toolbar-head">
				<div class="people-index__toolbar-copy">
					<p class="people-index__eyebrow">Buscador del archivo</p>
					<h2 class="people-index__toolbar-title" id="people-explorer-title">
						¿A quién estás buscando?
					</h2>
				</div>
			</div>
			<form class="people-index__filters" data-people-controls>
				<div class="people-index__primary-controls">
					<div class="people-index__field people-index__field--search">
						<label class="people-index__field-label" for="people-search">Nombre, película, rol o país</label>
						<div class="people-index__search-shell">
							<span aria-hidden="true">⌕</span>
							<input
								class="people-index__search-input"
								id="people-search"
								name="q"
								type="search"
								placeholder="Ej: Meryl Streep, director argentino..."
								autocomplete="off"
								spellcheck="false"
								data-people-filter="query"
							/>
						</div>
					</div>
					<div class="people-index__field people-index__field--sort">
						<label class="people-index__field-label" for="people-sort">Ordenar resultados</label>
						<select class="people-index__select" id="people-sort" name="orden" data-people-filter="sort">
							{sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
						</select>
					</div>
				</div>

				<div class="people-index__filter-actions">
					<button
						class="people-index__filter-toggle"
						type="button"
						aria-expanded="false"
						aria-controls="people-extra-filters"
						data-people-filter-toggle
					>
						<span aria-hidden="true">☷</span>
						<span data-people-filter-toggle-label>Más filtros</span>
						<span class="people-index__filter-count" data-people-filter-count hidden>0</span>
					</button>
					<p class="people-index__sort-note" data-people-status aria-live="polite" aria-atomic="true">
						Mostrando {peopleEntries.length} de {peopleEntries.length} perfiles.
					</p>
				</div>

				<div class="people-index__extra-filters" id="people-extra-filters" data-people-filter-panel hidden>
					<div class="people-index__filter-grid">
					<div class="people-index__field">
						<label class="people-index__field-label" for="people-role">Rol</label>
						<select class="people-index__select" id="people-role" name="rol" data-people-filter="role">
							<option value="">Todos los roles</option>
							{
								roleOptions.map((option) => (
									<option value={option.value}>{option.label}</option>
								))
							}
						</select>
					</div>

					<div class="people-index__field">
						<label class="people-index__field-label" for="people-nationality">Nacionalidad</label>
						<select
							class="people-index__select"
							id="people-nationality"
							name="nacionalidad"
							data-people-filter="nationality"
						>
							<option value="">Todas las nacionalidades</option>
							{
								nationalityOptions.map((option) => (
									<option value={option.value}>{option.label}</option>
								))
							}
						</select>
					</div>
						<div class="people-index__field">
							<label class="people-index__field-label" for="people-age">Edad</label>
							<select class="people-index__select" id="people-age" name="edad" data-people-filter="age">
								{ageOptions.map((option) => <option value={option.value}>{option.label}</option>)}
							</select>
							<p class="people-index__field-hint">{unknownAgeCount} fichas no informan edad.</p>
						</div>
						<div class="people-index__field">
							<label class="people-index__field-label" for="people-catalog">Presencia en el catálogo</label>
							<select class="people-index__select" id="people-catalog" name="catalogo" data-people-filter="catalog">
								{catalogOptions.map((option) => <option value={option.value}>{option.label}</option>)}
							</select>
						</div>
						<div class="people-index__field">
							<label class="people-index__field-label" for="people-awards">Premios destacados</label>
							<select class="people-index__select" id="people-awards" name="premios" data-people-filter="awards">
								{awardsOptions.map((option) => <option value={option.value}>{option.label}</option>)}
							</select>
						</div>
					</div>
				</div>

				<div class="people-index__active-filters" data-people-active-filters hidden>
					<p class="people-index__active-label">Filtros activos</p>
					<div class="people-index__active-list" data-people-active-filter-list></div>
				</div>

				<div class="people-index__actions" data-people-reset-shell hidden>
					<button class="people-index__reset-button" type="reset" data-people-reset>
						Limpiar búsqueda y filtros
					</button>
				</div>
			</form>
		</section>

		<section class="people-index__list-shell" aria-labelledby="people-results-title">
			<div class="people-index__results-head">
				<div>
					<p class="people-index__eyebrow">Fichas encontradas</p>
					<h2 id="people-results-title">Personas del archivo</h2>
				</div>
				<p>Seleccioná una ficha para ver su historia y filmografía.</p>
			</div>
			<p class="people-index__empty" data-people-empty hidden>
				No encontramos perfiles con esa combinación. Probá limpiar algún filtro o buscar otro término.
			</p>
			<ol class="people-index__ladder">
				{
					peopleEntries.map((entry, index) => (
						<li
							class="people-index__row fade-up"
							data-person-row
							data-name={entry.profile.name}
							data-search={entry.searchableText}
							data-roles={entry.normalizedRoles.join('|')}
							data-nationality={entry.nationalityFilter}
							data-age={typeof entry.age === 'number' ? entry.age : ''}
							data-age-known={typeof entry.age === 'number' ? 'true' : 'false'}
							data-film-count={entry.filmCount}
							data-award-count={entry.awardCount}
							style={`--item-delay: ${Math.min(index, 14) * 28}ms;`}
						>
							<a class="people-index__row-link" href={entry.profile.profilePath}>
								<span class="people-index__rank" data-people-rank aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<div class="people-index__portrait-shell">
									<img
										src={entry.image}
										alt={`Retrato de ${entry.profile.name}`}
										loading="lazy"
										referrerpolicy="no-referrer"
										width="160"
										height="188"
									/>
								</div>
								<div class="people-index__summary">
									<p class="people-index__card-kicker">{entry.profile.roles.join(' · ')}</p>
									<h2>{entry.profile.name}</h2>
									<p class="people-index__headline">{entry.profile.headline}</p>
									{
										entry.showcaseTitles && (
											<p class="people-index__showcase">Lo tenés de: {entry.showcaseTitles}</p>
										)
									}
								</div>
								<dl class="people-index__facts">
									<div class="people-index__fact">
										<dt>Edad</dt>
										<dd>{entry.ageLabel}</dd>
									</div>
									<div class="people-index__fact">
										<dt>Catálogo</dt>
										<dd>
											{entry.filmCount} peli{entry.filmCount === 1 ? '' : 's'}
										</dd>
									</div>
									<div class="people-index__fact">
										<dt>Origen</dt>
										<dd>{entry.profile.nationalityPrimary ?? 'No disponible'}</dd>
									</div>
								</dl>
								<span class="people-index__open-profile">Abrir ficha <span aria-hidden="true">→</span></span>
							</a>
						</li>
					))
				}
			</ol>
		</section>
	</main>
	<script src="../../scripts/person-index.ts"></script>
</BaseLayout>
