---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBrandLink from '../components/HomeBrandLink.astro';
import { CONTACT_EMAIL, PRIVACY_PATH, SITE_LANGUAGE, SITE_NAME, SITE_URL } from '../lib/seo';

const pageTitle = `Política de Privacidad | ${SITE_NAME}`;
const pageDescription =
	'Política de privacidad de Cine Posta: cómo tratamos los datos técnicos y la participación en la comunidad, sin publicidad personalizada.';
const privacyUrl = new URL(PRIVACY_PATH, SITE_URL).toString();
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${privacyUrl}#webpage`,
		url: privacyUrl,
		name: pageTitle,
		description: pageDescription,
		inLanguage: SITE_LANGUAGE,
		isPartOf: {
			'@type': 'WebSite',
			name: SITE_NAME,
			url: `${SITE_URL}/`,
		},
	},
];
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<main id="main-content" class="container privacy-page">
		<div class="page-actions">
			<HomeBrandLink className="page-action page-action--home" />
		</div>

		<section class="about-page__hero privacy-page__hero fade-up" style="--item-delay: 0ms;">
			<p class="about-page__kicker">Privacidad y datos</p>
			<h1 class="about-page__title">Política de Privacidad</h1>
			<p class="about-page__lead">
				En {SITE_NAME} preferimos explicar esto corto y claro: no mostramos anuncios ni usamos plataformas publicitarias.
				Esta página resume qué puede ocurrir cuando navegás, participás en la comunidad o seguís un enlace externo.
			</p>
		</section>

		<article class="about-page__card privacy-page__content fade-up" style="--item-delay: 80ms;">
			<section class="privacy-page__section">
				<h2>Datos técnicos del sitio</h2>
				<p>
					La navegación puede requerir datos técnicos básicos, como el tamaño de pantalla, el navegador o la dirección
					de la página solicitada, para entregar el sitio, detectar errores y cuidar su funcionamiento.
				</p>
				<p>
					Podemos usar almacenamiento local del navegador para recordar temporalmente preferencias de navegación, como filtros
					y estado de la interfaz. No usamos esos datos para crear perfiles publicitarios ni para vender información personal.
				</p>
			</section>

			<section class="privacy-page__section">
				<h2>Servicios y enlaces externos</h2>
				<p>
					Algunas funciones pueden enlazar con servicios de terceros, como YouTube, Cafecito u otras páginas relacionadas
					con una película. Al abrirlos, pasás a estar sujeto a las políticas de privacidad y cookies de esos servicios.
				</p>
				<p>
					Cualquier aporte o transacción iniciada en una plataforma externa se procesa allí y queda sujeta a sus propios
					términos. Cine Posta no solicita datos de tarjetas dentro del sitio.
				</p>
			</section>

			<section class="privacy-page__section">
				<h2>Comentarios de la comunidad</h2>
				<p>
					Si participás en Foro Cineposta, los mensajes se almacenan temporalmente en la infraestructura de datos que usa
					Cine Posta para sus funciones públicas. La participación no crea perfiles visibles, aunque el navegador puede
					recibir una identidad técnica anónima para aplicar límites de publicación.
				</p>
			</section>

			<section class="privacy-page__section">
				<h2>Tus opciones</h2>
				<p>
					Podés bloquear o borrar el almacenamiento local y las cookies desde la configuración de tu navegador. Algunas
					preferencias de la interfaz podrían dejar de conservarse, pero la navegación básica seguirá disponible.
				</p>
			</section>

			<section class="privacy-page__section">
				<h2>Contacto</h2>
				<p>
					Si tenés una consulta sobre privacidad, comunidad o enlaces externos en {SITE_NAME}, podés escribir a
					<a href={`mailto:${CONTACT_EMAIL}?subject=Cine%20Posta%20-%20Privacidad`}>{CONTACT_EMAIL}</a>.
				</p>
			</section>
		</article>
	</main>
</BaseLayout>
