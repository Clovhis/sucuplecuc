---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	createPostometroCatalogEntries,
	DEFAULT_POSTOMETRO_ANSWERS,
	getPostometroPlatformOptions,
	getPostometroResultSet,
	POSTOMETRO_COMPANY_OPTIONS,
	POSTOMETRO_ERA_OPTIONS,
	POSTOMETRO_INTENSITY_OPTIONS,
	POSTOMETRO_MOOD_OPTIONS,
	POSTOMETRO_TIME_OPTIONS,
} from '../lib/postometro';
import { getMovies } from '../lib/movies';
import { QUE_MIRO_HOY_PATH, SITE_LANGUAGE, SITE_NAME, SITE_URL } from '../lib/seo';

const movies = getMovies();
const postometroCatalog = createPostometroCatalogEntries(movies);
const platformOptions = getPostometroPlatformOptions(movies);
const initialAnswers = DEFAULT_POSTOMETRO_ANSWERS;
const initialResults = getPostometroResultSet(postometroCatalog, initialAnswers, platformOptions);
const primaryResult = initialResults.results[0] ?? null;

const pageTitle = `¿Qué vemos hoy? | ${SITE_NAME}`;
const pageDescription =
	'¿Qué vemos hoy? de Cine Posta recomienda una película según tu noche: humor, tiempo, compañía, plataforma y cuánto te bancás una peli liviana, intensa, profunda o pochoclera.';
const pageUrl = new URL(QUE_MIRO_HOY_PATH, SITE_URL).toString();
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: pageTitle,
		description: pageDescription,
		inLanguage: SITE_LANGUAGE,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		'@id': `${pageUrl}#breadcrumb`,
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: SITE_NAME,
				item: `${SITE_URL}/`,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Qué vemos hoy',
				item: pageUrl,
			},
		],
	},
];

const postometroData = JSON.stringify({
	catalog: postometroCatalog,
	platformOptions,
	defaultAnswers: initialAnswers,
});
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<main id="main-content" class="container postometro-page">
		<div class="page-actions">
			<a class="page-action page-action--home" href={import.meta.env.BASE_URL}>Volver al inicio</a>
		</div>

		<section class="postometro-hero fade-up" style="--item-delay: 0ms;">
			<div class="postometro-hero__copy">
				<h1 class="postometro-hero__title">¿Qué vemos hoy?</h1>
			</div>
			<div class="postometro-hero__notes">
				<p>Humor, tiempo disponible, compañía, plataforma y cuánto te bancás una peli intensa.</p>
				<p>Todo sale del catálogo editorial del sitio.</p>
			</div>
		</section>

		<div class="postometro-shell">
			<section class="postometro-panel fade-up" style="--item-delay: 60ms;" aria-labelledby="postometro-panel-title">
				<div class="postometro-panel__intro">
					<p class="postometro-panel__eyebrow">Ajustá tu noche</p>
					<h2 id="postometro-panel-title">Decime cómo venís y te tiro una</h2>
				</div>

				<form class="postometro-form" data-postometro-form>
					<div class="postometro-form__footer">
						<label class="postometro-select-field" for="postometro-era">
							<span>¿De qué época?</span>
							<select id="postometro-era" name="era" data-postometro-field="era">
								{
									POSTOMETRO_ERA_OPTIONS.map((option) => (
										<option value={option.id} selected={option.id === initialAnswers.era}>
											{option.label}
										</option>
									))
								}
							</select>
						</label>

						<label class="postometro-select-field" for="postometro-platform">
							<span>¿Dónde la querés ver?</span>
							<select id="postometro-platform" name="platform" data-postometro-field="platform">
								{
									platformOptions.map((option) => (
										<option value={option.id} selected={option.id === initialAnswers.platform}>
											{option.label}
										</option>
									))
								}
							</select>
						</label>

						<div class="postometro-form__actions">
							<button type="button" class="page-action" data-postometro-reset>
								Resetear noche
							</button>
						</div>
					</div>

					<fieldset class="postometro-fieldset postometro-fieldset--panel">
						<legend>¿Qué buscás que te haga la peli?</legend>
						<p class="postometro-fieldset__hint">Arrancá por el efecto que querés que te deje hoy.</p>
						<div class="postometro-choice-grid postometro-choice-grid--mood">
							{
								POSTOMETRO_MOOD_OPTIONS.map((option) => (
									<label class="postometro-choice-card">
										<input
											type="radio"
											name="mood"
											value={option.id}
											checked={option.id === initialAnswers.mood}
											data-postometro-field="mood"
										/>
										<span class="postometro-choice-card__body">
											<strong>{option.label}</strong>
											<span>{option.description}</span>
										</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<fieldset class="postometro-fieldset postometro-fieldset--panel">
						<legend>¿Con quién la ves?</legend>
						<p class="postometro-fieldset__hint">Esto cambia bastante qué tan rendidora conviene que sea.</p>
						<div class="postometro-choice-grid postometro-choice-grid--company">
							{
								POSTOMETRO_COMPANY_OPTIONS.map((option) => (
									<label class="postometro-choice-card postometro-choice-card--compact">
										<input
											type="radio"
											name="company"
											value={option.id}
											checked={option.id === initialAnswers.company}
											data-postometro-field="company"
										/>
										<span class="postometro-choice-card__body">
											<strong>{option.label}</strong>
											<span>{option.description}</span>
										</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<fieldset class="postometro-fieldset postometro-fieldset--panel">
						<legend>¿Cuánto tiempo tenés?</legend>
						<p class="postometro-fieldset__hint">Elegí el margen real que tenés, no el ideal.</p>
						<div class="postometro-chip-grid">
							{
								POSTOMETRO_TIME_OPTIONS.map((option) => (
									<label class="postometro-chip-option">
										<input
											type="radio"
											name="time"
											value={option.id}
											checked={option.id === initialAnswers.time}
											data-postometro-field="time"
										/>
										<span>{option.label}</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<fieldset class="postometro-fieldset postometro-fieldset--panel">
						<legend>¿Qué tan cargada la bancás?</legend>
						<p class="postometro-fieldset__hint">Acá marcás si querés algo llevadero o una peli más pesada.</p>
						<div class="postometro-chip-grid">
							{
								POSTOMETRO_INTENSITY_OPTIONS.map((option) => (
									<label class="postometro-chip-option">
										<input
											type="radio"
											name="intensity"
											value={option.id}
											checked={option.id === initialAnswers.intensity}
											data-postometro-field="intensity"
										/>
										<span>{option.label}</span>
									</label>
								))
							}
						</div>
					</fieldset>
				</form>
			</section>

			<aside
				class="postometro-results fade-up"
				style="--item-delay: 120ms;"
				data-postometro-results
				aria-live="polite"
				aria-atomic="true"
			>
				<div class="postometro-results__header">
					<p class="postometro-results__eyebrow">Diagnóstico de hoy</p>
					<h2 data-postometro-headline>{initialResults.headline}</h2>
					<p class="postometro-results__diagnosis" data-postometro-diagnosis>{initialResults.diagnosis}</p>
					<p class="postometro-results__subheadline" data-postometro-subheadline>{initialResults.subheadline}</p>
				</div>

				<div class="postometro-results__body" data-postometro-results-body>
					{
						primaryResult ? (
							<>
								<article class="postometro-pick postometro-pick--primary" data-postometro-primary>
									<div class="postometro-pick__poster-shell">
										<img
											class="postometro-pick__poster"
											src={primaryResult.posterUrl}
											alt={`Poster de ${primaryResult.title}`}
											loading="eager"
											decoding="async"
											referrerpolicy="no-referrer"
										/>
									</div>
									<div class="postometro-pick__body">
										<div class="postometro-pick__meta-top">
											<span class="postometro-pill">{primaryResult.matchLabel}</span>
											<span class="postometro-pill postometro-pill--muted">{primaryResult.year}</span>
										</div>
										<h3>{primaryResult.title}</h3>
										<p class="postometro-pick__review">{primaryResult.review}</p>
										<ul class="postometro-badge-list">
											{primaryResult.badges.map((badge) => <li>{badge}</li>)}
										</ul>
										<ul class="postometro-reason-list">
											{primaryResult.reasons.map((reason) => <li>{reason}</li>)}
										</ul>
										<div class="postometro-pick__actions">
											<a class="postometro-cta" href={primaryResult.url}>
												Ver ficha completa
											</a>
											<button
												type="button"
												class="postometro-cta postometro-cta--quiet"
												data-postometro-dismiss
												data-postometro-slug={primaryResult.slug}
											>
												Ya la vi
											</button>
											<button type="button" class="postometro-cta postometro-cta--ghost" data-postometro-reroll>
												Dame otra del mismo palo
											</button>
										</div>
									</div>
								</article>
							</>
						) : (
							<section class="postometro-empty" data-postometro-empty>
								<h3>No hay una buena opción para ese combo</h3>
								<p>{initialResults.note}</p>
							</section>
						)
					}
				</div>
			</aside>
		</div>
	</main>
</BaseLayout>

<script is:inline id="postometro-data" type="application/json" set:html={postometroData}></script>
<script src="../scripts/postometro.ts"></script>
