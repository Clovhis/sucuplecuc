---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	createPostometroCatalogEntries,
	DEFAULT_POSTOMETRO_ANSWERS,
	getPostometroPlatformOptions,
	POSTOMETRO_COMPANY_OPTIONS,
	POSTOMETRO_ERA_OPTIONS,
	POSTOMETRO_INTENSITY_OPTIONS,
	POSTOMETRO_MOOD_OPTIONS,
	POSTOMETRO_TIME_OPTIONS,
} from '../lib/postometro';
import { getMovies } from '../lib/movies';
import { QUE_MIRO_HOY_PATH, SITE_LANGUAGE, SITE_NAME, SITE_URL } from '../lib/seo';

const movies = getMovies();
const postometroCatalog = createPostometroCatalogEntries(movies);
const platformOptions = getPostometroPlatformOptions(movies);
const initialAnswers = DEFAULT_POSTOMETRO_ANSWERS;
const moodOptionIcons: Record<string, string> = {
	risas: '😂',
	tension: '⚡',
	pochoclo: '🍿',
	corazon: '💛',
	cabeza: '🧠',
	sustos: '👻',
};
const moodOptionShortDescriptions: Record<string, string> = {
	risas: 'Algo que te levante',
	tension: 'Nervio y suspenso',
	pochoclo: 'Show, ritmo y diversión',
	corazon: 'Cálida o sensible',
	cabeza: 'Para darle vueltas',
	sustos: 'Terror y sobresaltos',
};
const companyOptionIcons: Record<string, string> = {
	solo: '🎧',
	pareja: '🥂',
	amigos: '🎲',
	familia: '🛋️',
};
const companyOptionShortDescriptions: Record<string, string> = {
	solo: 'Una para vos',
	pareja: 'Para compartir',
	amigos: 'Que rinda en grupo',
	familia: 'Apta para el living',
};
const timeOptionIcons: Record<string, string> = {
	flash: '⏱️',
	normal: '🕘',
	larga: '📼',
	'sin-reloj': '∞',
};
const intensityOptionIcons: Record<string, string> = {
	liviana: '🫧',
	equilibrada: '🎯',
	intensa: '🔥',
	densa: '🪨',
};

const pageTitle = `¿Qué vemos hoy? | ${SITE_NAME}`;
const pageDescription =
	'¿Qué vemos hoy? de Cine Posta te recomienda una película según cómo venga la noche: ánimo, tiempo, compañía, plataforma y cuánto peso querés bancarte.';
const pageUrl = new URL(QUE_MIRO_HOY_PATH, SITE_URL).toString();
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: pageTitle,
		description: pageDescription,
		inLanguage: SITE_LANGUAGE,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		'@id': `${pageUrl}#breadcrumb`,
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: SITE_NAME,
				item: `${SITE_URL}/`,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Qué vemos hoy',
				item: pageUrl,
			},
		],
	},
];

function serializeJsonForScript(value: unknown): string {
	return JSON.stringify(value).replace(/[<>&\u2028\u2029]/g, (character) => {
		const codePoint = character.codePointAt(0)?.toString(16).padStart(4, '0') ?? '';
		return `\\u${codePoint}`;
	});
}

const postometroData = serializeJsonForScript({
	catalog: postometroCatalog,
	platformOptions,
	defaultAnswers: initialAnswers,
});
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<main id="main-content" class="container postometro-page">
		<div class="page-actions">
			<a class="page-action page-action--home" href={import.meta.env.BASE_URL}>Volver al inicio</a>
		</div>

		<section class="postometro-hero fade-up" style="--item-delay: 0ms;">
			<div class="postometro-hero__copy">
				<p class="postometro-hero__eyebrow">Videoclub de Cine Posta · El postómetro</p>
				<h1 class="postometro-hero__title">¿Qué vemos hoy?</h1>
				<p class="postometro-hero__subtitle">Decinos qué pinta y revolvemos el videoclub hasta encontrar una película que le quede bien a tu noche.</p>
				<div class="postometro-hero__stats" aria-label="Cómo funciona el postómetro">
					<span><strong>1.</strong> Elegí el mood</span>
					<span><strong>2.</strong> Ajustá el plan</span>
					<span><strong>3.</strong> Dale play</span>
				</div>
			</div>
			<figure class="postometro-hero__art" aria-hidden="true">
				<img
					src="/images/postometro/cineposta-personajes-noche.webp"
					alt=""
					width="1536"
					height="1024"
					fetchpriority="high"
				/>
			</figure>
		</section>

		<div class="postometro-shell">
			<section class="postometro-panel fade-up" style="--item-delay: 60ms;" aria-labelledby="postometro-panel-title">
				<div class="postometro-panel__intro">
					<p class="postometro-panel__eyebrow">Armemos la noche</p>
					<h2 id="postometro-panel-title">Decime qué pinta y te tiro una</h2>
				</div>

				<form class="postometro-form" data-postometro-form>
					<div class="postometro-form__section-heading">
						<span aria-hidden="true">1</span>
						<div>
							<p>Primero, lo importante</p>
							<h3>¿Qué tenés ganas de sentir?</h3>
						</div>
					</div>

					<fieldset class="postometro-fieldset postometro-fieldset--panel">
						<legend><span class="postometro-label-icon" aria-hidden="true">🎭</span> ¿Qué buscás que te haga la peli?</legend>
						<p class="postometro-fieldset__hint">Arrancá por la sensación que querés que te deje hoy.</p>
						<div class="postometro-choice-grid postometro-choice-grid--mood">
							{
								POSTOMETRO_MOOD_OPTIONS.map((option) => (
									<label class="postometro-choice-card">
										<input
											type="radio"
											name="mood"
											value={option.id}
											checked={option.id === initialAnswers.mood}
											data-postometro-field="mood"
										/>
										<span class="postometro-choice-card__body">
											<span class="postometro-choice-card__icon" aria-hidden="true">{moodOptionIcons[option.id]}</span>
											<strong>{option.label}</strong>
											<span class="postometro-choice-card__description">{moodOptionShortDescriptions[option.id]}</span>
										</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<div class="postometro-form__section-heading">
						<span aria-hidden="true">2</span>
						<div>
							<p>Después, el contexto</p>
							<h3>Ajustá la noche</h3>
						</div>
					</div>

					<div class="postometro-form__secondary-grid">
						<fieldset class="postometro-fieldset postometro-fieldset--panel postometro-fieldset--company">
							<legend><span class="postometro-label-icon" aria-hidden="true">👥</span> ¿Con quién la ves?</legend>
							<p class="postometro-fieldset__hint">Esto cambia bastante qué tan bien tiene que entrar la peli.</p>
							<div class="postometro-choice-grid postometro-choice-grid--company">
								{
									POSTOMETRO_COMPANY_OPTIONS.map((option) => (
										<label class="postometro-choice-card postometro-choice-card--compact">
											<input
												type="radio"
												name="company"
												value={option.id}
												checked={option.id === initialAnswers.company}
												data-postometro-field="company"
											/>
											<span class="postometro-choice-card__body">
												<span class="postometro-choice-card__icon" aria-hidden="true">{companyOptionIcons[option.id]}</span>
												<strong>{option.label}</strong>
												<span class="postometro-choice-card__description">{companyOptionShortDescriptions[option.id]}</span>
											</span>
										</label>
									))
								}
							</div>
						</fieldset>

						<fieldset class="postometro-fieldset postometro-fieldset--panel">
						<legend><span class="postometro-label-icon" aria-hidden="true">⏳</span> ¿Cuánto tiempo tenés?</legend>
						<p class="postometro-fieldset__hint">Marcá el tiempo real que tenés, no el que te gustaría tener.</p>
						<div class="postometro-chip-grid">
							{
								POSTOMETRO_TIME_OPTIONS.map((option) => (
									<label class="postometro-chip-option">
										<input
											type="radio"
											name="time"
											value={option.id}
											checked={option.id === initialAnswers.time}
											data-postometro-field="time"
										/>
										<span><span class="postometro-chip-option__icon" aria-hidden="true">{timeOptionIcons[option.id]}</span>{option.label}</span>
									</label>
								))
							}
						</div>
						</fieldset>

						<fieldset class="postometro-fieldset postometro-fieldset--panel">
						<legend><span class="postometro-label-icon" aria-hidden="true">🌡️</span> ¿Qué tan cargada la bancás?</legend>
						<p class="postometro-fieldset__hint">Acá definís si querés algo llevadero o una peli con más peso.</p>
						<div class="postometro-chip-grid">
							{
								POSTOMETRO_INTENSITY_OPTIONS.map((option) => (
									<label class="postometro-chip-option">
										<input
											type="radio"
											name="intensity"
											value={option.id}
											checked={option.id === initialAnswers.intensity}
											data-postometro-field="intensity"
										/>
										<span><span class="postometro-chip-option__icon" aria-hidden="true">{intensityOptionIcons[option.id]}</span>{option.label}</span>
									</label>
								))
							}
						</div>
						</fieldset>
					</div>

					<div class="postometro-form__refinements" aria-labelledby="postometro-refinements-title">
						<div class="postometro-form__refinements-copy">
							<h3 id="postometro-refinements-title">Afiná la búsqueda</h3>
							<p>Estos dos ajustes son opcionales: podés dejar “cualquiera” y seguir.</p>
						</div>
						<div class="postometro-form__footer">
							<label class="postometro-select-field" for="postometro-era">
								<span>¿De qué época?</span>
								<select id="postometro-era" name="era" data-postometro-field="era">
									{
										POSTOMETRO_ERA_OPTIONS.map((option) => (
											<option value={option.id} selected={option.id === initialAnswers.era}>
												{option.label}
											</option>
										))
									}
								</select>
							</label>

							<label class="postometro-select-field" for="postometro-platform">
								<span>¿Dónde la querés ver?</span>
								<select id="postometro-platform" name="platform" data-postometro-field="platform">
									{
										platformOptions.map((option) => (
											<option value={option.id} selected={option.id === initialAnswers.platform}>
												{option.label}
											</option>
										))
									}
								</select>
							</label>
						</div>
					</div>

					<div class="postometro-form__actions">
						<button type="submit" class="postometro-search-cta" data-postometro-search>
							<strong>Recomendame una película</strong>
						</button>
						<button type="button" class="page-action" data-postometro-reset>
							<span aria-hidden="true">↺</span>
							Arrancar de nuevo
						</button>
					</div>
				</form>
			</section>

			<aside
				class="postometro-results fade-up"
				style="--item-delay: 120ms;"
				data-postometro-results
				aria-live="polite"
				aria-atomic="false"
			>
				<div class="postometro-results__header">
					<p class="postometro-results__eyebrow">Tu recomendación</p>
					<h2 data-postometro-headline>Acá va a aparecer tu película</h2>
					<p class="postometro-results__diagnosis" data-postometro-diagnosis>
						Completá las opciones y te mostramos la que mejor calza con esta noche.
					</p>
					<p class="postometro-results__subheadline" data-postometro-subheadline>
						Podés cambiar cualquier ajuste y volver a buscar.
					</p>
				</div>

				<div class="postometro-results__body" data-postometro-results-body>
					<section class="postometro-empty postometro-empty--idle" data-postometro-empty>
						<div class="postometro-empty__copy">
							<span class="postometro-empty__number" aria-hidden="true">3</span>
							<h3>La elegida está en algún estante</h3>
							<p>Cuando termines de ajustar la noche, tocá <strong>Recomendame una película</strong> y la buscamos.</p>
						</div>
						<figure class="postometro-empty__art" aria-hidden="true">
							<img
								src="/images/postometro/cineposta-personajes-recomendacion.webp"
								alt=""
								width="1200"
								height="900"
								loading="eager"
								decoding="async"
							/>
						</figure>
					</section>
				</div>
			</aside>
		</div>
	</main>
</BaseLayout>

<script is:inline id="postometro-data" type="application/json" set:html={postometroData}></script>
<script src="../scripts/postometro.ts"></script>
