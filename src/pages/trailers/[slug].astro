---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformBadgeGroup from '../../components/PlatformBadgeGroup.astro';
import {
	getMoviePath,
	getMoviePlatformLabel,
	getMoviePlatforms,
	getMovies,
	getPosterUrl,
	getYoutubeEmbedUrl,
	getYoutubeThumbnailUrl,
	getYoutubeWatchUrl,
} from '../../lib/movies';
import { createTrailerPageStructuredData } from '../../lib/seo';
import type { Movie } from '../../types/movie';

export function getStaticPaths() {
	return getMovies()
		.filter((movie) => String(movie.trailerYoutubeId ?? '').trim().length > 0)
		.map((movie) => ({
			params: { slug: movie.slug },
			props: { movie },
		}));
}

const { movie } = Astro.props as { movie: Movie };
const trailerEmbedUrl = getYoutubeEmbedUrl(movie.trailerYoutubeId);
const trailerWatchUrl = getYoutubeWatchUrl(movie.trailerYoutubeId);
const trailerThumbnailUrl = getYoutubeThumbnailUrl(movie.trailerYoutubeId) || getPosterUrl(movie.poster);
const movieUrl = getMoviePath(movie.slug);
const moviePlatforms = getMoviePlatforms(movie);
const moviePlatformLabel = getMoviePlatformLabel(movie);
const pageTitle = `Trailer oficial de ${movie.title} (${movie.year}) | Cine Posta`;
const pageDescription = `Mirá el trailer oficial de ${movie.title} (${movie.year}) y volvés a la reseña completa en Cine Posta.`;
const structuredData = createTrailerPageStructuredData(movie, pageTitle, pageDescription);
---

<BaseLayout title={pageTitle} description={pageDescription} image={trailerThumbnailUrl} structuredData={structuredData}>
	<main id="main-content" class="container">
		<div class="page-actions">
			<a class="page-action page-action--history" href={movieUrl}>Volver a la reseña</a>
			<a class="page-action page-action--home" href={import.meta.env.BASE_URL}>Ir al listado</a>
		</div>

		<article class="trailer-watch fade-up" style="--item-delay: 0ms;">
			<header class="trailer-watch__header">
				<p class="trailer-watch__eyebrow">Trailer oficial</p>
				<h1 class="trailer-watch__title">{movie.title}</h1>
				<p class="trailer-watch__dek">{pageDescription}</p>
				<div class="trailer-watch__meta">
					<span>{movie.year}</span>
					{moviePlatforms.length > 0 && (
						<>
							<span>{moviePlatformLabel}</span>
							<PlatformBadgeGroup platforms={moviePlatforms} />
						</>
					)}
				</div>
			</header>

			<section class="trailer-shell trailer-shell--watch" aria-label={`Reproductor del trailer de ${movie.title}`}>
				<iframe
					class="trailer-frame trailer-frame--watch"
					src={trailerEmbedUrl}
					title={`Trailer oficial de ${movie.title}`}
					loading="eager"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
				<div class="trailer-watch__actions">
					<a
						class="page-action"
						href={trailerWatchUrl}
						target="_blank"
						rel="noopener noreferrer"
						referrerpolicy="no-referrer"
					>
						Abrir en YouTube
					</a>
					<a class="page-action page-action--home" href={movieUrl}>Leer la reseña</a>
				</div>
			</section>

			<section class="trailer-watch__summary" aria-label="Ficha breve de la película">
				<div class="trailer-watch__poster-card">
					<img
						class="trailer-watch__poster"
						src={getPosterUrl(movie.poster)}
						alt={`Poster de ${movie.title}`}
						loading="lazy"
						referrerpolicy="no-referrer"
					/>
				</div>
				<div class="trailer-watch__copy">
					<p class="trailer-watch__summary-kicker">Sinopsis</p>
					<p class="trailer-watch__summary-text">{movie.synopsis}</p>
					<dl class="trailer-watch__facts">
						<div>
							<dt>Dirección</dt>
							<dd>{movie.director}</dd>
						</div>
						<div>
							<dt>Elenco</dt>
							<dd>{movie.mainCast.slice(0, 4).join(', ')}</dd>
						</div>
						<div>
							<dt>Productora</dt>
							<dd>{movie.productionCompany}</dd>
						</div>
					</dl>
				</div>
			</section>
		</article>
	</main>
</BaseLayout>
