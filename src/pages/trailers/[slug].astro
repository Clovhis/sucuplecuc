---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getMoviePath,
	getMovies,
} from '../../lib/movies';
import { SITE_URL } from '../../lib/seo';
import type { Movie } from '../../types/movie';

export function getStaticPaths() {
	return getMovies()
		.filter((movie) => String(movie.trailerYoutubeId ?? '').trim().length > 0)
		.map((movie) => ({
			params: { slug: movie.slug },
			props: { movie },
		}));
}

const { movie } = Astro.props as { movie: Movie };
const movieUrl = getMoviePath(movie.slug);
const pageTitle = `Trailer de ${movie.title} | Cine Posta`;
const pageDescription = `El trailer de ${movie.title} se reproduce dentro de su ficha en Cine Posta.`;
const movieCanonicalUrl = new URL(movieUrl, SITE_URL).toString();
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={movieCanonicalUrl}
	redirectUrl={movieUrl}
>
	<main id="main-content" class="container">
		<article class="trailer-legacy fade-up" style="--item-delay: 0ms;">
			<p class="trailer-legacy__eyebrow">Trailer integrado a la ficha</p>
			<h1>El trailer de {movie.title} ahora está en su reseña.</h1>
			<p>Para reproducirlo y ver la información de la película, seguí a la ficha principal.</p>
			<a class="page-action page-action--home" href={movieUrl}>Ir a la ficha de {movie.title}</a>
		</article>
	</main>
</BaseLayout>
